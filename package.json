{
  "name": "cv-generator",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "puppeteer": "^25.11.0",
    "sharp": "^0.35.4",
    "toml": "^5.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types scripts/check-i18n.mjs && node scripts/check-scale.mjs && node scripts/check-privacy.mjs && astro build && node scripts/check-output.mjs",
    "preview": "astro preview",
    "pdf:de": "./scripts/generate_cv.sh config.cv.toml public/pdfs/Michael_Boiman_CV_DE.pdf de",
    "pdf:en": "./scripts/generate_cv.sh config.cv.toml public/pdfs/Michael_Boiman_CV_EN.pdf en",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "check:output": "node scripts/check-output.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:scale": "node scripts/check-scale.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "test:pdf": "node --experimental-strip-types --test test/pdf.test.cjs",
    "test:graph": "node --experimental-strip-types --test test/graph.test.mjs",
    "test:match": "node --experimental-strip-types --test test/match.test.mjs",
    "measure:match": "node --experimental-strip-types scripts/jev-measure.mjs",
    "og:match": "node --experimental-strip-types scripts/match-og.mjs",
    "test:greeting": "node --experimental-strip-types --test test/greeting.test.mjs"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.3.3",
    "tailwindcss": "^4.2.1"
  }
}
