{
  "name": "cv-generator",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.8.0",
    "sharp": "^0.35.3",
    "toml": "^5.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types scripts/check-i18n.mjs && astro build && node scripts/check-output.mjs",
    "preview": "astro preview",
    "pdf:de": "./scripts/generate_cv.sh config.cv.toml public/pdfs/Michael_Boiman_CV_DE.pdf de",
    "pdf:en": "./scripts/generate_cv.sh config.cv.toml public/pdfs/Michael_Boiman_CV_EN.pdf en",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs",
    "check:output": "node scripts/check-output.mjs"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.2.4",
    "tailwindcss": "^4.2.1"
  }
}
