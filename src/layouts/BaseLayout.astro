---
interface Props {
  title: string;
  description: string;
  lang: 'de' | 'en';
}

import '../styles/global.css';
import AgentWidget from '../components/AgentWidget.astro';
/* The portrait moved out of public/ so both pages can derive their own sizes
   from it. Only the structured data still wants an absolute URL to a portrait,
   and it is read by crawlers, never fetched by a visitor, so the emitted
   original is the right thing to point at. Importing it is also what keeps the
   file in the build at all now that no page references the public path. */
import { getImage } from 'astro:assets';
import portraitSource from '../assets/portraits/profile_.jpg';

const { title, description, lang } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const currentPath = Astro.url.pathname;
const otherPath = currentPath.replace(`/${lang}/`, `/${otherLang}/`);
// x-default must point to the same (de) URL across /de/ and /en/.
const defaultPath = lang === 'de' ? currentPath : currentPath.replace('/en/', '/de/');

const siteOrigin = 'https://mboiman.github.io';
const pageUrl = `${siteOrigin}${currentPath}`;
const ogImageUrl = `${siteOrigin}/images/og-card.png`;
/* Derived, not the emitted original. Importing the source alone would ship the
   750x1000 JPEG of 362 kB into dist for the sake of one meta tag that no visitor
   ever fetches. This asks for the same picture at the same width in webp, which
   is 67 kB, and the original then has no reason to be emitted at all. */
const portraitAsset = await getImage({ src: portraitSource, width: 750, format: 'webp' });
const profileImageUrl = `${siteOrigin}${portraitAsset.src}`;
const authorName = 'Michael Boiman';
const jobTitle = lang === 'de'
  ? 'Quality Engineer & KI-Architekt'
  : 'Quality Engineer & AI Architect';
const ogLocale = lang === 'de' ? 'de_DE' : 'en_US';
const ogLocaleAlternate = lang === 'de' ? 'en_US' : 'de_DE';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: authorName,
  jobTitle,
  url: pageUrl,
  image: profileImageUrl,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Frankfurt am Main',
    addressCountry: 'DE',
  },
  sameAs: [
    'https://www.linkedin.com/in/mboiman/',
    'https://github.com/mboiman',
    'https://github.com/bks-lab',
  ],
  knowsAbout: [
    'Quality Engineering',
    'Test Automation',
    'Playwright',
    'Peppol',
    'EN 16931',
    'Azure Functions',
    'Python',
    'Model Context Protocol',
    'Agent2Agent',
    'AI Architecture',
  ],
};
---

<!DOCTYPE html>
<html lang={lang} data-theme="system">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Michael Boiman" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Michael Boiman" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:locale:alternate" content={ogLocaleAlternate} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={pageUrl} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  {/* Two metas so the browser chrome follows the OS with no script at all.
      When a visitor forces a mode, the toggle neutralises both and writes one
      unconditional meta: the spec picks the FIRST meta whose media matches, so
      an extra one appended later would never win on its own. */}
  <meta name="theme-color" content="#f8fbff" media="(prefers-color-scheme: light)" data-theme-color="light" />
  <meta name="theme-color" content="#0f172a" media="(prefers-color-scheme: dark)" data-theme-color="dark" />
  <script is:inline>
    (() => {
      try {
        /* TWO different things, kept apart on purpose:
             data-theme  = the CHOICE  (system | light | dark)
             .dark       = the RESOLVED state, which is what every stylesheet reads
           The old code stored only the resolved state under `theme`, so a single
           click wrote a value that could never be taken back: from then on the
           OS was ignored forever and there was no control that could say
           "follow the system again". Measured on the live page: click once, then
           switch the OS, and the page stays put across reloads.
           New key on purpose. A value under the old `theme` was written by a
           two-state control that had no way to express "system", so it cannot be
           read as a deliberate override. Ignoring it starts everyone on system,
           which is the honest default, and nobody loses a choice they could
           actually have made. */
        const saved = localStorage.getItem('theme-choice');
        const choice = saved === 'light' || saved === 'dark' ? saved : 'system';
        const isDark = choice === 'dark'
          || (choice === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const root = document.documentElement;
        root.dataset.theme = choice;
        root.classList.toggle('dark', isDark);
      } catch {}
    })();
  </script>
  <link rel="canonical" href={pageUrl} />
  <link rel="alternate" hreflang={lang} href={pageUrl} />
  <link rel="alternate" hreflang={otherLang} href={`${siteOrigin}${otherPath}`} />
  <link rel="alternate" hreflang="x-default" href={`${siteOrigin}${defaultPath}`} />
  <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
</head>
<body class="min-h-screen">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:rounded focus:text-sm" style="background: var(--accent-cta); color: white;">
    {lang === 'de' ? 'Zum Inhalt springen' : 'Skip to content'}
  </a>

  <slot />

  {/* Scroll reveal. Astro renders HTML comments verbatim into the output;
      only the expression form is stripped, so author notes use it. */}
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>

  {/* AI chat widget (JS-injected, print-hidden, excluded from PDF) */}
  <AgentWidget />

</body>
</html>
