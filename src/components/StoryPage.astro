      color: var(--text);
    }
    .phone-bubble.is-them {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--text-secondary);
    }
    .phone-note {
      font-size: 0.66rem;
      line-height: 1.4;
      color: var(--text-secondary);
      margin-top: 0.2rem;
    }

    .shot-figure { margin: 0; }
    .shot :global(img) { display: block; width: 100%; height: auto; }

    .probe-note {
      display: block;
      margin-top: 0.3rem;
      font-size: 0.7rem;
