---
/**
 * The presentation at /de/story/ and /en/story/.
 *
 * WHAT WENT WRONG BEFORE, so it does not get rebuilt:
 *
 * The version this replaces looped one composition over eleven acts. Its copy
 * was tighter than its predecessor's and it still read worse, because when
 * every act has the same shape, nothing can be emphasised, so nothing is. It
 * also cut the typographic range from about 9:1 to 3:1 and dropped every image
 * except one photograph. Michael's verdict was "gar nicht gut, das war
 * urspruenglich viel besser".
 *
 * The version before THAT (branch main) had the right scale and rhythm but put
 * "20+" and "40+" on a full screen and laid its screenshots behind the copy at
 * four percent opacity, which means it had images in the markup and none on
 * the screen. His verdict on that was "dieses ganze zahlen bashing brauche ich
 * nicht".
 *
 * So: the cinematic scale of main, nine distinct act shapes instead of one,
 * counters replaced by identifiers a visitor can open, and images that are
 * actually visible. `kind` drives everything; adding an act is a data change
 * in i18n.ts.
 *
 * TWO STRUCTURAL RULES SURVIVE FROM THE OLD FILE:
 *  1. Every <section> has exactly ONE direct <div> child. The step engine at
 *     the bottom derives keyboard steps from that shape; a second direct div
 *     silently splits one act into two steps.
 *  2. Full-viewport height comes from [data-act], never from aria-label. The
 *     old file listed both language variants of every label in its CSS
 *     selectors, so renaming a German label broke the English layout.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { getCVData } from '../lib/toml-loader';
import { i18n } from '../lib/i18n';

import FigProofPair from './figures/FigProofPair.astro';
import FigTimeline from './figures/FigTimeline.astro';
import FigMesh from './figures/FigMesh.astro';
import FigRoute from './figures/FigRoute.astro';
import FigGate from './figures/FigGate.astro';
import FigChecks from './figures/FigChecks.astro';

import shotNlp from '../assets/story/nlpanalyse.png';
import shotSla from '../assets/story/sla-dashboard.jpg';
import shotRoute from '../assets/story/angebotstest.png';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const t = i18n[lang];

const data = getCVData(lang);
const { profile, contact, ui, experiences, education } = data;

/** The `stations` act reads the career straight out of the CV TOML rather than
 *  restating it in i18n.ts. Two copies of the same career drift, and the CV is
 *  the source Michael actually maintains. Seven rows: enough to show the arc
 *  from enterprise QA to agent architecture, short enough to stay on one
 *  screen. The rest stays on the CV page, which is what the link is for. */
const stations = experiences.list.slice(0, 7);

const email = contact.list.find(c => c.class === 'email');
const linkedin = contact.list.find(c => c.class === 'linkedin');
const github = contact.list.find(c => c.class === 'github');
const website = contact.list.find(c => c.class === 'website');

const portrait = `/images/${profile.avatar_story || 'profile_.jpg'}`;

/** Keyed, never a raw path: a raw path can point at a file that was deleted for
 *  leaking personal data, and nothing in the build would notice. */
const SHOTS = { nlpanalyse: shotNlp, sla: shotSla, angebotstest: shotRoute };
const FIGURES = {
  proofpair: FigProofPair, timeline: FigTimeline, mesh: FigMesh,
  route: FigRoute, gate: FigGate, checks: FigChecks,
};

// Stamped at build time. A hand-typed date keeps claiming it was checked today
// long after it was not.
const buildDate = new Date().toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const acts = t.acts;
const storyTitle = `${profile.name} · ${lang === 'de' ? 'Projekt-Story' : 'Project Story'}`;
---

<BaseLayout title={storyTitle} description={ui.story_seo_description} lang={lang}>
  <div class="story-page">
  <div id="scroll-progress" style="width: 0%"></div>

  <header>
    <nav class="fixed top-0 left-0 right-0 z-50 no-print story-nav" id="floating-nav">
      <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href={`/${lang}/`} class="story-back text-xs tracking-[0.1em] uppercase opacity-70 hover:opacity-100 transition-opacity duration-300 min-h-[44px] flex items-center gap-1.5" style="color: var(--text-secondary)" aria-label={t.storyBackToCv}>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            <span>{t.storyBackToCv}</span>
          </a>
          <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} download class="text-xs tracking-[0.1em] uppercase opacity-0 hover:opacity-80 transition-all duration-500 min-h-[44px] min-w-[44px] flex items-center" style="color: var(--text-secondary)" id="nav-pdf" tabindex="-1">
            {t.pdfDownload}
          </a>
        </div>
        <div class="flex items-center gap-2 opacity-0 transition-all duration-500" id="nav-right">
          <span class="story-key-hint hidden sm:inline-flex">← →</span>
          <a href="/de/story/" class={`text-xs ${lang === 'de' ? 'font-semibold' : 'opacity-60 hover:opacity-100 transition-opacity'} min-h-[44px] min-w-[44px] flex items-center justify-center`} style={lang === 'de' ? 'color: var(--text)' : 'color: var(--text-secondary)'} tabindex="-1">DE</a>
          <span class="text-xs" style="color: var(--text-secondary); opacity: 0.4">|</span>
          <a href="/en/story/" class={`text-xs ${lang === 'en' ? 'font-semibold' : 'opacity-60 hover:opacity-100 transition-opacity'} min-h-[44px] min-w-[44px] flex items-center justify-center`} style={lang === 'en' ? 'color: var(--text)' : 'color: var(--text-secondary)'} tabindex="-1">EN</a>
          <DarkModeToggle />
        </div>
      </div>
    </nav>
  </header>

  <main id="main">
  {acts.map((act, actIndex) => {
    const Fig = act.figure ? FIGURES[act.figure.id] : null;
    // Four figure acts rendered through one layout is the exact fault this
    // rebuild exists to fix, reintroduced one level down. The figures differ in
    // proportion: `route` (900x120) and `gate` (720x260) are wide and want the
    // full act width under the copy, `timeline` and `mesh` are upright and want
    // the column beside it. Deriving the layout from the figure's own shape is
    // a rule, so a new figure lands correctly without anyone remembering this.
    // Aspect ratio of each wide figure's viewBox. The wrapper derives its width
    // from a height budget times this ratio, so a flat figure gets the full act
    // width and a chunkier one stops before it pushes the act past the fold.
    // Hardcoding one width for both put `gate` 130px over on every desktop size.
    const WIDE_AR: Record<string, number> = { route: 900 / 120, gate: 720 / 260 };
    const wideAr = act.figure ? WIDE_AR[act.figure.id] : undefined;
    const wideFigure = wideAr !== undefined;
    const shot = act.shot ? SHOTS[act.shot.src] : null;
    return (
      <section data-act={act.kind} data-tone={act.tone} id={act.id} aria-label={act.headline}>
        <div class="w-full mx-auto" style={act.kind === 'portrait' ? '' : 'max-width: 72rem'}>

          {/* ── manifest ────────────────────────────────────────────────
              Two objects on the most valuable screen of the page. The
              predecessor put a struck-through `status: active` next to
              `launchctl print` here, which is an insider joke that says
              nothing to the person deciding whether to write an email.

              `--cue` is the overture ladder; `--fig-t0` hands the figure its
              entry point. The page owns the pacing, the figure owns its own
              internal proportions, so the drawing starts while its block is
              still fading in and the two read as one movement rather than a
              fade, then a pause, then a line. */}
          {act.kind === 'manifest' && (
            <div class="text-center flex flex-col items-center">
              <p class="act-eyebrow cue" style="--cue:.2s">{act.eyebrow}</p>
              <h1 class="act-h act-h--loud cue max-w-[22ch]" style="--cue:.5s">{act.headline}</h1>
              <div class="teal-rule mt-9 cue" style="--cue:1.0s"></div>
              {Fig && act.figure && (
                <div class="mt-10 w-full max-w-[26rem] cue" style="--cue:1.2s; --fig-t0:1.5s">
                  <Fig labels={act.figure.labels} caption={act.figure.caption} />
                </div>
              )}
              <ul class="act-bullets mt-9 max-w-[34rem] text-left cue" style="--cue:1.55s">
                {act.bullets.map(b => (
                  <li class="bullet"><span class="bullet-mark" aria-hidden="true">·</span><span>{b}</span></li>
                ))}
              </ul>
              {act.hook && <p class="mt-7 text-[0.82rem] max-w-[38rem] cue" style="--cue:1.8s; color: var(--text-secondary)">{act.hook}</p>}
              {act.anchor && (
                <p class="mt-5 cue" style="--cue:1.95s">
                  <a href={act.anchor.url} target="_blank" rel="noopener" class="proof">{act.anchor.text}</a>
                  <span class="proof-label block mt-1">
                    <span class="proof-dot" data-state={act.anchor.state} aria-hidden="true"></span>{act.anchor.label}
                  </span>
                </p>
              )}
              <svg class="scroll-chevron no-print mt-10" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" style="color: var(--text-secondary)" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
              </svg>
            </div>
          )}

          {/* ── portrait ────────────────────────────────────────────────
              The one place the photograph stands as a photograph: edge to
              edge, full opacity, no blend mode, no mask. main showed the same
              file at 62 percent behind the opening headline and spent the
              reveal before it happened, which is why the opener above carries
              type only. */}
          {act.kind === 'portrait' && (
            <div class="portrait-split">
              <div class="portrait-side">
                <img src={portrait} alt={profile.name} width="750" height="1000" class="portrait-bleed" />
              </div>
              <div class="portrait-copy rise-stagger">
                <p class="act-eyebrow" style="--i:0">{act.eyebrow}</p>
                <h2 class="act-h" style="--i:1">{act.headline}</h2>
                <ul class="act-bullets">
                  {act.bullets.map((b, i) => (
                    <li class="bullet" style={`--i:${i + 2}`}><span class="bullet-mark" aria-hidden="true">·</span><span>{b}</span></li>
                  ))}
                </ul>
                {act.hook && <p class="mt-7 text-[0.86rem]" style={`--i:${act.bullets.length + 2}; color: var(--text-secondary)`}>{act.hook}</p>}
              </div>
            </div>
          )}

          {/* ── offer ───────────────────────────────────────────────────
              Added after both client-side reviews said the same thing
              independently: after ninety seconds a reader knew how Michael
              thinks and not what they could order. */}
          {act.kind === 'offer' && (
            <div>
              <p class="act-eyebrow rise">{act.eyebrow}</p>
              <h2 class="act-h rise">{act.headline}</h2>
              <div class="offer-grid rise-stagger">
                {act.bullets.map((b, i) => {
                  const cut = b.indexOf(':');
                  const head = cut > 0 ? b.slice(0, cut + 1) : b;
                  const rest = cut > 0 ? b.slice(cut + 1) : '';
                  return (
                    <div class="offer-cell" style={`--i:${i}`}>
                      <span class="offer-head">{head}</span>{rest}
                    </div>
                  );
                })}
              </div>
              {act.hook && <p class="mt-8 text-[0.92rem] rise" style="color: var(--text-secondary)">{act.hook}</p>}
              <p class="mt-5 flex flex-wrap gap-x-6 gap-y-2 rise" style="font-size: clamp(0.95rem, 1.3vw, 1.15rem)">
                {email && <a href={email.url} class="cta" style="color: var(--accent)">{email.title}</a>}
                {linkedin && <a href={linkedin.url} target="_blank" rel="noopener" class="cta">LinkedIn</a>}
                {github && <a href={github.url} target="_blank" rel="noopener" class="cta">GitHub</a>}
              </p>
            </div>
          )}

          {/* ── project ─────────────────────────────────────────────────
              The spine of the page. Five of these, and between them they are
              what makes this a portfolio instead of an essay.

              Structure comes from the version on `main`: challenge, solution,
              result as prose beside a picture. What changed is that the
              picture is a picture. main laid its screenshots behind the copy
              at four percent opacity, so the images existed in the markup and
              not on the screen.

              A wide figure (`route`) cannot live in a side column at a
              readable size, so it drops under the prose at full act width.
              The layout follows the figure's own proportions rather than a
              per-act flag someone has to remember to set. */}
          {act.kind === 'project' && (
            <div class="project">
              <p class="act-eyebrow rise">{act.eyebrow}</p>
              <h2 class="act-h rise">{act.headline}</h2>

              <div class={`project-body ${wideFigure ? 'is-stacked' : ''} ${act.shot ? 'has-shot' : ''} ${actIndex % 2 === 1 ? 'is-flipped' : ''}`}>
                <div class="project-prose rise-stagger">
                  {act.project && (
                    <>
                      <div class="pblock" style="--i:0">
                        <p class="plabel">{t.projectChallenge}</p>
                        <p>{act.project.challenge}</p>
                      </div>
                      <div class="pblock" style="--i:1">
                        <p class="plabel">{t.projectSolution}</p>
                        <p>{act.project.solution}</p>
                      </div>
                      <div class="pblock is-result" style="--i:2">
                        <p class="plabel">{t.projectResult}</p>
                        <p>{act.project.result}</p>
                      </div>
                    </>
                  )}
                  {act.rename && (
                    <p class="rename" style="--i:3">
                      <s class="rename-before">{act.rename.before}</s>
                      <span class="rename-after">{act.rename.after}</span>
                    </p>
                  )}
                  {act.anchor && (
                    <p class="mt-6" style="--i:4">
                      {act.anchor.url
                        ? <a href={act.anchor.url} target="_blank" rel="noopener" class="proof">{act.anchor.text}</a>
                        : <span class="proof">{act.anchor.text}</span>}
                      <span class="proof-label block mt-1">
                        <span class="proof-dot" data-state={act.anchor.state} aria-hidden="true"></span>
                        {act.anchor.label}{act.anchor.note ? ` · ${act.anchor.note}` : ''}
                      </span>
                    </p>
                  )}
                </div>

                <div class="project-media">
                  {!wideFigure && Fig && act.figure && (
                    <Fig labels={act.figure.labels} caption={act.figure.caption} />
                  )}

                  {shot && act.shot && (
                    <figure class="shot-figure">
                      <div class="shot">
                        <Image src={shot} alt={act.shot.alt} widths={[480, 800, 1280]} sizes="(max-width: 900px) 92vw, 40rem" />
                      </div>
                      <figcaption class="shot-cap">{act.shot.caption}</figcaption>
                    </figure>
                  )}

                  {act.phone && (
                    <div class="phone">
                      {act.phone.lines.map((l, i) => (
                        <p class={`phone-bubble ${i % 2 === 1 ? 'is-them' : ''}`}>{l}</p>
                      ))}
                      <p class="phone-note">{act.phone.note}</p>
                    </div>
                  )}

                  {act.terminal && (
                    <div>
                      <div class="term">
                        <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i><span>{act.terminal.title}</span></div>
                        <pre class="term-body"><code>{act.terminal.lines.map((l, i) => (
                          <span class={`term-line term-${l.kind}`} style={`--i:${i}`}>{l.kind === 'cmd' ? <><span class="term-p">$ </span>{l.text}</> : l.text}{'\n'}</span>
                        ))}</code></pre>
                      </div>
                      <p class="mt-3 text-[0.68rem]" style="color: var(--text-secondary)">{act.terminal.recorded}</p>
                    </div>
                  )}
                </div>

                {wideFigure && Fig && act.figure && (
                  <div class="stack-figure" style={`--fig-ar:${wideAr}`}>
                    <Fig labels={act.figure.labels} caption={act.figure.caption} />
                  </div>
                )}
              </div>
            </div>
          )}

          {/* ── howto ───────────────────────────────────────────────────
              One act on method, not twelve. The predecessor spent nine
              screens on guardrails and had room for no projects at all;
              this keeps the single strongest one and gives the space back. */}
          {act.kind === 'howto' && (
            <div class="stack-wide">
              <div class="rise-stagger">
                <p class="act-eyebrow" style="--i:0">{act.eyebrow}</p>
                <h2 class="act-h" style="--i:1">{act.headline}</h2>
                <ol class="act-bullets act-bullets--wide">
                  {act.bullets.map((b, i) => (
                    <li class="bullet" style={`--i:${i + 2}`}><span class="bullet-mark" aria-hidden="true">{i + 1}</span><span>{b}</span></li>
                  ))}
                </ol>
                {act.hook && <p class="mt-6 text-[0.88rem] max-w-[46rem]" style={`--i:${act.bullets.length + 2}; color: var(--text-secondary)`}>{act.hook}</p>}
                {act.anchor && (
                  <p class="mt-5" style={`--i:${act.bullets.length + 3}`}>
                    <a href={act.anchor.url} target="_blank" rel="noopener" class="proof">{act.anchor.text}</a>
                    <span class="proof-label block mt-1">
                      <span class="proof-dot" data-state={act.anchor.state} aria-hidden="true"></span>{act.anchor.label}
                    </span>
                  </p>
                )}
              </div>
              {Fig && act.figure && (
                <div class="stack-figure" style={`--fig-ar:${wideAr}`}>
                  <Fig labels={act.figure.labels} caption={act.figure.caption} />
                </div>
              )}
            </div>
          )}

          {/* ── beliefs ─────────────────────────────────────────────────
              Restored from `main`, where four maxims ran down the page with
              alternating alignment. Two of these four are Michael's own
              QualityCluster rules, which until now existed only inside a PNG
              that carries four grammar mistakes. Typed out, they are the
              most quotable thing on the page. */}
          {act.kind === 'beliefs' && (
            <div>
              <p class="act-eyebrow rise">{act.eyebrow}</p>
              <h2 class="act-h rise">{act.headline}</h2>
              <div class="beliefs rise-stagger">
                {act.beliefs?.map((b, i) => (
                  <blockquote class={`belief ${i % 2 === 1 ? 'is-right' : ''}`} style={`--i:${i}`}>
                    <p class="belief-rule">{b.rule}</p>
                    <p class="belief-text">{b.text}</p>
                  </blockquote>
                ))}
              </div>
            </div>
          )}

          {/* ── live ────────────────────────────────────────────────────
              The peak. The right column is the dock target for the existing
              chat widget; when the widget is not there (no script, visitor
              closed it), the card still shows live-fetched data plus the
              clickable proof, so the demonstration survives its own failure. */}
          {act.kind === 'live' && (
            <div class="split-stage">
              <div class="rise-stagger">
                <p class="act-eyebrow" style="--i:0">{act.eyebrow}</p>
                <h2 class="act-h" style="--i:1">{act.headline}</h2>
                <ul class="flex flex-col gap-4 mt-2">
                  {act.bullets.map((b, i) => (
                    <li style={`--i:${i + 2}`}>
                      <button type="button" class="probe-ask" data-prompt={b}>{b}</button>
                      {act.probeNotes?.[i] && <span class="probe-note">{act.probeNotes[i]}</span>}
                    </li>
                  ))}
                </ul>
                {act.hook && <p class="mt-7 text-[0.86rem]" style="color: var(--text-secondary)">{act.hook}</p>}
                {act.anchor && (
                  <p class="mt-5">
                    <a href={act.anchor.url} target="_blank" rel="noopener" class="proof">{act.anchor.text}</a>
                    <span class="proof-label block mt-1">
                      <span class="proof-dot" data-state={act.anchor.state} aria-hidden="true"></span>{act.anchor.label}
                    </span>
                  </p>
                )}
              </div>

              <div class="agent-dock" id="agent-dock">
                <div class="agent-card">
                  <p class="agent-live">
                    <i aria-hidden="true"></i>
                    <span id="agent-state"
                          data-checking={t.agentChecking}
                          data-live={t.agentReachable}
                          data-down={t.agentUnavailable}>{t.agentChecking}</span>
                  </p>
                  <dl class="agent-facts" id="agent-facts">
                    <div><dt>{t.agentCardName}</dt><dd data-f="name">…</dd></div>
                    <div><dt>{t.agentCardProtocol}</dt><dd data-f="proto">…</dd></div>
                    <div><dt>{t.agentCardEndpoint}</dt><dd data-f="url" class="agent-endpoint">…</dd></div>
                  </dl>
                </div>
              </div>
            </div>
          )}

          {/* ── stations ────────────────────────────────────────────────
              The career, read out of config.cv.toml so it cannot drift from
              the CV page. The rejected rebuild dropped this act entirely,
              which is a large part of why the page stopped presenting a
              person and started arguing a position. */}
          {act.kind === 'stations' && (
            <div class="split-stations">
              <div class="rise-stagger">
                <p class="act-eyebrow" style="--i:0">{act.eyebrow}</p>
                <h2 class="act-h" style="--i:1">{act.headline}</h2>
                <p class="mt-6 text-[0.86rem] max-w-[26rem]" style="--i:2; color: var(--text-secondary)">
                  {t.stationsNote}
                </p>
                <p class="mt-5" style="--i:3">
                  <a href={`/${lang}/`} class="cta" style="color: var(--accent)">{t.classicCV}</a>
                </p>
              </div>

              <ol class="stations rise-stagger">
                {stations.map((s, i) => (
                  <li class="station" style={`--i:${i}`}>
                    <span class="station-date">{s.dates}</span>
                    <span class="station-body">
                      <span class="station-role">{s.position}</span>
                      <span class="station-org">{s.company}</span>
                    </span>
                  </li>
                ))}
                {education.list.slice(0, 1).map((e) => (
                  <li class="station is-edu" style={`--i:${stations.length}`}>
                    <span class="station-date">{e.dates}</span>
                    <span class="station-body">
                      <span class="station-role">{e.degree}</span>
                      <span class="station-org">{e.college}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          )}

          {/* ── closing ─────────────────────────────────────────────────
              The bookend: the name in the same display type as the opening
              statement. The rejected version ended on four bullets and a
              thumbnail, so the page had no curtain. */}
          {act.kind === 'closing' && (
            <div class="text-center flex flex-col items-center closing">
              <p class="act-eyebrow rise">{act.eyebrow}</p>
              <h2 class="act-h act-h--loud rise">{act.headline}</h2>
              <ul class="act-bullets mt-8 max-w-[34rem] text-left rise-stagger">
                {act.bullets.map((b, i) => (
                  <li class="bullet" style={`--i:${i}`}><span class="bullet-mark" aria-hidden="true">·</span><span>{b}</span></li>
                ))}
              </ul>
              <p class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-2 rise" style="font-size: clamp(0.98rem, 1.4vw, 1.2rem)">
                {email && <a href={email.url} class="cta" style="color: var(--accent)">{email.title}</a>}
                {linkedin && <a href={linkedin.url} target="_blank" rel="noopener" class="cta">LinkedIn</a>}
                {github && <a href={github.url} target="_blank" rel="noopener" class="cta">GitHub</a>}
                <a href="https://github.com/bks-lab/open-bridge" target="_blank" rel="noopener" class="cta">open-bridge</a>
                {website && <a href={website.url} target="_blank" rel="noopener" class="cta">BKS-Lab</a>}
              </p>
              <img src={portrait} alt="" aria-hidden="true" width="750" height="1000" class="portrait-mark mt-9" />
              <p class="mt-8 text-[0.7rem]" style="color: var(--text-secondary)">
                {t.builtOn} {buildDate}
                <span class="block mt-1 text-[0.66rem] opacity-80">{t.builtOnNote}</span>
              </p>
              <p class="mt-6 text-[0.7rem] no-print" style="color: var(--text-secondary); opacity: 0.85">
                <a href={`/${lang}/`} class="hover:opacity-100">{t.classicCV}</a>
                &nbsp;&middot;&nbsp;
                <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} class="hover:opacity-100">PDF</a>
                &nbsp;&middot;&nbsp;
                <a href={`/${otherLang}/story/`} class="hover:opacity-100">{t.otherLangLabel}</a>
                &nbsp;&middot;&nbsp;
                <a href={`/${lang}/datenschutz`} class="hover:opacity-100">{t.legalPrivacy}</a>
                &nbsp;&middot;&nbsp;
                <a href={`/${lang}/impressum`} class="hover:opacity-100">{t.legalImpressum}</a>
              </p>
            </div>
          )}

        </div>
      </section>
    );
  })}
  </main>

  <style>
    @import '../styles/story.css';

    /* The root font size follows viewport height so every rem scales together
       and a dense act shrinks rather than overflows. A fixed px value escapes
       this: a "smaller" px once came out LARGER than the scaled rem it replaced
       on a 1366x768 screen. Everything below stays in rem. */
    :global(html:has(.story-page)) { font-size: clamp(12.5px, 1.78vh, 18px); }
    :global(html:has(.story-page)), :global(body:has(.story-page)) { overflow-x: clip; }

    .story-nav {
      background: color-mix(in srgb, var(--surface) 95%, transparent);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 16px 34px -30px rgba(15,23,42,0.30);
    }
    .story-key-hint {
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 9999px;
      padding: 0.28rem 0.55rem;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 7%, var(--surface));
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
    }

    /* ── Per-kind layout ─────────────────────────────────────────────── */

    /* Copy (and the screenshot, beside it) on the first row, the wide figure
       spanning both columns underneath. A wide figure stacked under a full-width
       column grew the act past the fold; this keeps the same reading order and
       fits. */
    .stack-wide {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(1.5rem, 3vh, 2.5rem) clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }
    /* `width`, not `max-width`, and `justify-self` instead of auto margins.
       The figure inside declares `container-type: inline-size`, so it cannot
       take its inline size from its own contents; combined with auto margins
       that left nothing to derive a width from and the whole figure collapsed
       to zero. A definite width fixes it at the source. */
    .stack-wide > .stack-figure {
      grid-column: 1 / -1;
      /* Height budget times the figure's own aspect ratio, capped at the act
         width. `width`, not `max-width`, and `justify-self` rather than auto
         margins: the figure inside declares `container-type: inline-size`, so
         it cannot take its inline size from its contents, and with auto margins
         there was nothing left to derive a width from. It collapsed to zero. */
      width: min(100%, 62rem, calc(var(--fig-h, 23vh) * var(--fig-ar, 3)));
      justify-self: center;
    }
    .stack-wide:not(:has(.shot-figure)) > :first-child { max-width: 46rem; }
    .stack-wide:not(:has(.shot-figure)) { grid-template-columns: minmax(0, 1fr); }

    .split-2 {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
      gap: clamp(2rem, 4.5vw, 4.5rem);
      align-items: center;
    }
    .split-stage {
      display: grid;
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }
    .split-finding {
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }

    /* The portrait act is the only one that bleeds to the act edges, so it
       cancels the shell padding rather than fighting it. */
    [data-act='portrait'] { padding: 0 !important; }
    .portrait-split {
      display: grid;
      grid-template-columns: 52fr 48fr;
      min-height: calc(100svh - var(--story-nav-height));
      width: 100%;
    }
    .portrait-side { position: relative; border-right: 1px solid var(--line); }
    .portrait-bleed {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      object-position: center 18%;
    }
    .portrait-copy {
      display: flex; flex-direction: column; justify-content: center;
      padding: clamp(2rem, 4vw, 4rem);
      background: var(--surface);
    }

    .offer-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.4rem, 3vw, 2.75rem);
      margin-top: 0.5rem;
    }
    .offer-cell {
      border-top: 1px solid var(--line);
      padding-top: 0.9rem;
      font-size: clamp(1rem, 1.45vw, 1.28rem);
      line-height: 1.45;
      color: var(--text-secondary);
    }
    .offer-head { color: var(--text); font-weight: 500; }

    .phone {
      width: min(17rem, 30vw);
      border: 1px solid var(--line);
      border-radius: 1.5rem;
      background: var(--surface-elevated);
      padding: 1rem;
      display: flex; flex-direction: column; gap: 0.5rem;
    }
    .phone-bubble {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      line-height: 1.45;
      padding: 0.5rem 0.7rem;
      border-radius: 0.7rem;
      background: color-mix(in srgb, var(--accent) 8%, transparent);
      color: var(--text);
    }
    .phone-bubble.is-them {
      background: transparent;
      border: 1px solid var(--line);
      color: var(--text-secondary);
    }
    .phone-note {
      font-size: 0.66rem;
      line-height: 1.4;
      color: var(--text-secondary);
      margin-top: 0.2rem;
    }

    .shot-figure { margin: 0; }
    .shot :global(img) { display: block; width: 100%; height: auto; }

    .rename {
      margin-top: 1.6rem;
      font-family: var(--font-mono);
      font-size: clamp(0.78rem, 1.05vw, 0.95rem);
      line-height: 1.9;
      display: flex; flex-direction: column;
    }
    .rename-before { color: var(--text-secondary); }
    .rename-after { color: var(--text); }

    .probe-note {
      display: block;
      margin-top: 0.3rem;
      font-size: 0.7rem;
      line-height: 1.4;
      color: var(--text-secondary);
    }

    .agent-dock { width: 100%; }
    .agent-facts {
      margin-top: 1.2rem;
      display: flex; flex-direction: column; gap: 0.7rem;
      font-size: 0.8rem;
    }
    .agent-facts > div { display: grid; grid-template-columns: 8rem 1fr; gap: 0.8rem; }
    .agent-facts dt { color: var(--text-secondary); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.66rem; padding-top: 0.15rem; }
    .agent-facts dd { color: var(--text); margin: 0; }

    .portrait-crop {
      width: min(14rem, 26vw);
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: center 20%;
      opacity: 0.9;
      mix-blend-mode: luminosity;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
      mask-composite: intersect;
    }

    /* ── The slab ──────────────────────────────────────────────────────
       Its own tokens because a hard dark surface that inherits --text would
       render #17212b on #131c2b in light mode: a contrast ratio near 1. */
    /* In light mode the slab is a dramatic dark band and carries the rhythm
       break on its own. In dark mode it cannot: measured, #060b14 against the
       page's #0f172a is a 1.10:1 step, which is no step. A darker fill is not
       available on an already dark page, so the break comes from the EDGE
       instead of the surface. Two accent hairlines read identically in both
       modes, and they are a deliberate mark rather than a workaround for a
       tone that will not carry. */
    [data-tone='slab'] {
      background: var(--slab-bg);
      color: var(--slab-text);
      border-block: 1px solid color-mix(in srgb, var(--slab-prompt) 42%, transparent);
    }
    [data-tone='slab'] .act-h,
    [data-tone='slab'] .bullet,
    [data-tone='slab'] .proof-label { color: var(--slab-text); }
    [data-tone='slab'] .bullet { opacity: 0.86; }
    [data-tone='slab'] .act-eyebrow,
    [data-tone='slab'] .proof,
    [data-tone='slab'] .bullet-mark { color: var(--slab-prompt); }
    [data-tone='slab'] .term {
      background: color-mix(in srgb, #000 22%, var(--slab-bg));
      border-color: var(--slab-line);
    }
    [data-tone='slab'] .term-bar { border-color: var(--slab-line); }
    [data-tone='slab'] .term-bar i { background: var(--slab-line); }
    [data-tone='slab'] .term-bar span,
    [data-tone='slab'] .term-out { color: color-mix(in srgb, var(--slab-text) 72%, transparent); }
    [data-tone='slab'] .term-cmd { color: var(--slab-text); }
    [data-tone='slab'] .term-p,
    [data-tone='slab'] .term-hit { color: var(--slab-prompt); }

    .tree {
      margin-top: 1.6rem;
      font-family: var(--font-mono);
      font-size: clamp(0.76rem, 1vw, 0.9rem);
      border-left: 1px solid var(--slab-prompt);
      padding-left: 0.9rem;
      display: flex; flex-direction: column; gap: 0.35rem;
    }
    .tree-row { display: flex; gap: 0.8rem; align-items: baseline; }
    .tree-path { color: var(--slab-text); min-width: 6.5rem; }
    .tree-label { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
    .tree-row.is-private .tree-path { opacity: 0.52; }

    .closing {
      background:
        radial-gradient(circle at 50% 16%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 28rem);
      width: 100%;
    }

    .story-page :global(#story-step-counter),
    .story-page :global(#story-keyboard-hint) {
      font-family: var(--font-body);
      border: 1px solid var(--line);
      border-radius: 9999px;
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      box-shadow: 0 14px 32px -26px rgba(15,23,42,0.36);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .story-page :global(#story-step-counter) {
      padding: 0.42rem 0.62rem; font-size: 0.72rem;
      letter-spacing: 0.12em; font-variant-numeric: tabular-nums;
    }
    .story-page :global(#story-keyboard-hint) {
      padding: 0.42rem 0.7rem; color: var(--text-secondary);
      font-size: 0.66rem; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
    }

    /* ── Docked chat panel ─────────────────────────────────────────────
       AgentWidget is a singleton with about thirty hardcoded ids, fixed
       localStorage keys and position:fixed on both launcher and panel. A
       second instance would duplicate every id and fire two card fetches.
       Docking it with CSS costs nothing and moves no DOM. */
    :global(html.aw-dock #agent-widget-panel) {
      bottom: auto; right: auto;
      top: calc(4.25rem + 12vh);
      left: 50%;
      translate: -50% 0;
      width: min(44rem, 92vw);
      height: min(52svh, 32rem);
      max-height: none;
      animation: none;
    }
    :global(html.aw-dock #agent-widget-resize),
    :global(html.aw-dock #agent-widget-maximize) { display: none; }

    @media (max-width: 1024px) {
      .split-2, .split-stage, .split-finding { grid-template-columns: minmax(0, 1fr); }
      .split-finding > div:first-child { display: flex; justify-content: flex-start; }
      .portrait-split { grid-template-columns: minmax(0, 1fr); }
      .portrait-side { border-right: none; border-bottom: 1px solid var(--line); aspect-ratio: 4 / 5; max-height: 46svh; }
      .offer-grid { grid-template-columns: minmax(0, 1fr); }
      .phone { width: min(17rem, 70vw); }
    }

    @media (max-width: 640px) {
      .story-page :global(#story-step-counter) { bottom: 1rem; left: 1rem; }
      .story-page :global(#story-keyboard-hint) { display: none !important; }
      :global(#agent-widget-label) { display: none !important; }
    }
  </style>

  <script>
    // Two opt-outs the widget reads, both set before it initialises.
    //
    // `aw-no-shift`: open() pads the body by 26rem on wide screens so the CV is
    // not covered. Here every act is viewport-high and horizontally composed, so
    // the padding does not free space, it slides the composition sideways.
    //
    // `aw-no-autoopen`: the panel must not open itself here. It covered a third
    // of every act, including the portrait, which is the one image on the page.
    // The launcher stays; act 07 is the invitation.
    document.documentElement.classList.add('aw-no-shift', 'aw-no-autoopen');

    const navPdf = document.getElementById('nav-pdf');
    const navRight = document.getElementById('nav-right');
    const progressBar = document.getElementById('scroll-progress');

    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      const show = y > 300;
      [navPdf, navRight].forEach(el => {
        if (show) { el?.classList.remove('opacity-0'); el?.classList.add('opacity-100'); }
        else { el?.classList.add('opacity-0'); el?.classList.remove('opacity-100'); }
      });
      document.querySelectorAll('#floating-nav a:not(.story-back), #floating-nav button').forEach(a => {
        (a as HTMLElement).tabIndex = show ? 0 : -1;
      });
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) progressBar.style.width = `${(y / max) * 100}%`;
    }, { passive: true });
  </script>

  <script>
    // The live card. Everything shown here comes from the running agent; when
    // it cannot be reached the card says so rather than showing a stale mock.
    // A fake "online" badge on a page whose first sentence is "declared is not
    // verified" would refute the page.
    (async () => {
      const state = document.getElementById('agent-state');
      const facts = document.getElementById('agent-facts');
      if (!state || !facts) return;
      const set = (k: string, v: string) => {
        const el = facts.querySelector<HTMLElement>(`[data-f="${k}"]`);
        if (el) el.textContent = v;
      };
      const h = window.location.hostname;
      const local = h === 'localhost' || h === '127.0.0.1' || h === '[::1]';
      const url = local
        ? '/agent-proxy/.well-known/agent-card.json'
        : 'https://mboiman.bks-lab.com/.well-known/agent-card.json';
      try {
        const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
        if (!res.ok) throw new Error(String(res.status));
        const card = await res.json();
        state.textContent = state.dataset.live || '';
        state.closest('.agent-card')?.setAttribute('data-state', 'live');
        set('name', card?.name || '');
        const iface = (card?.supportedInterfaces || [])[0] || {};
        set('proto', [card?.protocolVersion && `A2A ${card.protocolVersion}`, iface?.protocolBinding]
          .filter(Boolean).join(' · ') || 'A2A');
        set('url', (iface?.url || card?.url || 'mboiman.bks-lab.com').replace(/^https?:\/\//, ''));
      } catch {
        state.textContent = state.dataset.down || '';
        state.closest('.agent-card')?.setAttribute('data-state', 'down');
        set('name', '—');
        set('proto', '—');
        set('url', 'mboiman.bks-lab.com/.well-known/agent-card.json');
      }
    })();

    // Question buttons hand their prompt to the existing widget, which opens
    // itself on this event. Deliberately no separate open-on-scroll: a panel
    // that opens itself because the visitor scrolled past an act is intrusive,
    // and the card underneath already carries the live proof.
    document.querySelectorAll<HTMLElement>('.probe-ask').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('bridge-agent:prompt', { detail: { text: btn.dataset.prompt || '' } }));
      });
    });

    // Dock the panel while the live act is on screen.
    const liveAct = document.querySelector('[data-act="live"]');
    if (liveAct && 'IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        for (const e of entries) {
          document.documentElement.classList.toggle('aw-dock', e.isIntersecting);
        }
      }, { threshold: 0.6 }).observe(liveAct);
    }
  </script>

  <script>
    (function () {
      const steps: Element[] = [];
      document.querySelectorAll('.story-page section').forEach((sec) => {
        const divs = Array.from(sec.children).filter((c) => c.tagName === 'DIV');
        if (divs.length > 1) divs.forEach((d) => steps.push(d));
        else steps.push(sec);
      });
      if (steps.length < 2) return;

      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);

      let current = 0;
      let navigating = false;
      let navTimer = 0;
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const counter = document.createElement('div');
      counter.className = 'no-print';
      counter.id = 'story-step-counter';
      counter.setAttribute('aria-hidden', 'true');
      counter.style.cssText = 'position:fixed;bottom:1.5rem;left:1.75rem;z-index:60;pointer-events:none';
      document.body.appendChild(counter);

      const hint = document.createElement('div');
      hint.className = 'no-print';
      hint.id = 'story-keyboard-hint';
      hint.setAttribute('aria-hidden', 'true');
      const navLabel = document.documentElement.lang === 'en' ? 'Navigate' : 'Navigieren';
      hint.innerHTML = '<span style="font-size:.8rem;letter-spacing:.05em">← →</span><span>' + navLabel + '</span>';
      hint.style.cssText = 'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:60;display:flex;align-items:center;gap:.7rem;opacity:.78;transition:opacity .8s ease;pointer-events:none';
      document.body.appendChild(hint);
      let hintTimer = window.setTimeout(() => { hint.style.opacity = '0'; }, 4500);

      const pad = (n: number) => String(n).padStart(2, '0');
      const update = () => {
        counter.innerHTML = '<span style="color:var(--accent)">' + pad(current + 1) + '</span>'
          + '<span style="color:var(--text-secondary);opacity:.55"> / ' + pad(steps.length) + '</span>';
      };
      const fadeHint = () => { clearTimeout(hintTimer); hint.style.opacity = '0'; };

      const syncFromScroll = () => {
        const mark = window.innerHeight * 0.33;
        let idx = 0;
        for (let i = 0; i < steps.length; i++) {
          if (steps[i].getBoundingClientRect().top <= mark) idx = i;
        }
        current = idx; update();
      };

      // Firefox stable still ships scroll-driven animations behind a flag, so
      // this stays as the fallback reveal there. Where `view()` works, the CSS
      // owns the reveal and this only keeps the step counter honest.
      const cssDrivesReveal = CSS.supports && CSS.supports('animation-timeline: view()');
      const revealInView = () => {
        if (cssDrivesReveal) return;
        const vh = window.innerHeight;
        document.querySelectorAll('.rise:not(.visible), .rise-stagger:not(.visible)').forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.85) el.classList.add('visible');
        });
      };

      const goTo = (i: number) => {
        current = Math.max(0, Math.min(i, steps.length - 1));
        update();
        const el = steps[current];
        el.classList.add('visible');
        el.querySelectorAll('.rise, .rise-stagger').forEach((r) => r.classList.add('visible'));
        navigating = true;
        clearTimeout(navTimer);
        navTimer = window.setTimeout(() => { navigating = false; }, 700);
        el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      };

      document.addEventListener('keydown', (e) => {
        const tgt = e.target as HTMLElement | null;
        if (tgt && tgt.closest && tgt.closest('input,textarea,select,[contenteditable]')) return;
        if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].indexOf(e.key) > -1) { e.preventDefault(); goTo(current + 1); fadeHint(); }
        else if (['ArrowUp', 'ArrowLeft', 'PageUp'].indexOf(e.key) > -1) { e.preventDefault(); goTo(current - 1); fadeHint(); }
        else if (e.key === 'Home') { e.preventDefault(); goTo(0); fadeHint(); }
        else if (e.key === 'End') { e.preventDefault(); goTo(steps.length - 1); fadeHint(); }
      });

      let raf = 0;
      window.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          revealInView();
          if (!navigating) syncFromScroll();
        });
      }, { passive: true });

      revealInView();
      syncFromScroll();
    })();
  </script>
  </div>
</BaseLayout>
