---
/**
 * The presentation at /de/story/ and /en/story/.
 *
 * A pitch, not a document. Every act is one keyboard step and carries an
 * eyebrow, a headline, at most five bullets of at most eight words, one
 * verifiable anchor, and a hook that points at depth NOT shown on the slide.
 *
 * The previous version hand-built fifteen sections with paragraph-length copy
 * and read as a postmortem. This one loops over `i18n.acts`, so adding or
 * reordering an act is a data change. Three positions render differently: the
 * first opens, the second carries the portrait, the last closes with contact.
 *
 * Two structural rules survive from the old file:
 *  1. Every <section> has exactly ONE direct <div> child. The step script at the
 *     bottom derives steps from that shape.
 *  2. Full-viewport height comes from [data-act], never from aria-label, which
 *     used to list both language variants of every label in the CSS.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { getCVData } from '../lib/toml-loader';
import { i18n } from '../lib/i18n';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const t = i18n[lang];

const data = getCVData(lang);
const { profile, contact, ui } = data;

const email = contact.list.find(c => c.class === 'email');
const linkedin = contact.list.find(c => c.class === 'linkedin');
const github = contact.list.find(c => c.class === 'github');
const website = contact.list.find(c => c.class === 'website');
const location = ui.location || 'Frankfurt am Main';

const acts = t.acts;
const lastIndex = acts.length - 1;

// The "as of" eyebrow is stamped at build time. A hand-typed date keeps claiming
// it was checked today long after it was not.
const buildDate = new Date().toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric', month: 'long', day: 'numeric',
});

const storyTitle = lang === 'de'
  ? `${profile.name} · Projekt-Story`
  : `${profile.name} · Project Story`;
---

<BaseLayout title={storyTitle} description={ui.story_seo_description} lang={lang}>
  <div class="story-page">
  <div id="scroll-progress" style="width: 0%"></div>

  <header>
    <nav class="fixed top-0 left-0 right-0 z-50 no-print story-nav" id="floating-nav">
      <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href={`/${lang}/`} class="story-back text-xs tracking-[0.1em] uppercase opacity-70 hover:opacity-100 transition-opacity duration-300 cursor-pointer min-h-[44px] flex items-center gap-1.5" style="color: var(--text-secondary)" aria-label={t.storyBackToCv}>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            <span>{t.storyBackToCv}</span>
          </a>
          <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} download class="text-xs tracking-[0.1em] uppercase opacity-0 hover:opacity-80 transition-all duration-500 cursor-pointer min-h-[44px] min-w-[44px] flex items-center" style="color: var(--text-secondary)" id="nav-pdf" tabindex="-1">
            {t.pdfDownload}
          </a>
        </div>
        <div class="flex items-center gap-2 opacity-0 transition-all duration-500" id="nav-right">
          <span class="story-key-hint hidden sm:inline-flex">← →</span>
          <a href="/de/story/" class={`text-xs ${lang === 'de' ? 'font-semibold' : 'opacity-60 hover:opacity-100 transition-opacity'} min-h-[44px] min-w-[44px] flex items-center justify-center`} style={lang === 'de' ? 'color: var(--text)' : 'color: var(--text-secondary)'} tabindex="-1">DE</a>
          <span class="text-xs" style="color: var(--text-secondary); opacity: 0.4">|</span>
          <a href="/en/story/" class={`text-xs ${lang === 'en' ? 'font-semibold' : 'opacity-60 hover:opacity-100 transition-opacity'} min-h-[44px] min-w-[44px] flex items-center justify-center`} style={lang === 'en' ? 'color: var(--text)' : 'color: var(--text-secondary)'} tabindex="-1">EN</a>
          <DarkModeToggle />
        </div>
      </div>
    </nav>
  </header>

  <main id="main">
  {acts.map((act, i) => {
    const opener = i === 0;
    const portrait = i === 1;
    const closing = i === lastIndex;
    const eyebrow = act.id === '03-laeuft' ? `${act.eyebrow} · ${buildDate}` : act.eyebrow;
    return (
      <section
        data-act={opener ? 'opener' : 'frame'}
        id={act.id}
        aria-label={opener ? t.ariaStatement : closing ? t.ariaContact : portrait ? t.ariaProfile : act.headline}
      >
        <div class={`w-full ${opener ? 'max-w-6xl mx-auto' : 'max-w-5xl mx-auto'}`}>

          {opener && (
            <img
              src={`/images/${profile.avatar_story || 'profile_.jpg'}`}
              alt=""
              aria-hidden="true"
              class="opener-portrait no-print"
              width="750" height="1000"
            />
          )}

          {portrait ? (
            <div class="grid grid-cols-1 md:grid-cols-[minmax(0,20rem)_1fr] gap-10 md:gap-16 items-center reveal">
              <div class="relative mx-auto md:mx-0 w-full max-w-[20rem]">
                <div class="absolute -inset-14 rounded-full opacity-[0.14] blur-3xl" style="background: var(--accent)" aria-hidden="true"></div>
                <img src={`/images/${profile.avatar_story || 'profile_.jpg'}`} alt={profile.name} class="relative w-full portrait-img" width="360" height="480" />
                <p class="mt-5 text-[0.78rem] tracking-[0.18em] uppercase" style="color: var(--accent)">{t.storyRole}</p>
                <p class="mt-1 text-[0.84rem]" style="color: var(--text-secondary)">{location}</p>
              </div>
              <div>
                <p class="act-eyebrow">{eyebrow}</p>
                <h2 class="act-headline">{act.headline}</h2>
                <ul class="act-bullets">
                  {act.bullets.map(b => (
                    <li class="bullet"><span class="bullet-mark" aria-hidden="true">·</span><span>{b}</span></li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <div class={`reveal ${opener ? 'opener-copy' : ''}`}>
              <p class="act-eyebrow">{eyebrow}</p>
              {opener
                ? <h1 class="act-headline act-headline-lead">{act.headline}</h1>
                : <h2 class="act-headline">{act.headline}</h2>}

              {opener && (
                <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1 mt-6 mb-7">
                  <s class="lead-mono opacity-45" style="color: var(--text-secondary)">status: active</s>
                  <span class="lead-mono" style="color: var(--accent)">launchctl print</span>
                </div>
              )}

              <ul class={`act-bullets ${opener ? 'act-bullets-center' : ''}`}>
                {act.bullets.map(b => (
                  act.askAgent && b.trim().endsWith('?')
                    ? <li class="bullet"><span class="bullet-mark" aria-hidden="true">·</span><button type="button" class="probe-ask" data-prompt={b}>{b}</button></li>
                    : <li class="bullet"><span class="bullet-mark" aria-hidden="true">·</span><span>{b}</span></li>
                ))}
              </ul>

              {closing && (
                <img
                  src={`/images/${profile.avatar_story || 'profile_.jpg'}`}
                  alt={profile.name}
                  class="closing-mark"
                  width="750" height="1000"
                />
              )}

              {closing && (
                <div class="mt-9 flex flex-wrap gap-x-6 gap-y-2 text-base">
                  {email && <a href={email.url} class="cta" style="color: var(--accent)">{email.title}</a>}
                  {linkedin && <a href={linkedin.url} target="_blank" rel="noopener" class="cta">LinkedIn</a>}
                  {github && <a href={github.url} target="_blank" rel="noopener" class="cta">GitHub</a>}
                  <a href="https://github.com/bks-lab/open-bridge" target="_blank" rel="noopener" class="cta">open-bridge</a>
                  {website && <a href={website.url} target="_blank" rel="noopener" class="cta">BKS-Lab</a>}
                </div>
              )}

              {act.askAgent && (
                <p class="mt-4 text-[0.76rem] hidden" style="color: var(--text-secondary)" id="probe-down">{t.agentUnavailable}</p>
              )}
            </div>
          )}

          {(act.anchor || act.hook) && (
            <div class={`mt-8 pt-5 story-separator border-t grid grid-cols-1 gap-4 items-start reveal text-left ${opener ? 'max-w-[44rem]' : 'lg:grid-cols-[1fr_auto] lg:gap-12'}`}>
              <p class="text-[0.82rem] leading-relaxed" style="color: var(--text-secondary)">{act.hook}</p>
              {act.anchor && (
                <div class={opener ? '' : 'lg:text-right lg:min-w-[15rem] shrink-0'}>
                  {act.anchor.url
                    ? <a href={act.anchor.url} target="_blank" rel="noopener" class="proof-headline hover:opacity-80 transition-opacity">{act.anchor.text}</a>
                    : <span class="proof-headline">{act.anchor.text}</span>}
                  {act.anchor.label && <p class={`mt-1 text-[0.76rem] leading-snug ${opener ? '' : 'lg:ml-auto lg:max-w-[15rem]'}`} style="color: var(--text-secondary)">{act.anchor.label}</p>}
                  <p class="mt-1 text-[0.68rem] tracking-wide" style="color: var(--text-secondary)">
                    <span class="proof-dot" data-state={act.anchor.state} aria-hidden="true"></span>
                    {act.anchor.state === 'public' ? t.proofPublicLabel : `${t.proofClosedLabel} · ${act.anchor.note}`}
                  </p>
                </div>
              )}
            </div>
          )}

          {closing && (
            <p class="mt-10 text-[0.7rem] no-print" style="color: var(--text-secondary); opacity: 0.85">
              <a href={`/${lang}/`} class="hover:opacity-100">{t.classicCV}</a>
              &nbsp;&middot;&nbsp;
              <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} class="hover:opacity-100">PDF</a>
              &nbsp;&middot;&nbsp;
              <a href={`/${otherLang}/story/`} class="hover:opacity-100">{t.otherLangLabel}</a>
              &nbsp;&middot;&nbsp;
              <a href={`/${lang}/datenschutz`} class="hover:opacity-100">{t.legalPrivacy}</a>
              &nbsp;&middot;&nbsp;
              <a href={`/${lang}/impressum`} class="hover:opacity-100">{t.legalImpressum}</a>
            </p>
          )}
        </div>
      </section>
    );
  })}
  </main>

  <style>
    /* The root font size follows viewport height so every rem scales together
       and a dense act shrinks rather than overflows. Fixed px sizes defeat this:
       a "smaller" px value once came out LARGER than the scaled rem it replaced
       on a 1366x768 screen. Keep everything below in rem. */
    :global(html:has(.story-page)) { font-size: clamp(12.5px, 1.78vh, 18px); }

    .story-page {
      color: var(--text);
      --story-nav-height: 4.25rem;
      --story-step-pad-x: clamp(1.25rem, 4vw, 3rem);
      --story-step-pad-y: clamp(2.75rem, 6.5vh, 6rem);
      overflow-x: clip;
    }

    :global(html), :global(body) { overflow-x: hidden; }
    .story-page :is(h1, h2, p, span, a, li, button) { text-wrap: pretty; }

    .story-nav {
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 16px 34px -30px rgba(15,23,42,0.30);
    }

    .story-page [data-act] {
      min-height: calc(100svh - var(--story-nav-height));
      min-height: calc(100dvh - var(--story-nav-height));
      display: flex;
      align-items: center;
      padding-block: var(--story-step-pad-y);
      padding-inline: var(--story-step-pad-x);
      scroll-margin-top: var(--story-nav-height);
    }
    .story-page section:nth-of-type(even) { background-color: var(--bg-alt); }

    /* One photo, three treatments. Large and faded behind the opening statement,
       sharp beside the offer, and a small mark at the close. */
    .story-page .opener-portrait {
      position: absolute;
      right: max(0px, calc(50% - 36rem));
      top: 50%;
      transform: translateY(-50%);
      height: min(82vh, 46rem);
      width: auto;
      object-fit: cover;
      object-position: center 18%;
      opacity: 0.62;
      filter: contrast(1.04) saturate(0.1);
      mix-blend-mode: luminosity;
      /* The photo has a hard dark rectangle around it, so it needs to fade out on
         every side it touches, not just the left. A single left-only gradient left
         a visible box edge across the headline. */
      -webkit-mask-image:
        linear-gradient(to left, #000 30%, transparent 92%),
        linear-gradient(to top, transparent 0%, #000 22%),
        linear-gradient(to bottom, transparent 0%, #000 16%),
        linear-gradient(to right, #000 72%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to left, #000 30%, transparent 92%),
        linear-gradient(to top, transparent 0%, #000 22%),
        linear-gradient(to bottom, transparent 0%, #000 16%),
        linear-gradient(to right, #000 72%, transparent 100%);
      mask-composite: intersect;
      pointer-events: none;
      z-index: 0;
    }
    .story-page [data-act="opener"] { position: relative; }
    .story-page [data-act="opener"] > div { position: relative; z-index: 1; }

    .story-page .closing-mark {
      width: 5.5rem;
      height: 7.3rem;
      object-fit: cover;
      object-position: center top;
      border-radius: 0.6rem;
      margin-top: 1.6rem;
      filter: contrast(1.05);
      mix-blend-mode: luminosity;
    }

    .story-page .portrait-img {
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: center top;
      filter: contrast(1.05);
      mix-blend-mode: luminosity;
    }

    .story-key-hint {
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 9999px;
      padding: 0.28rem 0.55rem;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 7%, var(--surface));
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
    }

    .act-eyebrow {
      font-size: 0.72rem;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 1.1rem;
    }

    .act-headline {
      font-family: var(--font-display);
      font-weight: 400;
      letter-spacing: -0.04em;
      line-height: 1.06;
      font-size: clamp(1.9rem, 4.6vw, 3.9rem);
      margin-bottom: 1.9rem;
    }
    .act-headline-lead {
      font-weight: 300;
      font-size: clamp(2.1rem, 5.4vw, 5rem);
      line-height: 1.02;
      margin-bottom: 0;
    }

    [data-act="opener"] .act-bullets { gap: 0.6rem; }
    [data-act="opener"] .act-headline-lead { margin-bottom: 0; }

    .lead-mono {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: clamp(1.3rem, 3.6vw, 2.7rem);
      letter-spacing: -0.01em;
    }

    .act-bullets { display: flex; flex-direction: column; gap: 0.95rem; }
    .opener-copy { max-width: min(100%, 44rem); }
    .act-bullets-center { max-width: 38rem; }

    .bullet {
      display: flex;
      gap: 0.75rem;
      font-size: clamp(1.02rem, 1.65vw, 1.45rem);
      line-height: 1.42;
      color: var(--text-secondary);
    }
    .bullet-mark { flex: none; color: var(--accent); line-height: 1.35; }

    .probe-ask {
      text-align: left;
      cursor: pointer;
      color: var(--accent);
      border-bottom: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
      font: inherit;
    }
    .probe-ask:hover { border-bottom-color: var(--accent); }

    /* The verification anchor that replaced the giant metric. Never a counter:
       an open standard, a licence or release, a callable address, or a named
       procedure. */
    .proof-headline {
      display: block;
      font-family: var(--font-display);
      font-weight: 300;
      letter-spacing: -0.03em;
      font-size: clamp(1.5rem, 2.9vw, 2.5rem);
      line-height: 1.12;
      color: var(--accent);
      word-break: break-word;
    }

    .proof-dot {
      display: inline-block;
      width: 0.5em; height: 0.5em;
      border-radius: 9999px;
      margin-right: 0.45em;
      border: 1px solid var(--accent);
    }
    .proof-dot[data-state="public"] { background: var(--accent); }
    .proof-dot[data-state="closed"] { background: transparent; }

    .cta { border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent); transition: border-color .2s ease; }
    .cta:hover { border-bottom-color: var(--accent); }

    .story-separator { border-color: var(--line); }

    .story-page #story-step-counter, .story-page #story-keyboard-hint {
      font-family: var(--font-body);
      border: 1px solid var(--line);
      border-radius: 9999px;
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      box-shadow: 0 14px 32px -26px rgba(15,23,42,0.36);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .story-page #story-step-counter {
      padding: 0.42rem 0.62rem;
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      font-variant-numeric: tabular-nums;
    }
    .story-page #story-keyboard-hint {
      padding: 0.42rem 0.7rem;
      color: var(--text-secondary);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    @media (max-width: 640px) {
      .story-page { --story-step-pad-x: 1.25rem; --story-step-pad-y: clamp(3rem, 6vh, 4rem); }
      .story-page [data-act] { align-items: flex-start; }
      .story-page .opener-portrait { opacity: 0.16; right: -6vw; height: 62vh; }
      .story-page #story-step-counter { bottom: 1rem; left: 1rem; }
      .story-page #story-keyboard-hint, :global(#agent-widget-label) { display: none !important; }
    }
  </style>

  <script>
    const navPdf = document.getElementById('nav-pdf');
    const navRight = document.getElementById('nav-right');
    const progressBar = document.getElementById('scroll-progress');

    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      const show = y > 300;
      [navPdf, navRight].forEach(el => {
        if (show) { el?.classList.remove('opacity-0'); el?.classList.add('opacity-100'); }
        else { el?.classList.add('opacity-0'); el?.classList.remove('opacity-100'); }
      });
      document.querySelectorAll('#floating-nav a:not(.story-back), #floating-nav button').forEach(a => {
        (a as HTMLElement).tabIndex = show ? 0 : -1;
      });
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) progressBar.style.width = `${(y / max) * 100}%`;
    });
  </script>

  <script>
    document.querySelectorAll<HTMLElement>('.probe-ask').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('bridge-agent:prompt', { detail: { text: btn.dataset.prompt || '' } }));
      });
    });

    (async () => {
      const down = document.getElementById('probe-down');
      if (!down) return;
      const h = window.location.hostname;
      const local = h === 'localhost' || h === '127.0.0.1' || h === '[::1]';
      const url = local
        ? '/agent-proxy/.well-known/agent-card.json'
        : 'https://mboiman.bks-lab.com/.well-known/agent-card.json';
      try {
        const res = await fetch(url, { signal: AbortSignal.timeout(6000) });
        if (!res.ok) throw new Error(String(res.status));
        await res.json();
      } catch {
        down.classList.remove('hidden');
      }
    })();
  </script>

  <script>
    (function () {
      const steps: Element[] = [];
      document.querySelectorAll('.story-page section').forEach((sec) => {
        const divs = Array.from(sec.children).filter((c) => c.tagName === 'DIV');
        if (divs.length > 1) divs.forEach((d) => steps.push(d));
        else steps.push(sec);
      });
      if (steps.length < 2) return;

      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);

      let current = 0;
      let navigating = false;
      let navTimer = 0;
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const counter = document.createElement('div');
      counter.className = 'no-print';
      counter.id = 'story-step-counter';
      counter.setAttribute('aria-hidden', 'true');
      counter.style.cssText = 'position:fixed;bottom:1.5rem;left:1.75rem;z-index:60;pointer-events:none';
      document.body.appendChild(counter);

      const hint = document.createElement('div');
      hint.className = 'no-print';
      hint.id = 'story-keyboard-hint';
      hint.setAttribute('aria-hidden', 'true');
      const navLabel = document.documentElement.lang === 'en' ? 'Navigate' : 'Navigieren';
      hint.innerHTML = '<span style="font-size:13px;letter-spacing:.05em">← →</span><span>' + navLabel + '</span>';
      hint.style.cssText = 'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:60;display:flex;align-items:center;gap:.7rem;opacity:.78;transition:opacity .8s ease;pointer-events:none';
      document.body.appendChild(hint);
      let hintTimer = window.setTimeout(() => { hint.style.opacity = '0'; }, 4500);

      const pad = (n: number) => String(n).padStart(2, '0');
      const update = () => {
        counter.innerHTML = '<span style="color:var(--accent)">' + pad(current + 1) + '</span>'
          + '<span style="color:var(--text-secondary);opacity:.55"> / ' + pad(steps.length) + '</span>';
      };
      const fadeHint = () => { clearTimeout(hintTimer); hint.style.opacity = '0'; };

      const syncFromScroll = () => {
        const mark = window.innerHeight * 0.33;
        let idx = 0;
        for (let i = 0; i < steps.length; i++) {
          if (steps[i].getBoundingClientRect().top <= mark) idx = i;
        }
        current = idx; update();
      };

      const revealInView = () => {
        const vh = window.innerHeight;
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.85) el.classList.add('visible');
        });
      };

      const goTo = (i: number) => {
        current = Math.max(0, Math.min(i, steps.length - 1));
        update();
        const el = steps[current];
        el.classList.add('visible');
        el.querySelectorAll('.reveal').forEach((r) => r.classList.add('visible'));
        navigating = true;
        clearTimeout(navTimer);
        navTimer = window.setTimeout(() => { navigating = false; }, 700);
        el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      };

      document.addEventListener('keydown', (e) => {
        const tgt = e.target as HTMLElement | null;
        if (tgt && tgt.closest && tgt.closest('input,textarea,select,[contenteditable]')) return;
        if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].indexOf(e.key) > -1) { e.preventDefault(); goTo(current + 1); fadeHint(); }
        else if (['ArrowUp', 'ArrowLeft', 'PageUp'].indexOf(e.key) > -1) { e.preventDefault(); goTo(current - 1); fadeHint(); }
        else if (e.key === 'Home') { e.preventDefault(); goTo(0); fadeHint(); }
        else if (e.key === 'End') { e.preventDefault(); goTo(steps.length - 1); fadeHint(); }
      });

      let raf = 0;
      window.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          revealInView();
          if (!navigating) syncFromScroll();
        });
      }, { passive: true });

      revealInView();
      syncFromScroll();
    })();
  </script>
  </div>
</BaseLayout>
