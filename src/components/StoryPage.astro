---
/**
 * The presentation at /de/story/ and /en/story/.
 *
 * Fourteen acts, each one keyboard step. Two structural rules govern this file:
 *
 *  1. Every <section> has exactly ONE direct <div> child, except the decisions
 *     section, where each decision is its own direct <div> and therefore its own
 *     step. The step script at the bottom derives steps from that shape, so an
 *     extra wrapper silently splits an act into several.
 *  2. Full-viewport height is selected via [data-act], never via aria-label.
 *     The previous version listed the German and English aria-label strings in
 *     the CSS, so a new act, or a reworded label, quietly lost its height.
 *
 * All copy lives in src/lib/i18n.ts; positions, education and contacts come from
 * config.cv.toml. Nothing user-facing is hardcoded here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { getCVData } from '../lib/toml-loader';
import { formatToHTML } from '../lib/markdown';
import { i18n, darkScreenshots } from '../lib/i18n';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const t = i18n[lang];

const data = getCVData(lang);
const { profile, contact, ui, experiences, education, language: langs } = data;

// Talks and workshops get their own act (t.transfers). Without this filter the
// first five entries of experiences.list are three talks and two jobs, and the
// positions act shows lectures as if they were employment. CVPage.astro has had
// the same filter since it was written; the presentation never did.
const isTalk = (exp: { position: string; company?: string }) => {
  const p = (exp.position || '').toLowerCase();
  const c = (exp.company || '').toLowerCase();
  return /workshop|präsentation|presentation|impulsvortrag|vortrag|lecture|anwendungen von ki/.test(p)
      || /workshop|präsentation/.test(c);
};
const jobs = experiences.list.filter(e => !isTalk(e));
const recentJobs = jobs.slice(0, 3);
const olderJobs = jobs.slice(3);

/**
 * The positions act shows the opening paragraphs of a role, not its full bullet
 * inventory. Rendering `details` verbatim made this act 4365px tall against an
 * 832px viewport, i.e. five screens inside a single keyboard step. The tools
 * block is dropped here on purpose: the footer band below already lists them.
 */
const truncateRe = new RegExp(`^\\*\\*(${t.truncatePatterns.join('|')})`);
const toolsRe = new RegExp(`^\\*\\*(${t.truncateToolPatterns.join('|')})`);
function jobIntro(details: string): string {
  const kept: string[] = [];
  for (const line of details.split('\n')) {
    if (line.match(truncateRe) || line.match(toolsRe)) break;
    kept.push(line);
  }
  let intro = kept.join('\n').trim();
  const words = intro.split(/\s+/);
  if (words.length > 34) {
    const clipped = words.slice(0, 34).join(' ');
    const stop = Math.max(clipped.lastIndexOf('. '), clipped.lastIndexOf('! '), clipped.lastIndexOf('? '));
    intro = stop > 40 ? clipped.slice(0, stop + 1) : clipped + ' …';
  }
  return intro;
}

const email = contact.list.find(c => c.class === 'email');
const linkedin = contact.list.find(c => c.class === 'linkedin');
const github = contact.list.find(c => c.class === 'github');
const website = contact.list.find(c => c.class === 'website');
const location = ui.location || 'Frankfurt am Main';

// The "as of" line on act 03 is stamped at build time. A hand-typed date would
// keep claiming it was checked today long after it was not.
const buildDate = new Date().toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', {
  year: 'numeric', month: 'long', day: 'numeric',
});
const runningEyebrow = t.runningEyebrow.replace('{date}', buildDate);

const storyTitle = lang === 'de'
  ? `${profile.name} · Projekt-Story`
  : `${profile.name} · Project Story`;
---

<BaseLayout
  title={storyTitle}
  description={ui.story_seo_description}
  lang={lang}
>
  <div class="story-page">
  <div id="scroll-progress" style="width: 0%"></div>

  <!-- ═══ FLOATING NAV ═══ -->
  <header>
    <nav class="fixed top-0 left-0 right-0 z-50 no-print story-nav" id="floating-nav">
      <div class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <a href={`/${lang}/`} class="story-back text-xs tracking-[0.1em] uppercase opacity-60 hover:opacity-100 transition-opacity duration-300 cursor-pointer min-h-[44px] flex items-center gap-1.5" style="color: var(--text-secondary)" aria-label={t.storyBackToCv}>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            <span>{t.storyBackToCv}</span>
          </a>
          <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} download class="text-xs tracking-[0.1em] uppercase opacity-0 hover:opacity-80 transition-all duration-500 cursor-pointer min-h-[44px] min-w-[44px] flex items-center" style="color: var(--text-secondary)" id="nav-pdf" tabindex="-1">
            {t.pdfDownload}
          </a>
        </div>
        <div class="flex items-center gap-2 opacity-0 transition-all duration-500" id="nav-right">
          <span class="story-key-hint hidden sm:inline-flex">← →</span>
          <a href="/de/story/" class={`text-xs ${lang === 'de' ? 'font-semibold' : 'opacity-50 hover:opacity-100 transition-opacity'} min-h-[44px] min-w-[44px] flex items-center justify-center`} style={lang === 'de' ? 'color: var(--text)' : 'color: var(--text-secondary)'} tabindex="-1">DE</a>
          <span class="text-xs" style="color: var(--text-secondary); opacity: 0.3">|</span>
          <a href="/en/story/" class={`text-xs ${lang === 'en' ? 'font-semibold' : 'opacity-50 hover:opacity-100 transition-opacity'} min-h-[44px] min-w-[44px] flex items-center justify-center`} style={lang === 'en' ? 'color: var(--text)' : 'color: var(--text-secondary)'} tabindex="-1">EN</a>
          <DarkModeToggle />
        </div>
      </div>
    </nav>
  </header>

  <!-- ═══ AKT 01 · LEITSATZ ═══ -->
  <section class="act" data-act="frame" id="akt-01-leitsatz" aria-label={t.ariaStatement}>
    <div class="text-center max-w-5xl mx-auto">
      <p class="text-sm tracking-[0.2em] uppercase mb-12 opacity-0 animate-[fadeIn_1s_ease_0.3s_forwards]" style="color: var(--text-secondary)">
        {t.storyEyebrow}
      </p>
      <h1 class="story-display text-[clamp(2.2rem,6vw,5.6rem)] leading-[1.05] opacity-0 animate-[fadeIn_1.2s_ease_0.8s_forwards]" set:html={t.storyStatement} />
      <div class="mt-14 opacity-0 animate-[fadeIn_1s_ease_1.8s_forwards]">
        <div class="teal-rule"></div>
      </div>
      <p class="mt-10 text-sm sm:text-base leading-relaxed max-w-2xl mx-auto opacity-0 animate-[fadeIn_1s_ease_2.2s_forwards]" style="color: var(--text-secondary)">
        {t.storyStatementNote}
      </p>
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0 animate-[fadeIn_1s_ease_2.8s_forwards] no-print" aria-hidden="true">
        <svg class="w-5 h-5 animate-[scrollHint_2s_ease-in-out_infinite]" style="color: var(--text-secondary)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7" />
        </svg>
      </div>
    </div>
  </section>

  <main id="main">

  <!-- ═══ AKT 02 · PORTRAIT UND AUFSTELLUNG ═══ -->
  <section data-act="frame" id="akt-02-aufstellung" aria-label={t.ariaProfile}>
    <div class="reveal max-w-5xl mx-auto w-full">
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,15rem)_1fr] gap-10 md:gap-16 items-start">
        <div class="relative mx-auto md:mx-0 w-full max-w-[15rem]">
          <div class="absolute -inset-10 rounded-full opacity-[0.1] blur-3xl" style="background: var(--accent)" aria-hidden="true"></div>
          <img
            src={`/images/${profile.avatar_story || 'profile_.jpg'}`}
            alt={profile.name}
            class="relative w-full portrait-img"
            width="360"
            height="480"
          />
          <div class="mt-7 text-[13px]">
            <p class="act-label">{t.footerBandLabels.education}</p>
            {education.list.map(edu => (
              <p class="leading-snug mb-1.5" style="color: var(--text-secondary)">
                <span style="color: var(--text)">{edu.degree}</span>{edu.college ? `, ${edu.college}` : ''} <span style="opacity:.7">{edu.dates}</span>
              </p>
            ))}
            <p class="act-label mt-5">{t.footerBandLabels.languages}</p>
            {langs.list.map(l => (
              <p class="leading-snug mb-1" style="color: var(--text-secondary)">
                <span style="color: var(--text)">{l.language}</span> {l.level}
              </p>
            ))}
          </div>
        </div>
        <div>
          <p class="story-heading text-3xl sm:text-4xl tracking-tight">{profile.name}</p>
          <p class="mt-2 text-sm tracking-[0.15em] uppercase" style="color: var(--accent)">{t.storyRole}</p>
          <p class="mt-1 text-sm" style="color: var(--text-secondary)">{location}</p>
          <p class="mt-1 text-sm" style="color: var(--text-secondary)">{t.storyAffiliation}</p>
          <div class="mt-7 space-y-3.5">
            {t.storyPortraitText.map(p => (
              <p class="text-sm sm:text-[0.95rem] leading-relaxed" style="color: var(--text-secondary)">{p}</p>
            ))}
          </div>
          <p class="mt-7 pt-5 text-sm story-separator border-t" style="color: var(--text)">{t.availability}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ AKT 03 · WAS GERADE LÄUFT ═══
       Replaces the old numbers act. The giant-number type class survives, but it
       now carries a struck config claim against the command that checks it. -->
  <section data-act="frame" id="akt-03-was-laeuft" aria-label={t.ariaRunning} style="background-color: var(--bg-alt)">
    <div class="max-w-4xl mx-auto w-full">
      <div class="reveal">
        <p class="text-[11px] tracking-[0.25em] uppercase mb-4" style="color: var(--accent)">{runningEyebrow}</p>
        <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1 running-lead">
          <s class="story-number opacity-40" style="color: var(--text-secondary)">{t.runningLeadStruck}</s>
          <span class="story-number" style="color: var(--accent)">{t.runningLeadLive}</span>
        </div>
        <p class="mt-3 text-[13px] leading-relaxed max-w-2xl" style="color: var(--text-secondary)">{t.runningLeadNote}</p>
      </div>

      <h2 class="story-heading text-2xl sm:text-3xl mt-8 mb-5 reveal">{t.runningTitle}</h2>

      <div class="story-separator border-t">
        {t.running.map((item, i) => (
          <div class="reveal py-3.5 story-separator border-b grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-2 lg:gap-10 items-start" style={`transition-delay: ${i * 90}ms`}>
            <div>
              <p class="story-heading text-lg sm:text-xl tracking-tight">{item.title}</p>
              <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-secondary)">{item.mechanism}</p>
            </div>
            <div class="lg:text-right lg:min-w-[16rem] shrink-0">
              {item.proofUrl
                ? <a href={item.proofUrl} target="_blank" rel="noopener" class="proof-token hover:opacity-80 transition-opacity">{item.proof}</a>
                : <span class="proof-token">{item.proof}</span>}
              <p class="mt-1.5 text-[11px] tracking-wide" style="color: var(--text-secondary)">
                <span class="proof-dot" data-state={item.state} aria-hidden="true"></span>
                {item.state === 'public' ? t.proofPublicLabel : `${t.proofClosedLabel} · ${item.stateNote}`}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-4 text-[13px] leading-relaxed reveal" style="color: var(--text-secondary)">{t.runningOutro}</p>
    </div>
  </section>

  <!-- ═══ AKT 04 · FRAGEN SIE IHN SELBST ═══
       The cards fire the widget's existing `bridge-agent:prompt` event, so no new
       plumbing and no second chat client. -->
  <section data-act="frame" id="akt-04-fragen" aria-label={t.ariaProbe}>
    <div class="max-w-4xl mx-auto w-full reveal">
      <p class="text-[11px] tracking-[0.25em] uppercase mb-4" style="color: var(--accent)">{t.probeEyebrow}</p>
      <h2 class="story-heading text-3xl sm:text-4xl tracking-tight">{t.probeTitle}</h2>
      <p class="mt-5 text-sm sm:text-base leading-relaxed max-w-2xl" style="color: var(--text-secondary)">{t.probeIntro}</p>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-3 gap-5">
        {t.probes.map(p => (
          <div class="probe-card">
            <button type="button" class="probe-ask text-left w-full" data-prompt={p.question}>
              <span class="probe-q">{p.question}</span>
            </button>
            <p class="mt-3 text-[13px] leading-relaxed" style="color: var(--text-secondary)">{p.explains}</p>
          </div>
        ))}
      </div>

      <p class="mt-9 text-sm leading-relaxed max-w-2xl" style="color: var(--text-secondary)">{t.probeOutro}</p>
      <!-- Neither line is rendered until the card fetch below resolves. A page
           built on "check it yourself" cannot ship a hardcoded status line. -->
      <p class="mt-3 text-[13px] hidden" style="color: var(--text-secondary)" id="probe-live"
         data-tpl={t.probeLive} data-card="https://mboiman.bks-lab.com/.well-known/agent-card.json"></p>
      <p class="mt-3 text-[13px] hidden" style="color: var(--text-secondary); opacity: .7" id="probe-down">
        {t.probeUnavailable}
      </p>
    </div>
  </section>

  <!-- ═══ AKTE 05 bis 09 · ENTSCHEIDUNGEN ═══
       Each decision is a direct <div> of this section, so each becomes its own
       keyboard step. hasGamma is gone: the layout no longer depends on a vanity
       metric field being present, so no act can fall back to a bullet dump. -->
  <section aria-label={t.ariaDecisions}>
    {t.decisions.map((d, i) => {
      const bg = darkScreenshots[d.id];
      return (
        <div
          data-act="decision"
          id={`akt-0${i + 5}-${d.id}`}
          class="relative reveal overflow-hidden"
          style={`transition-delay: ${i * 60}ms; background-color: ${i % 2 === 0 ? 'var(--bg)' : 'var(--bg-alt)'}`}
        >
          {bg && (
            <div class="absolute inset-0 opacity-[0.04] bg-cover bg-center" style={`background-image: url('${bg}')`} aria-hidden="true"></div>
          )}
          <div class="relative max-w-5xl mx-auto w-full">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mb-5">
              <span class="text-[10px] tracking-[0.25em] uppercase" style="color: var(--accent)">{d.category}</span>
              <span class="text-[10px] tracking-wider uppercase hidden sm:inline" style="color: var(--text-secondary); opacity: 0.5">{d.stack}</span>
            </div>

            <h3 class="story-project-title text-2xl sm:text-3xl lg:text-[2.4rem] mb-6 tracking-tight leading-tight">{d.title}</h3>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-14 items-start">
              <div class="space-y-7">
                <div>
                  <p class="act-label">{t.decisionLabels.problem}</p>
                  <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">{d.problem}</p>
                </div>
                <div>
                  <p class="act-label">{t.decisionLabels.options}</p>
                  <ul class="space-y-1.5">
                    {d.rejected.map(r => (
                      <li class="option-row option-out"><span class="option-mark" aria-hidden="true">×</span><span>{r}</span></li>
                    ))}
                    <li class="option-row option-in"><span class="option-mark" aria-hidden="true">→</span><span>{d.chosen}</span></li>
                  </ul>
                </div>
              </div>

              <div>
                <p class="act-label">{t.decisionLabels.decision}</p>
                <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">{d.decision}</p>
                {d.coda && (
                  <p class="mt-4 text-sm leading-relaxed" style="color: var(--text-secondary); opacity: .75">{d.coda}</p>
                )}
              </div>
            </div>

            <div class="mt-7 pt-5 story-separator border-t grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-5 lg:gap-12 items-start">
              <div>
                <p class="act-label">{t.decisionLabels.price}</p>
                <p class="text-sm leading-relaxed" style="color: var(--text-secondary)">{d.price}</p>
              </div>
              <div class="lg:text-right lg:min-w-[17rem] shrink-0">
                {d.proofUrl
                  ? <a href={d.proofUrl} target="_blank" rel="noopener" class="proof-headline hover:opacity-80 transition-opacity">{d.proof}</a>
                  : <span class="proof-headline">{d.proof}</span>}
                <p class="mt-1.5 text-[12px] leading-snug lg:ml-auto lg:max-w-[17rem]" style="color: var(--text-secondary)">{d.proofLabel}</p>
                <p class="mt-1.5 text-[11px] tracking-wide" style="color: var(--text-secondary)">
                  <span class="proof-dot" data-state={d.state} aria-hidden="true"></span>
                  {d.state === 'public' ? t.proofPublicLabel : `${t.proofClosedLabel} · ${d.stateNote}`}
                </p>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </section>

  <!-- ═══ AKT 10 · VIER TORE ═══ -->
  <section data-act="frame" id="akt-10-tore" aria-label={t.ariaGates} style="background-color: var(--bg-alt)">
    <div class="max-w-4xl mx-auto w-full">
      <p class="text-[11px] tracking-[0.25em] uppercase mb-4 reveal" style="color: var(--accent)">{t.gatesEyebrow}</p>
      <h2 class="story-heading text-2xl sm:text-3xl tracking-tight mb-5 reveal">{t.gatesTitle}</h2>
      {t.gates.map((g, i) => (
        <div class={`reveal py-3 ${i < t.gates.length - 1 ? 'story-separator border-b' : ''}`} style={`transition-delay: ${i * 110}ms`}>
          <p class="story-heading text-lg sm:text-xl leading-snug tracking-tight">{g.rule}</p>
          <p class="mt-2 text-[13px] leading-relaxed" style="color: var(--text-secondary)">{g.mechanism}</p>
          <p class="mt-2 text-[13px] leading-relaxed gate-origin">{g.origin}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ═══ AKT 11 · KORREKTUREN ═══ -->
  <section data-act="frame" id="akt-11-korrekturen" aria-label={t.ariaCorrections}>
    <div class="max-w-4xl mx-auto w-full">
      <p class="text-[11px] tracking-[0.25em] uppercase mb-4 reveal" style="color: var(--accent)">{t.correctionsEyebrow}</p>
      <h2 class="story-heading text-2xl sm:text-3xl tracking-tight reveal">{t.correctionsTitle}</h2>
      <p class="mt-3 mb-5 text-sm leading-relaxed max-w-2xl reveal" style="color: var(--text-secondary)">{t.correctionsIntro}</p>

      {t.corrections.map((c, i) => (
        <div class="reveal py-3.5 story-separator border-t" style={`transition-delay: ${i * 90}ms`}>
          <p class="corr-row text-sm leading-relaxed" style="color: var(--text-secondary); opacity: .6">
            <span class="corr-label">{t.correctionLabels.assumption}</span><span>{c.assumption}</span>
          </p>
          <p class="corr-row mt-2 text-sm leading-relaxed" style="color: var(--text-secondary)">
            <span class="corr-label">{t.correctionLabels.check}</span><span>{c.check}</span>
          </p>
          <p class="corr-row mt-2 text-sm leading-relaxed" style="color: var(--text)">
            <span class="corr-label" style="color: var(--accent)">{t.correctionLabels.result}</span><span>{c.result}</span>
          </p>
        </div>
      ))}

      <div class="reveal mt-6 pt-5 story-separator border-t">
        <p class="act-label">{t.disclaimerTitle}</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {t.disclaimers.map(d => (
            <p class="text-[13px] leading-relaxed" style="color: var(--text-secondary)">{d}</p>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ AKT 12 · STATIONEN ═══ -->
  <section aria-label={t.experienceTitle}>
    <div data-act="frame" id="akt-12-stationen">
     <div class="max-w-4xl mx-auto w-full">
      <h2 class="story-heading text-2xl sm:text-3xl tracking-tight mb-6 reveal">{t.experienceTitle}</h2>

      {recentJobs.map((exp, i) => (
        <div class="reveal mb-7 last:mb-0" style={`transition-delay: ${Math.min(i * 60, 240)}ms`}>
          <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
            <h3 class="text-base font-sans font-medium" style="color: var(--accent)">{exp.position}</h3>
            <span class="text-sm whitespace-nowrap" style="color: var(--text-secondary)">{exp.dates}</span>
          </div>
          <p class="text-sm mb-3" style="color: var(--text-secondary)">{exp.company}</p>
          <div class="text-[13px] leading-[1.8] [&_strong]:text-[var(--text)] [&_strong]:font-medium" style="color: var(--text-secondary)" set:html={formatToHTML(jobIntro(exp.details))} />
          {i < recentJobs.length - 1 && <div class="story-separator border-b mt-6"></div>}
        </div>
      ))}

     </div>
    </div>

    <div data-act="frame" id="akt-12b-frueher">
     <div class="max-w-4xl mx-auto w-full">
      {olderJobs.length > 0 && (
        <div class="reveal">
          <p class="text-xs tracking-[0.2em] uppercase mb-5" style="color: var(--text-secondary)">{t.earlierPositions}</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10">
            {olderJobs.map(exp => (
              <div class="exp-compact">
                <div class="min-w-0">
                  <span class="text-[13px] font-medium" style="color: var(--text)">{exp.position}</span>
                  <span class="text-[13px] ml-2" style="color: var(--text-secondary)">{exp.company}</span>
                </div>
                <span class="text-xs whitespace-nowrap ml-3" style="color: var(--text-secondary)">{exp.dates}</span>
              </div>
            ))}
          </div>
        </div>
      )}

      <div class="reveal mt-8 pt-6 story-separator border-t text-[13px]">
        <p class="act-label">{t.footerBandLabels.tools}</p>
        <p class="leading-relaxed" style="color: var(--text-secondary)">{ui.sidebar_skills.join(' · ')}</p>
      </div>
     </div>
    </div>
  </section>

  <!-- ═══ AKT 13 · WEITERGEBEN ═══ -->
  <section data-act="frame" id="akt-13-weitergeben" aria-label={t.ariaTransfer} style="background-color: var(--bg-alt)">
    <div class="max-w-4xl mx-auto w-full">
      <p class="text-[11px] tracking-[0.25em] uppercase mb-4 reveal" style="color: var(--accent)">{t.transferEyebrow}</p>
      <div class="reveal">
        <p class="story-heading text-2xl sm:text-[2.1rem] leading-tight tracking-tight" style="color: var(--accent)">{t.transferQuote}</p>
        <p class="mt-3 text-[13px] leading-relaxed max-w-2xl" style="color: var(--text-secondary)">{t.transferQuoteNote}</p>
      </div>
      <div class="mt-9 grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-7">
        {t.transfers.map((item, i) => (
          <div class="reveal" style={`transition-delay: ${i * 80}ms`}>
            <p class="text-sm font-medium" style="color: var(--text)">{item.title}</p>
            <p class="mt-1.5 text-[13px] leading-relaxed" style="color: var(--text-secondary)">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  </main>

  <!-- ═══ AKT 14 · ABSCHLUSS ═══ -->
  <footer>
  <section class="act" data-act="frame" id="akt-14-abschluss" aria-label={t.ariaContact}>
    <div class="text-center reveal max-w-2xl mx-auto">
      <p class="story-display text-4xl sm:text-6xl lg:text-7xl mb-5">{profile.name}</p>
