    }
    .agent-facts > div { display: grid; grid-template-columns: 8rem 1fr; gap: 0.8rem; }
    .agent-facts dt { color: var(--text-secondary); letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.66rem; padding-top: 0.15rem; }
    .agent-facts dd { color: var(--text); margin: 0; }
    /* Same reason as the terminal block in story.css: the skills row made this
       card one line taller, and on a 640px-high screen the act had no spare
       room to give. The rows carry more air than they need. */
    @media (max-height: 720px) {
      .agent-facts { margin-top: 0.9rem; gap: 0.5rem; }
    }

    /* Skill ids from the live card. Monospace and boxed, because they are
       identifiers a client passes over the wire, not prose. They wrap: the
       count comes from the agent and is not this page's to cap. */
    .agent-skills { display: flex; flex-wrap: wrap; gap: 0.35rem; }
    /* :global is required, not decoration. The chips are created by the card
       script at runtime, so they never carry the data-astro-cid attribute that
       scoped CSS matches on, and a plain `.agent-skill` rule silently does
       nothing: right class, no styling. Kept under the scoped parent so the
       global part cannot reach past this act. */
    .agent-skills :global(.agent-skill) {
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1.5;
      padding: 0.12rem 0.5rem;
      border-radius: 4px;
      /* A tint rather than a border: --line sits at ten percent alpha, which
         is right for a card edge and invisible at chip size on the same
         surface. Tinting off --accent carries both themes. */
      background: color-mix(in srgb, var(--accent) 13%, transparent);
      color: var(--text-secondary);
      white-space: nowrap;
    }

    .portrait-crop {
      width: min(14rem, 26vw);
      aspect-ratio: 4 / 5;
      object-fit: cover;
      object-position: center 20%;
      opacity: 0.9;
      mix-blend-mode: luminosity;
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
      -webkit-mask-composite: source-in;
      mask-image:
        linear-gradient(to right, transparent 0%, #000 12%, #000 88%, transparent 100%),
        linear-gradient(to bottom, transparent 0%, #000 10%, #000 90%, transparent 100%);
      mask-composite: intersect;
    }

    /* ── The slab ──────────────────────────────────────────────────────
       Its own tokens because a hard dark surface that inherits --text would
       render #17212b on #131c2b in light mode: a contrast ratio near 1. */
    /* In light mode the slab is a dramatic dark band and carries the rhythm
       break on its own. In dark mode it cannot: measured, #060b14 against the
       page's #0f172a is a 1.10:1 step, which is no step. A darker fill is not
       available on an already dark page, so the break comes from the EDGE
       instead of the surface. Two accent hairlines read identically in both
       modes, and they are a deliberate mark rather than a workaround for a
       tone that will not carry. */
    [data-tone='slab'] {
      background: var(--slab-bg);
      color: var(--slab-text);
      border-block: 1px solid color-mix(in srgb, var(--slab-prompt) 42%, transparent);
    }
    [data-tone='slab'] .act-h,
    [data-tone='slab'] .bullet,
    [data-tone='slab'] .proof-label { color: var(--slab-text); }
    [data-tone='slab'] .bullet { opacity: 0.86; }
    [data-tone='slab'] .act-eyebrow,
    [data-tone='slab'] .proof,
    [data-tone='slab'] .bullet-mark { color: var(--slab-prompt); }
    [data-tone='slab'] .term {
      background: color-mix(in srgb, #000 22%, var(--slab-bg));
      border-color: var(--slab-line);
    }
    [data-tone='slab'] .term-bar { border-color: var(--slab-line); }
    [data-tone='slab'] .term-bar i { background: var(--slab-line); }
    [data-tone='slab'] .term-bar span,
    [data-tone='slab'] .term-out { color: color-mix(in srgb, var(--slab-text) 72%, transparent); }
    [data-tone='slab'] .term-cmd { color: var(--slab-text); }
    [data-tone='slab'] .term-p,
    [data-tone='slab'] .term-hit { color: var(--slab-prompt); }

    .tree {
      margin-top: 1.6rem;
      font-family: var(--font-mono);
      font-size: clamp(0.76rem, 1vw, 0.9rem);
      border-left: 1px solid var(--slab-prompt);
      padding-left: 0.9rem;
      display: flex; flex-direction: column; gap: 0.35rem;
    }
    .tree-row { display: flex; gap: 0.8rem; align-items: baseline; }
    .tree-path { color: var(--slab-text); min-width: 6.5rem; }
    .tree-label { font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.7; }
    .tree-row.is-private .tree-path { opacity: 0.52; }

    .closing {
      background:
        radial-gradient(circle at 50% 16%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 28rem);
      width: 100%;
    }

    /* The nav bar fades out above the fold. Since it is reachable by keyboard
       again (see the scroll handler below), it has to become visible when a
       keyboard actually gets there, or focus sits on something nobody can see.
       The `!important` is required: the scroll handler toggles Tailwind's
       opacity classes directly on these elements. */
    #nav-right:focus-within { opacity: 1 !important; }
    #nav-pdf:focus-visible { opacity: 1 !important; }

    /* NOT `.story-page :global(#id)`. Both elements are appended to <body> by
       the step engine at the bottom of this file, so they are siblings of
       .story-page and never descendants of it. The descendant selector matched
       nothing and every declaration below was silently inert: measured live,
       border-width 0, background transparent, no blur, font-size 16px instead
       of 0.72rem. The counter and the hint have been rendering as bare letters
       over the acts this whole time while the pill they were designed as sat
       unused in the stylesheet. Same class of miss as the runtime-built skill
       chips further down, one level up. */
    :global(#story-step-counter),
    :global(#story-keyboard-hint) {
      font-family: var(--font-body);
      border: 1px solid var(--line);
      border-radius: 9999px;
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      box-shadow: 0 14px 32px -26px rgba(15,23,42,0.36);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    :global(#story-step-counter) {
      padding: 0.42rem 0.62rem; font-size: 0.72rem;
      letter-spacing: 0.12em; font-variant-numeric: tabular-nums;
    }
    :global(#story-keyboard-hint) {
      padding: 0.42rem 0.7rem; color: var(--text-secondary);
      font-size: 0.66rem; font-weight: 500;
      letter-spacing: 0.18em; text-transform: uppercase;
    }

    /* ── Chat panel as a right rail ────────────────────────────────────
       AgentWidget is a singleton with about thirty hardcoded ids, fixed
       localStorage keys and position:fixed on both launcher and panel. A
       second instance would duplicate every id and fire two card fetches, so
       it is placed with CSS and no DOM moves.

       What it used to do here, and why that was wrong: the open panel was a
       floating card over the bottom right of whatever act was on screen, and
       while the live act was in view it moved to the middle and sat on top of
       the composition. Both covered exactly what the visitor came to look at,
       and the page underneath kept its full width, so nothing reflowed out of
       the way. The widget's own remedy, padding the body by a hardcoded 26rem,
       does not fit either: it slides a centred, viewport-high composition
       sideways instead of narrowing it (that is what `aw-no-shift` opts out of,
       see the script below).

       It is a rail now. It takes the right edge over the full height, and the
       acts get the width that is left, so both are fully visible at once.

       --aw-rail is the ONE number both halves read: the panel's width and the
       space the page keeps clear. Two numbers here would drift apart on the
       first change and leave either a gap or an overlap. It sits on <html>
       rather than on .story-page because the panel is a body-level singleton
       and is not a descendant of the page wrapper. Zero below 1280px, where the
       panel stays the overlay card it was: 1024px was tried and is too narrow.
       A 20rem rail leaves a 751px frame, and at that width the fixed step
       counter in the bottom left runs into the act's own text (measured: the
       counter ends at 76px, the text starts at 68px). Two columns plus a rail
       need more room than a small laptop has.

       The clamp floor is 20rem on purpose: the panel carries min-width 320px,
       and a rail narrower than that would let the panel overhang the space
       reserved for it. Floor and min-width are the same number. */
    :global(html) { --aw-rail: 0px; }

    @media (min-width: 1280px) {
      :global(html.aw-panel-open) { --aw-rail: clamp(20rem, 26vw, 26rem); }

      :global(html.aw-panel-open #agent-widget-panel),
      :global(html.aw-panel-open #agent-widget-panel.aw-is-max) {
        top: 0; bottom: 0; right: 0; left: auto;
        translate: none;
        width: var(--aw-rail);
        min-width: 0;
        max-width: none;
        height: auto;
        max-height: none;
        border-radius: 0;
        border-width: 0 0 0 1px;
        animation: none;
      }
      /* Resizing and maximising are gestures for a floating card. A rail's
         width is the page's business, and dragging it would desynchronise the
         panel from the space reserved for it. */
      :global(html.aw-panel-open #agent-widget-resize),
      :global(html.aw-panel-open #agent-widget-maximize) { display: none; }
    }

    .story-page {
      padding-right: var(--aw-rail);
      transition: padding-right 0.2s ease-out;
    }
    @media (prefers-reduced-motion: reduce) {
      .story-page { transition: none; }
    }

    /* Narrowing the frame is not enough on its own. Each act's inner column is
       capped at 72rem and centred, so on a wide screen the visible left gutter
       is that auto margin, about a tenth of the screen, and NOT the act's own
       padding. Take 26rem away and the column no longer fits, the auto margin
       goes to zero, and the composition snaps against the left edge with the
       3.25rem of padding it always had. Measured: the headline moved from 143px
       to 51px and ran into the fixed step counter at the bottom left.

       So while the rail is open the gutter comes from padding instead, sized as
       a share of the frame that is actually left rather than of the window. The
       floor is the closed-state padding, so this can only ever add room. */
    @media (min-width: 1280px) {
      :global(html.aw-panel-open) .story-page {
        --story-pad-x: clamp(3.25rem, calc((100vw - var(--aw-rail)) * 0.09), 7rem);
      }
      /* The nav's own column centres the same way and loses the same margin, so
         it is pinned to the acts' gutter rather than drifting 70px left of it. */
      :global(html.aw-panel-open) .story-page .story-nav > div {
        padding-inline: var(--story-pad-x);
      }
    }

    /* position:fixed resolves against the viewport, so the wrapper's padding
       does not reach the furniture. Each fixed piece is told about the rail
       itself. The step counter sits on the left and needs nothing. */
    .story-page .story-nav { right: var(--aw-rail); }
    .story-page :global(#scroll-progress) {
      /* The bar's width is an inline percentage set on scroll, so it cannot be
         inset with `right`. Capping it is enough to keep it out of the rail. */
      max-width: calc(100% - var(--aw-rail));
    }

    @media (max-width: 1024px) {
      .split-2, .split-stage, .split-finding { grid-template-columns: minmax(0, 1fr); }
      .split-finding > div:first-child { display: flex; justify-content: flex-start; }
      .portrait-split { grid-template-columns: minmax(0, 1fr); }
      .portrait-side { border-right: none; border-bottom: 1px solid var(--line); aspect-ratio: 4 / 5; max-height: 46svh; }
      .offer-grid { grid-template-columns: minmax(0, 1fr); }
      .phone { width: min(17rem, 70vw); }
    }

    @media (max-width: 640px) {
      /* The counter goes away on a phone rather than moving. There are no arrow
         keys there, so there is no step for it to number, and it demonstrably
         lands on content: on the skills row of the live act and on the sender
         label of act 07. That is the same call the next line already made for
         the keyboard hint. Position 01 stays visible at the top as the progress
         bar. The `!important` is not decoration: the step engine writes bottom
         and left as an inline cssText, and inline beats any ordinary rule. */
      :global(#story-step-counter) { display: none !important; }
      :global(#story-keyboard-hint) { display: none !important; }
      :global(#agent-widget-label) { display: none !important; }
    }
  </style>

  <script>
    // Two opt-outs the widget reads, both set before it initialises.
    //
    // `aw-no-shift`: open() pads the BODY by a hardcoded 26rem on wide screens
    // so the CV is not covered. That is the wrong instrument here. Padding the
    // body slides a centred, viewport-high composition sideways instead of
    // narrowing it, and 26rem is not the width the panel actually has. The page
    // does its own version instead, from the same --aw-rail the panel is sized
    // with, on .story-page rather than on body. See the rail block in the style.
    //
    // `aw-no-autoopen`: the panel must not open itself here. It covered a third
    // of every act, including the portrait, which is the one image on the page.
    // The launcher stays; act 07 is the invitation.
    document.documentElement.classList.add('aw-no-shift', 'aw-no-autoopen');

    const navPdf = document.getElementById('nav-pdf');
    const navRight = document.getElementById('nav-right');
    const progressBar = document.getElementById('scroll-progress');

    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      const show = y > 300;
      [navPdf, navRight].forEach(el => {
        if (show) { el?.classList.remove('opacity-0'); el?.classList.add('opacity-100'); }
        else { el?.classList.add('opacity-0'); el?.classList.remove('opacity-100'); }
      });
      // The tab order used to be switched here, and the markup shipped these
      // links as so they started out unreachable. At scroll 0 that
      // left the PDF link and both language links locked out of the keyboard
      // while the theme toggle, which kept tabindex 0, took focus inside a
      // container at opacity 0: focus landed on something invisible and the
      // three visible targets could not be reached at all. WCAG 2.1.1 and 2.4.7
      // in one spot. Fading in and out stays purely visual now, and the
      // :focus-within rule in the style above reveals the bar when a keyboard
      // reaches it, so nothing is both focusable and invisible.
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) progressBar.style.width = `${(y / max) * 100}%`;
    }, { passive: true });
  </script>

  <script>
    // The live card. Everything shown here comes from the running agent; when
    // it cannot be reached the card says so rather than showing a stale mock.
    // A fake "online" badge on a page whose first sentence is "declared is not
    // verified" would refute the page.
    (async () => {
      const state = document.getElementById('agent-state');
      const facts = document.getElementById('agent-facts');
      if (!state || !facts) return;
      const set = (k: string, v: string) => {
        const el = facts.querySelector<HTMLElement>(`[data-f="${k}"]`);
        if (el) el.textContent = v;
      };
      const h = window.location.hostname;
      const local = h === 'localhost' || h === '127.0.0.1' || h === '[::1]';
      const url = local
        ? '/agent-proxy/.well-known/agent-card.json'
        : 'https://mboiman.bks-lab.com/.well-known/agent-card.json';
      // Only now is a check genuinely running, so only now may the card say so.
      state.textContent = state.dataset.checking || '';
      try {
        const res = await fetch(url, { signal: AbortSignal.timeout(8000) });
        if (!res.ok) throw new Error(String(res.status));
        const card = await res.json();
        state.textContent = state.dataset.live || '';
        state.closest('.agent-card')?.setAttribute('data-state', 'live');
        set('name', card?.name || '');
        const iface = (card?.supportedInterfaces || [])[0] || {};
        // The version lives on the interface, not at the top of the card. This
        // read the top level only, so the whole "A2A <version>" half was
        // silently dropped and the act about an open protocol displayed a card
        // that said nothing but "JSONRPC". Interface first, top level as the
        // fallback for older card shapes.
        const proto = iface?.protocolVersion || card?.protocolVersion;
        set('proto', [proto && `A2A ${proto}`, iface?.protocolBinding]
          .filter(Boolean).join(' · ') || 'A2A');
        set('url', (iface?.url || card?.url || 'mboiman.bks-lab.com').replace(/^https?:\/\//, ''));

        // The skills, as the ids an A2A client actually addresses. Ids and not
        // names on purpose: the card is served in one language, so its German
        // skill names would land untranslated on the English page, while an id
        // is language neutral and reads as what it is. Two of them are the
        // agent mesh from act 04, which nothing on the page could check before.
        const skills = (card?.skills || []).map((s: { id?: string }) => s?.id).filter(Boolean);
        const skillRow = document.getElementById('agent-skills');
        if (skillRow && skills.length) {
          skillRow.innerHTML = '';
          for (const id of skills) {
            const chip = document.createElement('span');
            chip.className = 'agent-skill';
            chip.textContent = id;
            skillRow.appendChild(chip);
          }
        }
      } catch {
        state.textContent = state.dataset.down || '';
        state.closest('.agent-card')?.setAttribute('data-state', 'down');
        // Not an em dash. The script used to write three of them into visible
        // rows, which broke the project's own no-dash rule from inside the code
        // that renders the page arguing for it.
        const unbekannt = facts.dataset.unknown || '';
        set('name', unbekannt);
        set('proto', unbekannt);
        set('url', 'mboiman.bks-lab.com/.well-known/agent-card.json');
        const skillRow = document.getElementById('agent-skills');
        if (skillRow) skillRow.textContent = unbekannt;
      }
    })();

    // Question buttons hand their prompt to the existing widget, which opens
    // itself on this event. Deliberately no separate open-on-scroll: a panel
    // that opens itself because the visitor scrolled past an act is intrusive,
    // and the card underneath already carries the live proof.
    document.querySelectorAll<HTMLElement>('.probe-ask').forEach((btn) => {
      btn.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('bridge-agent:prompt', { detail: { text: btn.dataset.prompt || '' } }));
      });
    });

    // The panel used to be moved to the middle of the screen while the live act
    // was in view, by an observer that toggled an `aw-dock` class. That is gone:
    // the panel is a right rail on every act now (see the rail block in the
    // style above), so it is already beside the live act without a special case,
    // and the special case was the version that covered the composition.
  </script>

  <script>
    (function () {
      const steps: Element[] = [];
      document.querySelectorAll('.story-page section').forEach((sec) => {
        const divs = Array.from(sec.children).filter((c) => c.tagName === 'DIV');
        if (divs.length > 1) divs.forEach((d) => steps.push(d));
        else steps.push(sec);
      });
      if (steps.length < 2) return;

      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);

      let current = 0;
      let navigating = false;
      let navTimer = 0;
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const counter = document.createElement('div');
      counter.className = 'no-print';
      counter.id = 'story-step-counter';
      counter.setAttribute('aria-hidden', 'true');
      counter.style.cssText = 'position:fixed;bottom:1.5rem;left:1.75rem;z-index:60;pointer-events:none';
      document.body.appendChild(counter);

      const hint = document.createElement('div');
      hint.className = 'no-print';
      hint.id = 'story-keyboard-hint';
      hint.setAttribute('aria-hidden', 'true');
      const navLabel = document.documentElement.lang === 'en' ? 'Navigate' : 'Navigieren';
      hint.innerHTML = '<span style="font-size:.8rem;letter-spacing:.05em">← →</span><span>' + navLabel + '</span>';
      // Centred on the READING area, not on the viewport: with the chat rail
      // open the two are no longer the same, and a hint centred on the viewport
      // drifts under the rail. --aw-rail is 0 whenever the rail is closed, so
      // this is plain 50% the rest of the time.
      hint.style.cssText = 'position:fixed;bottom:1.5rem;left:calc(50% - var(--aw-rail, 0px) / 2);transform:translateX(-50%);z-index:60;display:flex;align-items:center;gap:.7rem;opacity:.78;transition:opacity .8s ease;pointer-events:none';
      document.body.appendChild(hint);
      let hintTimer = window.setTimeout(() => { hint.style.opacity = '0'; }, 4500);

      const pad = (n: number) => String(n).padStart(2, '0');
      const update = () => {
        counter.innerHTML = '<span style="color:var(--accent)">' + pad(current + 1) + '</span>'
          + '<span style="color:var(--text-secondary);opacity:.55"> / ' + pad(steps.length) + '</span>';
      };
      const fadeHint = () => { clearTimeout(hintTimer); hint.style.opacity = '0'; };

      const syncFromScroll = () => {
        const mark = window.innerHeight * 0.33;
        let idx = 0;
        for (let i = 0; i < steps.length; i++) {
          if (steps[i].getBoundingClientRect().top <= mark) idx = i;
        }
        current = idx; update();
      };

      // Firefox stable still ships scroll-driven animations behind a flag, so
      // this stays as the fallback reveal there. Where `view()` works, the CSS
      // owns the reveal and this only keeps the step counter honest.
      const cssDrivesReveal = CSS.supports && CSS.supports('animation-timeline: view()');
      const revealInView = () => {
        if (cssDrivesReveal) return;
        const vh = window.innerHeight;
        document.querySelectorAll('.rise:not(.visible), .rise-stagger:not(.visible)').forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.85) el.classList.add('visible');
        });
      };

      const goTo = (i: number) => {
        current = Math.max(0, Math.min(i, steps.length - 1));
        update();
        const el = steps[current];
        el.classList.add('visible');
        el.querySelectorAll('.rise, .rise-stagger').forEach((r) => r.classList.add('visible'));
        navigating = true;
        clearTimeout(navTimer);
        navTimer = window.setTimeout(() => { navigating = false; }, 700);
        el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      };

      document.addEventListener('keydown', (e) => {
        const tgt = e.target as HTMLElement | null;
        if (tgt && tgt.closest && tgt.closest('input,textarea,select,[contenteditable]')) return;
        // Space is a step key here AND the browser's activation key for a
        // button, and the step engine was winning: with a question button
        // focused, Space scrolled to the next act and the button never fired.
        // That made the three questions on the live act, the most interactive
        // thing on the page, unusable by keyboard. Verified by dispatching a
        // real keypress on a focused .probe-ask: no prompt event, act advanced.
        // Links are deliberately NOT in this list: Space does not activate an
        // anchor, so exempting them would only trade the act step for a plain
        // browser scroll.
        if (e.key === ' ' && tgt && tgt.closest && tgt.closest('button,summary,[role="button"]')) return;
        if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].indexOf(e.key) > -1) { e.preventDefault(); goTo(current + 1); fadeHint(); }
        else if (['ArrowUp', 'ArrowLeft', 'PageUp'].indexOf(e.key) > -1) { e.preventDefault(); goTo(current - 1); fadeHint(); }
        else if (e.key === 'Home') { e.preventDefault(); goTo(0); fadeHint(); }
        else if (e.key === 'End') { e.preventDefault(); goTo(steps.length - 1); fadeHint(); }
      });

      let raf = 0;
      window.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          revealInView();
          if (!navigating) syncFromScroll();
        });
      }, { passive: true });

      revealInView();
      syncFromScroll();
    })();
  </script>
  </div>
</BaseLayout>
