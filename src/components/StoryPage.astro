  <style>
    /* A presentation must fit its viewport, and Michael's brief was density, not
       brevity. Cutting text to fit a 1280x800 laptop would have traded away the
       point. Instead the root font size follows viewport height, so every rem in
       the page (type, spacing, the nav) scales together and dense acts shrink
       rather than overflow. Capped at 16px so a large screen never inflates.
       Scoped with :has() so only the presentation is affected. */
    :global(html:has(.story-page)) {
      font-size: clamp(12px, 1.6vh, 16px);
    }

    .story-page {
      color: var(--text);
      --story-nav-height: 4.25rem;
      --story-step-pad-x: clamp(1.25rem, 4vw, 3rem);
      --story-step-pad-y: clamp(2.25rem, 5.4vh, 5rem);
      overflow-x: clip;
    }

    :global(html),
    :global(body) {
      overflow-x: hidden;
    }

    .story-page :is(h1, h2, h3, h4, p, span, a, li) {
      text-wrap: pretty;
    }

    .story-nav {
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      border-bottom: 1px solid var(--line);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      box-shadow: 0 16px 34px -30px rgba(15,23,42,0.30);
    }

    /* Full-viewport steps, selected by data-act rather than by the two language
       variants of every aria-label. A new act keeps its height automatically. */
    .story-page [data-act] {
      min-height: calc(100svh - var(--story-nav-height));
      min-height: calc(100dvh - var(--story-nav-height));
      display: flex;
      align-items: center;
      padding-block: var(--story-step-pad-y);
      padding-inline: var(--story-step-pad-x);
      scroll-margin-top: var(--story-nav-height);
    }

    .story-page .act {
      min-height: 100svh;
      min-height: 100dvh;
    }

    .story-page [data-act="frame"] > div,
    .story-page [data-act="decision"] > div {
      width: 100%;
    }

    .story-page .portrait-img {
      aspect-ratio: 3 / 4;
      object-fit: cover;
      object-position: center top;
      filter: contrast(1.05);
      mix-blend-mode: luminosity;
    }

    .story-key-hint {
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 9999px;
      padding: 0.28rem 0.55rem;
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 7%, var(--surface));
      font-size: 0.72rem;
      font-weight: 500;
      letter-spacing: 0.08em;
    }

    .story-display,
    .story-heading,
    .story-number,
    .story-project-title {
      font-family: var(--font-display);
      letter-spacing: -0.035em;
    }

    .story-display,
    .story-number {
      font-weight: 300;
    }

    .story-heading,
    .story-project-title {
      font-weight: 400;
    }

    /* Inherited from the retired numbers act. It used to hold "20+". It now holds
       a struck config claim against the command that actually checks it. */
    .story-number {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: clamp(1.5rem, 4.4vw, 3.1rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      font-weight: 400;
    }

    .story-quote {
      font-family: var(--font-body);
      font-style: normal;
      font-weight: 400;
    }

    .story-separator {
      border-color: var(--line);
    }

    .act-label {
      font-size: 10px;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--accent);
      opacity: 0.75;
      margin-bottom: 0.6rem;
    }

    /* The proof anchor that replaced the giant metric. Never a counter: an open
       standard, a licence or release, a callable address, or a named procedure. */
    .proof-headline {
      display: block;
      font-family: var(--font-display);
      font-weight: 300;
      letter-spacing: -0.03em;
      font-size: clamp(1.5rem, 3.4vw, 2.3rem);
      line-height: 1.1;
      color: var(--accent);
    }

    .proof-token {
      display: inline-block;
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
      font-size: 0.78rem;
      line-height: 1.45;
      color: var(--accent);
      word-break: break-word;
    }

    .proof-dot {
      display: inline-block;
      width: 0.5em;
      height: 0.5em;
      border-radius: 9999px;
      margin-right: 0.45em;
      vertical-align: baseline;
      border: 1px solid var(--accent);
    }
    .proof-dot[data-state="public"] { background: var(--accent); }
    .proof-dot[data-state="closed"] { background: transparent; }

    .option-row {
      display: flex;
      gap: 0.6rem;
      font-size: 0.85rem;
      line-height: 1.55;
      color: var(--text-secondary);
    }
    .option-mark { flex: none; width: 0.9rem; }
    .option-out { opacity: 0.45; }
    .option-in {
      opacity: 1;
      border-left: 2px solid var(--accent);
      margin-left: -0.75rem;
      padding-left: 0.75rem;
      padding-block: 0.15rem;
    }
    .option-in .option-mark { color: var(--accent); }

    .gate-origin { color: var(--text-secondary); opacity: 0.7; }
    .gate-origin::before {
      content: '→';
      color: var(--accent);
      margin-right: 0.45em;
    }

    .corr-row {
      display: grid;
      grid-template-columns: 9.5rem 1fr;
      column-gap: 0.75rem;
      align-items: baseline;
    }

    .corr-label {
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      opacity: 0.75;
    }

    .probe-card {
      border: 1px solid var(--line);
      border-radius: 0.9rem;
      padding: 1.1rem 1.2rem;
      background: color-mix(in srgb, var(--surface) 70%, transparent);
    }
    .probe-ask {
      cursor: pointer;
      min-height: 44px;
      display: flex;
      align-items: center;
    }
    .probe-q {
      font-size: 0.92rem;
      line-height: 1.4;
      color: var(--accent);
      border-bottom: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
      padding-bottom: 0.1rem;
    }
    .probe-ask:hover .probe-q { border-bottom-color: var(--accent); }

    .story-page .exp-compact {
      border-bottom-color: var(--line);
    }

    .story-page section[aria-label="Kontakt"],
    .story-page section[aria-label="Contact"] {
      background:
        radial-gradient(circle at 50% 16%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 28rem),
        var(--bg);
    }

    .story-page #story-step-counter,
    .story-page #story-keyboard-hint {
      font-family: var(--font-body);
    }

    .story-page #story-step-counter {
      border: 1px solid var(--line);
      border-radius: 9999px;
      padding: 0.42rem 0.62rem;
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      box-shadow: 0 14px 32px -26px rgba(15,23,42,0.36);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      font-variant-numeric: tabular-nums;
    }

    .story-page #story-keyboard-hint {
      border: 1px solid var(--line);
      border-radius: 9999px;
      padding: 0.42rem 0.7rem;
      background: color-mix(in srgb, var(--surface) 86%, transparent);
      color: var(--text-secondary);
      box-shadow: 0 14px 32px -26px rgba(15,23,42,0.36);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      font-size: 0.66rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    @media (max-width: 640px) {
      .story-page {
        --story-step-pad-x: 1.25rem;
        --story-step-pad-y: clamp(3rem, 6vh, 4rem);
      }

      .story-page [data-act] {
        align-items: flex-start;
      }

      .corr-row { grid-template-columns: 1fr; row-gap: 0.15rem; }

      .story-page #story-step-counter {
        bottom: 1rem;
        left: 1rem;
      }

      .story-page #story-keyboard-hint,
      :global(#agent-widget-label) {
        display: none !important;
      }
    }
  </style>

  <script>
    // Floating nav
    const navPdf = document.getElementById('nav-pdf');
    const navRight = document.getElementById('nav-right');
    const progressBar = document.getElementById('scroll-progress');

    window.addEventListener('scroll', () => {
      const y = window.scrollY;
      const show = y > 300;
      [navPdf, navRight].forEach(el => {
        if (show) { el?.classList.remove('opacity-0'); el?.classList.add('opacity-100'); }
        else { el?.classList.add('opacity-0'); el?.classList.remove('opacity-100'); }
      });
      // .story-back is the always-visible escape hatch → keep it tabbable regardless.
      document.querySelectorAll('#floating-nav a:not(.story-back), #floating-nav button').forEach(a => {
        (a as HTMLElement).tabIndex = show ? 0 : -1;
      });
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (progressBar && max > 0) {
        progressBar.style.width = `${(y / max) * 100}%`;
      }
    });
  </script>

  <!-- Act 04: hand the question to the existing chat widget instead of shipping
       a second client. `bridge-agent:prompt` is AgentWidget's own entry point. -->
  <!-- Liveness probe for act 04. The act claims the agent answers; the page has
       to be able to say so truthfully at the moment of reading, or say the
       opposite. Progressive enhancement: on a blocked request neither line shows,
       which is better than asserting either state. -->
  <script>
    (async () => {
      const live = document.getElementById('probe-live');
      const down = document.getElementById('probe-down');
      if (!live || !down) return;
      try {
        const res = await fetch(live.dataset.card!, { signal: AbortSignal.timeout(6000) });
        if (!res.ok) throw new Error(String(res.status));
        const card = await res.json();
        const v = card?.supportedInterfaces?.[0]?.protocolVersion || card?.protocolVersion || '';
        const n = Array.isArray(card?.skills) ? card.skills.length : 0;
        if (!v || !n) throw new Error('incomplete card');
        live.textContent = (live.dataset.tpl || '').replace('{v}', v).replace('{n}', String(n));
        live.classList.remove('hidden');
      } catch {
        down.classList.remove('hidden');
      }
    })();
  </script>

  <script>
    document.querySelectorAll<HTMLElement>('.probe-ask').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.prompt || '';
        window.dispatchEvent(new CustomEvent('bridge-agent:prompt', { detail: { text } }));
      });
    });
  </script>

  <!-- Presentation navigation: step act-to-act with arrow keys (Story page only) -->
  <script>
    (function () {
      // Each top-level <section> is a step; the decisions act has multiple direct
      // <div> children (one per decision) → each becomes its own step.
      const steps: Element[] = [];
      document.querySelectorAll('.story-page section').forEach((sec) => {
        const divs = Array.from(sec.children).filter((c) => c.tagName === 'DIV');
        if (divs.length > 1) divs.forEach((d) => steps.push(d));
        else steps.push(sec);
      });
      if (steps.length < 2) return;

      // A presentation always opens on the first act — don't restore a mid-scroll position.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      window.scrollTo(0, 0);

      let current = 0;
      let navigating = false;   // true while a programmatic (key-driven) scroll is in flight
      let navTimer = 0;
      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const counter = document.createElement('div');
      counter.className = 'no-print';
      counter.id = 'story-step-counter';
      counter.setAttribute('aria-hidden', 'true');
      counter.style.cssText = 'position:fixed;bottom:1.5rem;left:1.75rem;z-index:60;pointer-events:none';
      document.body.appendChild(counter);

      const hint = document.createElement('div');
      hint.className = 'no-print';
      hint.id = 'story-keyboard-hint';
      hint.setAttribute('aria-hidden', 'true');
      // Label follows <html lang>; the German string used to render on /en/story/ too.
      const navLabel = document.documentElement.lang === 'en' ? 'Navigate' : 'Navigieren';
      hint.innerHTML = '<span style="font-size:13px;letter-spacing:.05em">← →</span><span>' + navLabel + '</span>';
      hint.style.cssText = 'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);z-index:60;display:flex;align-items:center;gap:.7rem;opacity:.78;transition:opacity .8s ease;pointer-events:none';
      document.body.appendChild(hint);
      let hintTimer = window.setTimeout(() => { hint.style.opacity = '0'; }, 4500);

      const pad = (n: number) => String(n).padStart(2, '0');
      const update = () => {
        counter.innerHTML = '<span style="color:var(--accent)">' + pad(current + 1) + '</span>'
          + '<span style="color:var(--text-secondary);opacity:.55"> / ' + pad(steps.length) + '</span>';
      };
      const fadeHint = () => { clearTimeout(hintTimer); hint.style.opacity = '0'; };

      // Keep `current` in sync when the user scrolls manually (rAF-throttled).
      const syncFromScroll = () => {
        const mark = window.innerHeight * 0.33;
        let idx = 0;
        for (let i = 0; i < steps.length; i++) {
          if (steps[i].getBoundingClientRect().top <= mark) idx = i;
        }
        current = idx; update();
      };

      const revealInView = () => {
        const vh = window.innerHeight;
        document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
          if (el.getBoundingClientRect().top < vh * 0.85) el.classList.add('visible');
        });
      };

      // Synchronous index → fast repeated key presses step reliably (no observer lag).
      const goTo = (i: number) => {
        current = Math.max(0, Math.min(i, steps.length - 1));
        update();
        const el = steps[current];
        el.classList.add('visible');
        el.querySelectorAll('.reveal').forEach((r) => r.classList.add('visible'));
        navigating = true;
        clearTimeout(navTimer);
        navTimer = window.setTimeout(() => { navigating = false; }, 700);
        el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      };

      document.addEventListener('keydown', (e) => {
        const tgt = e.target as HTMLElement | null;
        if (tgt && tgt.closest && tgt.closest('input,textarea,select,[contenteditable]')) return;
        if (['ArrowDown', 'ArrowRight', 'PageDown', ' '].indexOf(e.key) > -1) { e.preventDefault(); goTo(current + 1); fadeHint(); }
        else if (['ArrowUp', 'ArrowLeft', 'PageUp'].indexOf(e.key) > -1) { e.preventDefault(); goTo(current - 1); fadeHint(); }
        else if (e.key === 'Home') { e.preventDefault(); goTo(0); fadeHint(); }
        else if (e.key === 'End') { e.preventDefault(); goTo(steps.length - 1); fadeHint(); }
      });

      let raf = 0;
      window.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          revealInView();
          if (!navigating) syncFromScroll();
        });
      }, { passive: true });

      revealInView();
      syncFromScroll();
    })();
  </script>
  </div>
</BaseLayout>
