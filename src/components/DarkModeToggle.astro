---
import { i18n } from '../lib/i18n';

interface Props {
  /** The page's language. Optional on purpose: three pages mount this button,
   *  and only the CV page is in scope here. A required prop would have broken
   *  the other two at build time. When it is missing, the server renders the
   *  German label and the script corrects it from <html lang> on load. */
  lang?: 'de' | 'en';
}

const { lang } = Astro.props;
const t = i18n[lang ?? 'de'];
// Both bundles travel with the button, so the script can label it by the
// document's own language even where the prop was not passed.
const labels = {
  de: { toLight: i18n.de.darkModeToLight, toDark: i18n.de.darkModeToDark },
  en: { toLight: i18n.en.darkModeToLight, toDark: i18n.en.darkModeToDark },
};
---

{/* Both icons are rendered and CSS picks the one that fits the current theme:
    the inline script in BaseLayout sets html.dark before the body paints, so the
    right symbol is on screen without any script of ours running at all. Before
    this the button shipped both icons `hidden` and measured 18x18px empty until
    the module script arrived. The aria-label is the one thing CSS cannot switch,
    so it is server-rendered for the light state and corrected on load. */}
<button
  id="dark-mode-toggle"
  type="button"
  aria-label={t.darkModeToDark}
  data-labels={JSON.stringify(labels)}
  class="theme-toggle p-2 rounded-lg transition-colors duration-200 cursor-pointer"
>
  <svg id="icon-sun" class="icon-sun w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <svg id="icon-moon" class="icon-moon w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script>
  const toggle = document.getElementById('dark-mode-toggle');

  type ToggleLabels = { toLight: string; toDark: string };
  const FALLBACK: ToggleLabels = { toLight: 'Zur hellen Ansicht wechseln', toDark: 'Zur dunklen Ansicht wechseln' };

  function labels(): ToggleLabels {
    const lang = (document.documentElement.lang || 'de').toLowerCase().startsWith('en') ? 'en' : 'de';
    try {
      const all = JSON.parse(toggle?.getAttribute('data-labels') || '{}');
      return all[lang] || FALLBACK;
    } catch {
      return FALLBACK;
    }
  }

  function updateLabel() {
    if (!toggle) return;
    const isDark = document.documentElement.classList.contains('dark');
    const l = labels();
    toggle.setAttribute('aria-label', isDark ? l.toLight : l.toDark);
  }

  toggle?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateLabel();
  });

  // Follow the OS setting live — until the user makes an explicit choice
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    if (localStorage.getItem('theme')) return;
    document.documentElement.classList.toggle('dark', e.matches);
    updateLabel();
  });

  updateLabel();
</script>

<style>
  .theme-toggle {
    color: var(--text-secondary);
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
  }

  .theme-toggle:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--accent) 8%, var(--surface));
    border-color: color-mix(in srgb, var(--accent) 26%, var(--line));
  }

  /* The button offers the OTHER state: a moon in light mode, a sun in dark. */
  :global(html:not(.dark)) .icon-sun { display: none; }
  :global(html.dark) .icon-moon { display: none; }
</style>
