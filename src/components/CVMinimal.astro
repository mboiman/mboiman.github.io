---
/**
 * The second view of the CV: typographic, two columns, everything folded.
 *
 * Built next to CVPage rather than as a theme of it, because the two differ in
 * structure, not in colour: a sticky introduction on the left, and on the right
 * one row per section, its name and one sentence beside a list that opens entry
 * by entry. The model is the product page of Jev by Typesafe, which Michael
 * picked on 2026-09-25 to try against the classic page before choosing.
 *
 * Every fact comes from the same places as on the classic page, config.cv.toml
 * and src/lib/i18n.ts, with the same sort rule from src/lib/experience.ts. This
 * file adds chrome only (the `minimal` block in i18n.ts), so a correction in
 * the TOML reaches both views without anyone touching this file.
 *
 * The entries carry the same `data-cv-anchor` values as the classic page, so
 * the agent can still point at a station: its highlight opens the enclosing
 * <details> before it scrolls (see reveal() in AgentWidget.astro).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { getCVData } from '../lib/toml-loader';
import { formatBlocks } from '../lib/markdown';
import { i18n } from '../lib/i18n';
import { groupedSkills } from '../lib/skill-groups';
import { isTalk, sortByRecency } from '../lib/experience';
import { splitDetails } from '../lib/station-details';
import portrait from '../assets/portraits/profile_.jpg';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const t = i18n[lang];
const m = t.minimal;

const data = getCVData(lang);
const { profile, contact, ui, experiences, projects, education, language: langs, agent_proof: agentProof } = data;

const jobs = sortByRecency(experiences.list.filter(e => !isTalk(e)));
const talks = sortByRecency(experiences.list.filter(isTalk));
const allProjects = [...projects.list.filter(p => p.featured), ...projects.list.filter(p => !p.featured)];
const skillGroups = groupedSkills(ui.sidebar_skills, lang);
const email = contact.list.find(c => c.url?.startsWith('mailto:'));

/** Contacts print as the address itself: a label like "Persönliches GitHub"
 *  says nothing in a list that has no icons. Same rule as the PDF header. */
const contactText = (item: { url?: string; title: string }) => {
  const url = item.url || '';
  if (url.startsWith('mailto:')) return url.slice(7);
  if (url.startsWith('tel:')) return item.title;
  if (/^https?:\/\//.test(url)) return url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
  return item.title;
};

/** Same split as the classic page: lead and three highlights open, the rest
 *  (further focus blocks, the tool list) behind one "more" line, labelled with
 *  the headings it actually holds. */
const station = (details: string) => {
  const d = splitDetails(details || '', t.truncatePatterns, t.truncateToolPatterns);
  const more = [d.fold, d.tools ? `**${d.tools.title}**\n${d.tools.body}` : ''].filter(Boolean).join('\n\n');
  const moreTitle = [d.foldTitle, d.tools?.title].filter(Boolean).join(' · ');
  return { open: formatBlocks(d.open), more: formatBlocks(more), moreTitle };
};

/** careerDetails carries inline accent styles meant for the classic page. */
const plain = (html: string) => html.replace(/\sstyle="[^"]*"/g, '');
---

<BaseLayout title={m.seoTitle} description={ui.seo_description || ui.tagline} lang={lang} noindex view="minimal">
  <div class="mn">
    <aside class="mn-intro" aria-label={t.sidebarLabel}>
      <div class="mn-top no-print">
        <Image src={portrait} alt={profile.name} widths={[64, 128]} sizes="4rem" class="mn-portrait" loading="eager" />
        <nav class="mn-controls" aria-label={t.navLanguage}>
          <span class="mn-switch" role="group" aria-label={m.switchLabel}>
            <a href={`/${lang}/`} class="mn-switch-link" data-view-choice="classic">{m.toClassic}</a>
            <a href={`/${lang}/minimal/`} class="mn-switch-link is-active" aria-current="page" data-view-choice="minimal">{m.toMinimal}</a>
          </span>
          <a href="/de/minimal/" hreflang="de" class:list={['mn-lang', lang === 'de' && 'is-active']} aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
          <a href="/en/minimal/" hreflang="en" class:list={['mn-lang', lang === 'en' && 'is-active']} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
          <DarkModeToggle lang={lang} />
        </nav>
      </div>

      <p class="mn-eyebrow">{m.eyebrow}</p>
      <h1 class="mn-name">{profile.name}</h1>
      <p class="mn-tagline">{ui.tagline}</p>

      <div class="mn-prose">
        <p>{t.careerIntro}</p>
        {t.careerDetails.map(detail => <p set:html={plain(detail)} />)}
      </div>

      <dl class="mn-facts">
        {t.facts.map(fact => (
          <div class="mn-fact">
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))}
      </dl>

      <ul class="mn-contacts">
        {contact.list.slice(0, 6).map(item => (
          <li>
            <a href={item.url || '#'} target={item.url?.startsWith('mailto:') || item.url?.startsWith('tel:') ? '_self' : '_blank'} rel="noopener">{contactText(item)}</a>
          </li>
        ))}
      </ul>

      <button
        type="button"
        class="mn-ask no-print"
        data-agent-open
        aria-label={agentProof.ask}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="agent-widget-panel"
      >
        {agentProof.ask}
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </button>
    </aside>

    <main id="main" class="mn-main">
      {/* Filled by the script below when the link names entries (?focus=),
          so a plain visit renders nothing here. */}
      <div class="mn-focus" hidden data-for={m.focusFor} data-plain={m.focusPlain} data-tag={m.focusTag}>
        <p class="mn-focus-text"></p>
        <a class="mn-focus-reset" href={`/${lang}/minimal/`}>{m.focusReset}</a>
      </div>
      {/* Verifiable first, as on the classic page: what a reader can open
          outranks what they have to believe. */}
      <section class="mn-section">
        <div class="mn-head">
          <h2>{m.running.title}</h2>
          <p>{m.running.text}</p>
        </div>
        <div class="mn-list">
          {t.running.map((item, i) => (
            <details class="mn-item" open={i === 0}>
              <summary>
                <span class="mn-item-title">{item.title}</span>
                <span class="mn-plus" aria-hidden="true"></span>
              </summary>
              <div class="mn-body">
                {item.mechanism && <p>{item.mechanism}</p>}
                <p class="mn-proof">
                  {item.proofUrl ? <a href={item.proofUrl} target="_blank" rel="noopener">{item.proof}</a> : item.proof}
                </p>
                {item.stateNote && <p class="mn-note">{item.stateNote}</p>}
              </div>
            </details>
          ))}
        </div>
      </section>

      {experiences.enable && (
        <section class="mn-section" data-cv-anchor="experience" data-cv-group={experiences.title}>
          <div class="mn-head">
            <h2>{m.experience.title}</h2>
            <p>{m.experience.text}</p>
          </div>
          <div class="mn-list">
            {jobs.map(exp => (
              <details class="mn-item" id={exp.anchor ? `exp-${exp.anchor}` : undefined} data-cv-anchor={exp.anchor}>
                <summary>
                  <span class="mn-item-title">
                    <h3>{exp.position}</h3>
                    <span class="mn-meta">{exp.company} · {exp.dates}</span>
                  </span>
                  <span class="mn-plus" aria-hidden="true"></span>
                </summary>
                {(() => {
                  const st = station(exp.details);
                  const anchorOf = exp.anchor;
                  return (
                    <div class="mn-body">
                      <Fragment set:html={st.open} />
                      {st.more && (
                        <details class="mn-more">
                          <summary>{st.moreTitle || m.more}</summary>
                          <Fragment set:html={st.more} />
                        </details>
                      )}
                      {anchorOf && <p class="mn-permalink no-print"><a href={`#exp-${anchorOf}`}>{m.permalink}</a></p>}
                    </div>
                  );
                })()}
              </details>
            ))}
          </div>
        </section>
      )}

      {projects.enable && (
        <section class="mn-section" data-cv-anchor="projects" data-cv-group={projects.title}>
          <div class="mn-head">
            <h2>{m.projects.title}</h2>
            <p>{m.projects.text}</p>
          </div>
          <div class="mn-list">
            {allProjects.map(project => (
              <details class="mn-item" id={project.anchor ? `project-${project.anchor}` : undefined} data-cv-anchor={project.anchor}>
                <summary>
                  <span class="mn-item-title">
                    <h3>{project.title}</h3>
                    <span class="mn-meta">{project.category}</span>
                  </span>
                  <span class="mn-plus" aria-hidden="true"></span>
                </summary>
                <div class="mn-body">
                  <Fragment set:html={formatBlocks(project.tagline)} />
                  {project.tech_stack?.length > 0 && <p class="mn-note">{project.tech_stack.join(' · ')}</p>}
                  {project.anchor && <p class="mn-permalink no-print"><a href={`#project-${project.anchor}`}>{m.permalink}</a></p>}
                  {project.url && <p class="mn-proof"><a href={project.url} target="_blank" rel="noopener">{m.proofOpen}: {project.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></p>}
                </div>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="mn-section">
        <div class="mn-head">
          <h2>{m.skills.title}</h2>
          <p>{m.skills.text}</p>
        </div>
        <div class="mn-list">
          {skillGroups.map(group => (
            <details class="mn-item">
              <summary>
                <span class="mn-item-title">{group.title}</span>
                <span class="mn-plus" aria-hidden="true"></span>
              </summary>
              <div class="mn-body"><p>{group.items.join(' · ')}</p></div>
            </details>
          ))}
        </div>
      </section>

      {talks.length > 0 && (
        <section class="mn-section" data-cv-anchor="talks" data-cv-group={t.talksTitle}>
          <div class="mn-head">
            <h2>{m.talks.title}</h2>
            <p>{m.talks.text}</p>
          </div>
          <div class="mn-list">
            {talks.map(talk => (
              <details class="mn-item" id={talk.anchor ? `exp-${talk.anchor}` : undefined} data-cv-anchor={talk.anchor}>
                <summary>
                  <span class="mn-item-title">
                    <h3>{talk.position}</h3>
                    <span class="mn-meta">{talk.company} · {talk.dates}</span>
                  </span>
                  <span class="mn-plus" aria-hidden="true"></span>
                </summary>
                {(() => {
                  const st = station(talk.details ?? '');
                  const anchorOf = talk.anchor;
                  return (
                    <div class="mn-body">
                      <Fragment set:html={st.open} />
                      {st.more && (
                        <details class="mn-more">
                          <summary>{st.moreTitle || m.more}</summary>
                          <Fragment set:html={st.more} />
                        </details>
                      )}
                      {anchorOf && <p class="mn-permalink no-print"><a href={`#exp-${anchorOf}`}>{m.permalink}</a></p>}
                    </div>
                  );
                })()}
              </details>
            ))}
          </div>
        </section>
      )}

      {(education.enable || langs.enable) && (
        <section class="mn-section">
          <div class="mn-head">
            <h2>{m.background.title}</h2>
            <p>{m.background.text}</p>
          </div>
          <div class="mn-list">
            {education.enable && education.list.map(edu => (
              <div class="mn-row">
                <h3>{edu.degree}</h3>
                <span class="mn-meta">{[edu.college, edu.dates].filter(Boolean).join(' · ')}</span>
              </div>
            ))}
            {langs.enable && (
              <div class="mn-row">
                <h3>{langs.title}</h3>
                <span class="mn-meta">{langs.list.map(l => `${l.language} (${l.level})`).join(' · ')}</span>
              </div>
            )}
          </div>
        </section>
      )}

      <div class="mn-cta">
        <p class="mn-cta-title">{m.ctaTitle}</p>
        <div class="mn-cta-actions">
          <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}_Minimal.pdf`} download class="mn-cta-secondary">{t.pdfDownload}</a>
          {email && (
            <a href={email.url} class="mn-cta-primary">
              {m.ctaButton}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </a>
          )}
        </div>
      </div>

      <footer class="mn-footer">
        <span>&copy; {new Date().getFullYear()} {profile.name}</span>
        <a href={`/${lang}/impressum/`}>{t.legalImpressum}</a>
        <a href={`/${lang}/datenschutz/`}>{t.legalPrivacy}</a>
      </footer>
    </main>
  </div>

  <script>
    /* ── A link made for one application ────────────────────────────────
       ?for=DB%20InfraGO&focus=db-vertrieb,tuev-sued,e-invoicing-platform
       moves the named entries to the top of their list, in the order given,
       opens them, and says so in a line above the sections. Built entirely
       in the browser from the URL: nothing about an application is ever
       written into this public repository. /job-application builds the link
       from the anchors in config.cv.toml.

       Anchors are checked against the pattern the agent uses too, and only
       entries that exist move; an unknown anchor is ignored, not an error. */
    const ANCHOR = /^[a-z0-9-]+$/;
    const params = new URLSearchParams(location.search);
    const focus = (params.get('focus') || '')
      .split(',').map(a => a.trim()).filter(a => ANCHOR.test(a)).slice(0, 20);
    const banner = document.querySelector<HTMLElement>('.mn-focus');
    const hits = focus
      .map(a => document.querySelector<HTMLDetailsElement>(`.mn-list > details[data-cv-anchor="${a}"]`))
      .filter((el): el is HTMLDetailsElement => el !== null);

    if (hits.length && banner) {
      // Reverse, so prepending leaves them in the order the link gave.
      [...hits].reverse().forEach(el => {
        el.open = true;
        el.classList.add('is-focus');
        const tag = document.createElement('span');
        tag.className = 'mn-focus-tag';
        tag.textContent = banner.dataset.tag || '';
        el.querySelector('.mn-item-title')?.prepend(tag);
        el.parentElement?.prepend(el);
      });
      const name = (params.get('for') || '').trim().slice(0, 80);
      const text = name ? (banner.dataset.for || '').replace('{for}', name) : (banner.dataset.plain || '');
      const p = banner.querySelector('.mn-focus-text');
      if (p) p.textContent = text;
      banner.hidden = false;
    }

    /* ── Links to one entry ─────────────────────────────────────────────
       #exp-dvag or #project-agent-mesh-gateway opens that entry and brings
       it into view. A closed <details> has no height, so the browser's own
       jump lands on the summary at best; opening first makes it land. */
    const openFromHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return;
      const el = document.getElementById(id);
      if (!(el instanceof HTMLDetailsElement)) return;
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);

    /* ── Print ──────────────────────────────────────────────────────────
       A closed <details> prints as its summary alone, so a printout lost
       every station. Everything opens for the print and goes back after. */
    let closed: HTMLDetailsElement[] = [];
    window.addEventListener('beforeprint', () => {
      closed = [...document.querySelectorAll<HTMLDetailsElement>('.mn details:not([open])')];
      closed.forEach(d => { d.open = true; });
    });
    window.addEventListener('afterprint', () => {
      closed.forEach(d => { d.open = false; });
      closed = [];
    });
  </script>
</BaseLayout>

<style>
  /* Own tokens, prefixed, because this view deliberately drops the blue of the
     classic page: grey ink on white, hairlines, one black button. Dark mode
     reads the same `html.dark` class the layout resolves before paint. */
  :global(:root) {
    --mn-bg: #ffffff;
    --mn-ink: #2f3133;
    --mn-text: #45484c;
    --mn-muted: #6a6e73;
    --mn-line: #e4e5e7;
    --mn-btn: #161718;
    --mn-btn-text: #ffffff;
  }
  :global(html.dark) {
    --mn-bg: #121314;
    --mn-ink: #ececec;
    --mn-text: #cdd0d4;
    --mn-muted: #9a9ea4;
    --mn-line: #2a2c2f;
    --mn-btn: #f1f1f1;
    --mn-btn-text: #121314;
  }
  :global(body) { background: var(--mn-bg); }

  .mn {
    min-height: 100vh;
    background: var(--mn-bg);
    color: var(--mn-text);
    font-family: var(--font-body);
  }

  /* ── Left: the introduction ─────────────────────────────────────────── */
  .mn-intro { padding: 1.5rem 1.25rem 2.5rem; border-bottom: 1px solid var(--mn-line); }

  .mn-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 2.5rem; }
  .mn-portrait { width: 4rem; height: 4rem; border-radius: 9999px; object-fit: cover; filter: grayscale(100%); }

  .mn-controls { display: flex; align-items: center; gap: 0.75rem; font-size: var(--fs-13); flex-wrap: wrap; justify-content: flex-end; }
  .mn-switch { display: inline-flex; border: 1px solid var(--mn-line); border-radius: var(--r-xs); overflow: hidden; }
  .mn-switch-link { padding: 0.3rem 0.65rem; color: var(--mn-muted); text-decoration: none; }
  .mn-switch-link:hover { color: var(--mn-ink); }
  .mn-switch-link.is-active { background: var(--mn-btn); color: var(--mn-btn-text); }
  .mn-lang { color: var(--mn-muted); text-decoration: none; }
  .mn-lang.is-active { color: var(--mn-ink); font-weight: 600; }

  .mn-eyebrow {
    font-size: var(--fs-12);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mn-muted);
  }
  .mn-name {
    margin-top: 0.75rem;
    font-size: clamp(3rem, 5.6vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 0.98;
    color: var(--mn-ink);
  }
  .mn-tagline {
    margin-top: 1rem;
    font-size: clamp(1.5rem, 2.3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.12;
    color: var(--mn-ink);
  }
  .mn-prose { margin-top: 2rem; font-size: var(--fs-16); line-height: 1.6; }
  .mn-prose p + p { margin-top: 1rem; }
  .mn-prose :global(strong) { font-weight: 500; color: var(--mn-ink); }

  .mn-facts { margin-top: 2rem; display: grid; gap: 0.35rem; font-size: var(--fs-14); }
  .mn-fact { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; }
  .mn-fact dt { color: var(--mn-muted); }
  .mn-fact dd { color: var(--mn-ink); }

  .mn-contacts { margin-top: 1.75rem; list-style: none; padding: 0; display: grid; gap: 0.2rem; font-size: var(--fs-14); }
  .mn-contacts a { color: var(--mn-text); text-decoration: none; border-bottom: 1px solid var(--mn-line); }
  .mn-contacts a:hover { color: var(--mn-ink); border-color: var(--mn-ink); }

  .mn-ask {
    margin-top: 2rem;
    display: inline-flex; align-items: center; gap: 0.5rem;
    font: inherit; font-size: var(--fs-15);
    color: var(--mn-ink);
    background: none; border: 0; padding: 0; cursor: pointer;
    border-bottom: 1px solid var(--mn-ink);
  }
  .mn-ask svg, .mn-cta-primary svg { width: 1.1em; height: 1.1em; }

  /* ── Right: one row per section ─────────────────────────────────────── */
  .mn-main { padding: 0 1.25rem; }

  .mn-section { display: grid; gap: 1.25rem; padding: 2.5rem 0; }
  .mn-head h2 {
    font-size: clamp(2rem, 3.1vw, 2.9rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--mn-ink);
  }
  .mn-head p { margin-top: 0.6rem; font-size: 1.2rem; line-height: 1.45; max-width: 24rem; }

  .mn-list { display: grid; }

  .mn-item summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    gap: 1.25rem;
    padding: 0.7rem 0;
  }
  .mn-item summary::-webkit-details-marker { display: none; }
  .mn-item summary:focus-visible { outline: 2px solid var(--mn-ink); outline-offset: 4px; }

  .mn-item-title, .mn-row h3 {
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--mn-ink);
  }
  .mn-item-title h3 { font: inherit; color: inherit; letter-spacing: inherit; }
  .mn-meta { display: block; margin-top: 0.15rem; font-size: var(--fs-14); font-weight: 400; letter-spacing: 0; color: var(--mn-muted); }

  /* The plus is two bars, drawn rather than typed, and turns into a cross
     when the entry is open. */
  .mn-plus { position: relative; width: 1.1rem; height: 1.1rem; margin-top: 0.4rem; color: var(--mn-ink); transition: transform 0.2s ease; }
  .mn-plus::before, .mn-plus::after { content: ""; position: absolute; background: currentColor; }
  .mn-plus::before { left: 0; right: 0; top: calc(50% - 1px); height: 2px; }
  .mn-plus::after { top: 0; bottom: 0; left: calc(50% - 1px); width: 2px; }
  .mn-item[open] .mn-plus { transform: rotate(45deg); }
  @media (prefers-reduced-motion: reduce) { .mn-plus { transition: none; } }

  .mn-body {
    margin: 0.35rem 0 1.4rem;
    padding-left: 0.9rem;
    border-left: 1px solid var(--mn-muted);
    font-size: var(--fs-15);
    line-height: 1.6;
    max-width: 44rem;
  }
  .mn-body :global(p + p), .mn-body :global(p + ul), .mn-body :global(ul + p) { margin-top: 0.6rem; }
  .mn-body :global(ul) { list-style: disc; padding-left: 1.1rem; }
  .mn-body :global(li + li) { margin-top: 0.2rem; }
  .mn-body :global(strong) { font-weight: 500; color: var(--mn-ink); }
  .mn-body :global(a), .mn-proof a { color: var(--mn-ink); text-decoration: underline; text-underline-offset: 3px; }
  .mn-note { font-size: var(--fs-13); color: var(--mn-muted); }
  .mn-proof { font-size: var(--fs-13); }

  .mn-more { margin-top: 0.6rem; }
  .mn-more summary { cursor: pointer; font-size: var(--fs-13); color: var(--mn-muted); text-decoration: underline; text-underline-offset: 3px; }
  .mn-more summary:hover { color: var(--mn-ink); }
