---
/**
 * The fourth view: a project against the CV.
 *
 * Michael asked for it on 2026-09-26 after the Jev lab on bks-lab.com: paste,
 * upload or pick an example posting, let Jev compare it with the CV, and show
 * the result as a net diagram and an overall score, animated. The judgement is
 * Jev's per line; the score is code (src/lib/match.ts) that the visitor can
 * re-weight without a new request, the split the lab page already makes.
 *
 * Examples replay a stored measurement (src/data/match/, scripts/jev-measure.mjs)
 * and send nothing. Own text goes to the jev-match worker, which holds the key;
 * the page probes it on load and says so when it is not there.
 *
 * The animation follows Michael's rule for this site: the picture stands and
 * fills. Rows light up as their answer arrives, a line draws to the evidence,
 * the net and the score grow. No camera, no caption that changes every second:
 * the status line says one thing while Jev works and one thing when done.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ViewSwitch from './ViewSwitch.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { getCVData } from '../lib/toml-loader';
import { i18n } from '../lib/i18n';
import { AXES, cvEntries, requirementRequest, DEFAULT_WEIGHTS, splitRequirements, scoreMatch } from '../lib/match';
import { DEMOS } from '../lib/match-demos';
import { MATCH_ENDPOINT } from '../lib/match-config';

interface Props { lang: 'de' | 'en' }
const { lang } = Astro.props;
const t = i18n[lang];
const m = t.match;
const data = getCVData(lang);
const { profile, contact, ui } = data;

const measurements = import.meta.glob('../data/match/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const demoRuns = Object.fromEntries(DEMOS.map(d => [d.id, measurements[`../data/match/demo-${d.id}.${lang}.json`]]));
const profileRun = measurements[`../data/match/profile.${lang}.json`];

const entries = cvEntries(data as any);
/* The preview picture (scripts/match-og.mjs) shows the first example; its alt
   text names the same score, computed from the same stored run. */
const ogRun = demoRuns[DEMOS[0].id];
const ogScore = ogRun ? scoreMatch(ogRun.requirements, ogRun.project.demand, profileRun?.depth ?? {}, DEFAULT_WEIGHTS).total : 0;
const entryInfo = Object.fromEntries(entries.map(e => [e.id, {
  label: e.label,
  kind: e.kind,
  href: e.kind === 'station' ? `/${lang}/#exp-${e.anchor}` : e.kind === 'project' ? `/${lang}/#project-${e.anchor}` : `/${lang}/`,
}]));

const fmtDate = (iso: string) => new Date(`${iso}T12:00:00Z`).toLocaleDateString(lang === 'de' ? 'de-DE' : 'en-GB', { day: 'numeric', month: lang === 'de' ? '2-digit' : 'short', year: 'numeric' });
const email = contact.list.find(c => c.url?.startsWith('mailto:'));

/* The example request of the method section: the real request for the first
   line of the first demo, with the CV and the options cut to three. */
const firstLine = splitRequirements(DEMOS[0].text[lang]).find(l => /playwright/i.test(l)) ?? splitRequirements(DEMOS[0].text[lang])[0];
const fullReq = requirementRequest(firstLine, entries);
const cut = <T,>(o: Record<string, T>, n: number) => ({ ...Object.fromEntries(Object.entries(o).slice(0, n)), '…': '…' });
const exampleReq = {
  model: fullReq.model,
  state: { requirement: fullReq.state.requirement, cv: cut(fullReq.state.cv as Record<string, string>, 2) },
  questions: {
    must: fullReq.questions.must,
    evidence: { ...fullReq.questions.evidence, criteria: { ...cut(fullReq.questions.evidence.criteria as Record<string, string>, 2), none: 'No entry of `cv` shows it' } },
    level: fullReq.questions.level,
    '…': '…',
  },
};
const exampleText = JSON.stringify(exampleReq, null, 2).replace(/: "(.{90})[^"]+"/g, ': "$1 …"');

/* Radar geometry: 8 spokes from the top, clockwise. */
const R = 104; const CX = 205; const CY = 142;
const spoke = (i: number, r: number) => {
  const a = -Math.PI / 2 + (i * 2 * Math.PI) / AXES.length;
  return [CX + r * Math.cos(a), CY + r * Math.sin(a)];
};
const ring = (f: number) => AXES.map((_, i) => spoke(i, R * f).map(v => v.toFixed(1)).join(',')).join(' ');
const center = AXES.map(() => `${CX},${CY}`).join(' ');

const pageData = {
  lang,
  endpoint: import.meta.env.PUBLIC_MATCH_ENDPOINT ?? MATCH_ENDPOINT,
  axes: AXES.map((a, i) => ({ key: a.key, label: a.label[lang], spoke: i })),
  radar: { cx: CX, cy: CY, r: R },
  entries: entryInfo,
  profile: profileRun?.depth ?? {},
  demos: demoRuns,
  weights: DEFAULT_WEIGHTS,
  price: 0.042,
  t: m,
  demoTitles: Object.fromEntries(DEMOS.map(d => [d.id, d.title[lang]])),
  cvPdf: `/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`,
  measuredLabel: Object.fromEntries(DEMOS.map(d => [d.id, fmtDate(demoRuns[d.id]?.measuredAt ?? '2026-09-26')])),
  mail: email?.url ?? '',
};
---

<BaseLayout title={m.seoTitle} description={m.seoDescription} lang={lang} noindex view="match" ogImage={`/images/og-match-${lang}.png`} ogImageAlt={m.ogAlt.replace('{score}', String(ogScore))}>
  <div class="mt" data-match-page>
    <header class="mt-top">
      <a class="mt-id" href={`/${lang}/`}>
        <span class="mt-name">{profile.name}</span>
        <span class="mt-role">{ui.tagline}</span>
      </a>
      <div class="mt-top-right">
        <ViewSwitch lang={lang} current="match" />
        <nav class="mt-lang" aria-label={t.navLanguage}>
          <a href="/de/match/" hreflang="de" class:list={[lang === 'de' && 'is-active']} aria-current={lang === 'de' ? 'true' : undefined}>DE</a>
          <a href="/en/match/" hreflang="en" class:list={[lang === 'en' && 'is-active']} aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        </nav>
        <DarkModeToggle lang={lang} />
      </div>
    </header>

    <main id="main" class="mt-main">
      <section class="mt-hero">
        <p class="mt-kicker">{m.kicker}</p>
        <h1 class="mt-h1">{m.title}</h1>
        <p class="mt-lead">{m.lead}</p>
      </section>

      {/* ── Input ─────────────────────────────────────────────────────────── */}
      <section class="mt-input" data-input>
        <div class="mt-tabs" role="tablist" aria-label={m.tabsLabel}>
          <button type="button" role="tab" id="mt-tab-demo" aria-controls="mt-panel-demo" aria-selected="true" data-tab="demo">{m.tabDemo}</button>
          <button type="button" role="tab" id="mt-tab-text" aria-controls="mt-panel-text" aria-selected="false" tabindex="-1" data-tab="text">{m.tabText}</button>
          <button type="button" role="tab" id="mt-tab-file" aria-controls="mt-panel-file" aria-selected="false" tabindex="-1" data-tab="file">{m.tabFile}</button>
        </div>

        <div class="mt-panel" role="tabpanel" id="mt-panel-demo" aria-labelledby="mt-tab-demo" data-panel="demo">
          <div class="mt-demos">
            {DEMOS.map((d, i) => (
              <label class="mt-demo">
                <input type="radio" name="demo" value={d.id} checked={i === 0} />
                <span class="mt-demo-title">{d.title[lang]}</span>
                <span class="mt-demo-teaser">{d.teaser[lang]}</span>
                <span class="mt-demo-date">{m.demoMeasured.replace('{date}', pageData.measuredLabel[d.id])}</span>
              </label>
            ))}
          </div>
          {DEMOS.map((d, i) => (
            <details class="mt-demo-text" data-demo-text={d.id} hidden={i !== 0}>
              <summary>{m.demoShow}</summary>
              <pre>{d.text[lang]}</pre>
            </details>
          ))}
        </div>

        <div class="mt-panel" role="tabpanel" id="mt-panel-text" aria-labelledby="mt-tab-text" data-panel="text" hidden>
          <label class="mt-label" for="mt-text">{m.textLabel}</label>
          <textarea id="mt-text" rows="11" maxlength="12000" placeholder={m.textPlaceholder} data-text></textarea>
          <p class="mt-small" data-count data-tpl={m.textCount}>{m.textCount.replace('{n}', '0').replace('{max}', '12000')}</p>
        </div>

        <div class="mt-panel" role="tabpanel" id="mt-panel-file" aria-labelledby="mt-tab-file" data-panel="file" hidden>
          <label class="mt-drop" data-drop>
            <input type="file" accept=".txt,.md,.pdf,.docx,text/plain,text/markdown,application/pdf" data-file />
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0l-4 4m4-4l4 4M5 16v3h14v-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span class="mt-drop-title">{m.fileDrop}</span>
            <span class="mt-small">{m.fileTypes}</span>
          </label>
        </div>

        <div class="mt-go">
          <button type="button" class="mt-btn" data-start>{m.start}</button>
          <p class="mt-note" data-note data-demo={m.noteDemo} data-live={m.noteLive}>{m.noteDemo}</p>
        </div>
        <p class="mt-error" role="alert" data-error hidden></p>
      </section>

      {/* ── The run ───────────────────────────────────────────────────────── */}
      <section class="mt-run" data-run hidden aria-labelledby="mt-run-title">
        <h2 class="sr-only" id="mt-run-title">{m.scoreTitle}</h2>
        <div class="mt-bar">
          <div class="mt-bar-left">
            <span class="mt-mode" data-mode></span>
            <span class="mt-status" role="status" data-status></span>
          </div>
          <dl class="mt-counters">
            <div><dt>{m.cRequests}</dt><dd data-c="requests">0</dd></div>
            <div><dt>{m.cJudgements}</dt><dd data-c="judgements">0</dd></div>
            <div><dt>{m.cTime}</dt><dd data-c="time">0,0 s</dd></div>
            <div><dt>{m.cTokens}</dt><dd data-c="tokens">0</dd></div>
            <div><dt title={m.costNote.replace('{price}', '0.042')}>{m.cCost}</dt><dd data-c="cost">0</dd></div>
          </dl>
          <div class="mt-bar-actions">
            <button type="button" class="mt-ghost" data-skip>{m.skip}</button>
            <button type="button" class="mt-ghost" data-replay hidden>{m.replay}</button>
            <button type="button" class="mt-ghost" data-new>{m.newRun}</button>
          </div>
        </div>

        <div class="mt-stage">
          <div class="mt-board" data-board>
            <div class="mt-col">
              <h3 class="mt-col-title">{m.reqTitle}</h3>
              <ol class="mt-reqs" data-reqs></ol>
            </div>
            <div class="mt-col mt-col-evid">
              <h3 class="mt-col-title">{m.evidTitle}</h3>
              <p class="mt-small">{m.evidHint}</p>
              <ul class="mt-evid" data-evid></ul>
            </div>
            <svg class="mt-wire" data-wire aria-hidden="true"></svg>
          </div>

          <aside class="mt-side">
            <div class="mt-score">
              <svg class="mt-ring" viewBox="0 0 140 140" aria-hidden="true">
                <circle class="mt-ring-bg" cx="70" cy="70" r="58" />
                <circle class="mt-ring-fg" cx="70" cy="70" r="58" pathLength="100" data-ring />
              </svg>
              <div class="mt-score-num">
                <span class="mt-total" data-total>0</span>
                <span class="mt-score-label">{m.scoreTitle}</span>
              </div>
            </div>
            <p class="mt-verdict" data-verdict aria-live="polite"></p>
            <dl class="mt-subs">
              <div><dt>{m.subCoverage}</dt><dd data-sub="coverage">·</dd></div>
              <div><dt>{m.subMust}</dt><dd data-sub="must">·</dd></div>
              <div><dt>{m.subTopics}</dt><dd data-sub="topics">·</dd></div>
            </dl>

            <svg class="mt-radar" viewBox="0 0 410 290" role="img" aria-label={m.radarLabel} data-radar>
              {[1 / 3, 2 / 3, 1].map(f => <polygon class="mt-radar-ring" points={ring(f)} />)}
              {AXES.map((a, i) => {
                const [x, y] = spoke(i, R);
                const [lx, ly] = spoke(i, R + 16);
                const anchor = Math.abs(lx - CX) < 4 ? 'middle' : lx > CX ? 'start' : 'end';
                return (
                  <g>
                    <line class="mt-radar-spoke" x1={CX} y1={CY} x2={x} y2={y} />
                    <text class="mt-radar-label" x={lx} y={ly + (ly > CY + 4 ? 10 : ly < CY - 4 ? -2 : 4)} text-anchor={anchor}>{a.label[lang]}</text>
                  </g>
                );
              })}
              <polygon class="mt-poly-demand" points={center} data-poly="demand" />
              <polygon class="mt-poly-cover" points={center} data-poly="cover" />
              <g data-radar-dots></g>
            </svg>
            <ul class="mt-legend">
              <li><span class="mt-sw mt-sw-demand"></span>{m.legendDemand}</li>
              <li><span class="mt-sw mt-sw-cover"></span>{m.legendCover}</li>
              <li><span class="mt-sw mt-sw-profile"></span>{m.legendProfile}</li>
            </ul>
            <p class="mt-small mt-roleline" data-role></p>
          </aside>
        </div>

        {/* ── After the run ── */}
        <div class="mt-after" data-after hidden>
          <div class="mt-gaps">
            <h3 class="mt-h3">{m.gapsTitle}</h3>
            <p class="mt-small">{m.gapsNote}</p>
            <ul class="mt-gap-list" data-gaps data-none={m.gapsNone}></ul>
          </div>
          <div class="mt-weights">
            <h3 class="mt-h3">{m.weightsTitle}</h3>
            <label class="mt-label" for="mt-share">{m.weightShareLabel}</label>
            <input id="mt-share" type="range" min="0" max="100" step="5" value={Math.round(DEFAULT_WEIGHTS.reqShare * 100)} data-share />
            <p class="mt-small" data-share-out data-tpl={m.weightShare}></p>
            <label class="mt-label" for="mt-must">{m.weightMust}</label>
            <select id="mt-must" data-must>
              {[1, 2, 3].map(n => <option value={n} selected={n === DEFAULT_WEIGHTS.mustFactor}>{m.weightMustX.replace('{n}', String(n))}</option>)}
            </select>
            <p class="mt-small">{m.weightsNote}</p>
            <button type="button" class="mt-ghost" data-reset>{m.reset}</button>
          </div>
          <div class="mt-cta">
            <h3 class="mt-h3">{m.ctaTitle}</h3>
            <p>{m.ctaText}</p>
            <p class="mt-cta-actions">
              {email && <a class="mt-btn" href={email.url} data-cta-mail>{m.ctaMail}</a>}
              <button type="button" class="mt-ghost" data-cta-agent>{m.ctaAgent}</button>
            </p>
            <p class="mt-cta-actions">
              <button type="button" class="mt-ghost mt-pdf" data-pdf data-busy={m.pdfBusy}>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0l-3-3m3 3l3-3M3 12v2h10v-2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>{m.pdfButton}</span>
              </button>
            </p>
            <p class="mt-small">{m.pdfHint}</p>
          </div>
        </div>
      </section>

      {/* ── Method ────────────────────────────────────────────────────────── */}
      <section class="mt-method">
        <h2 class="mt-h2">{m.methodTitle}</h2>
        <p class="mt-lead">{m.methodLead}</p>
        <ol class="mt-steps">
          {m.steps.map((s, i) => (
            <li><span class="mt-step-no">0{i + 1}</span><h3>{s.title}</h3><p>{s.body}</p></li>
          ))}
        </ol>
        <div class="mt-method-grid">
          <div>
            <h3 class="mt-h3">{m.formulaTitle}</h3>
            <ul class="mt-plain">{m.formula.map(f => <li>{f}</li>)}</ul>
            <h3 class="mt-h3 mt-gap-top">{m.limitsTitle}</h3>
            <ul class="mt-plain">{m.limits.map(f => <li>{f}</li>)}</ul>
          </div>
          <div>
            <h3 class="mt-h3">{m.exampleTitle}</h3>
            <p class="mt-small">{m.exampleNote}</p>
            <pre class="mt-code"><code>POST https://api.typesafe.ai/v1/systemone{'\n'}{exampleText}</code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="mt-foot">
      <nav aria-label={t.navFooter}>
        <a href={`/${lang}/impressum/`}>{t.legalImpressum}</a>
        <a href={`/${lang}/datenschutz/`}>{t.legalPrivacy}</a>
      </nav>
    </footer>
  </div>

  <script type="application/json" id="mt-data" set:html={JSON.stringify(pageData).replace(/</g, '\\u003c')} />

  <script>
    import { scoreMatch, verdictOf, splitRequirements, MET_LEVEL, type Measurement, type RequirementResult, type Weights } from '../lib/match';
    import { readFileText, FileTooBig } from '../lib/match-file';

    const D = JSON.parse(document.getElementById('mt-data')!.textContent!);
    const T = D.t;
    const $ = <E extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<E & Element>(sel) as unknown as E;
    const $$ = <E extends Element = HTMLElement>(sel: string, root: ParentNode = document) => [...root.querySelectorAll(sel)] as unknown as E[];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const nf = (n: number, d = 0) => n.toLocaleString(D.lang === 'de' ? 'de-DE' : 'en-US', { minimumFractionDigits: d, maximumFractionDigits: d });

    // ── Input ────────────────────────────────────────────────────────────
    let tab = 'demo';
    let liveOk = false;
    const tabs = $$<HTMLButtonElement>('[data-tab]');
    const note = $('[data-note]');
    const errorEl = $('[data-error]');
    const text = $<HTMLTextAreaElement>('[data-text]');
    const startBtn = $<HTMLButtonElement>('[data-start]');

    function showTab(name: string, focus = false) {
      tab = name;
      if (name !== 'demo') probeLive();
      tabs.forEach(b => {
        const on = b.dataset.tab === name;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
        if (on && focus) b.focus();
      });
      $$('[data-panel]').forEach(p => { p.hidden = p.dataset.panel !== name; });
      note.textContent = name === 'demo' ? note.dataset.demo! : (liveOk ? note.dataset.live! : T.liveDown);
      updateStart();
      hideError();
    }
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => showTab(b.dataset.tab!));
      b.addEventListener('keydown', e => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) showTab(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });

    function updateStart() {
      startBtn.disabled = tab !== 'demo' && !liveOk;
      const c = $('[data-count]');
      c.textContent = c.dataset.tpl!.replace('{n}', nf(text.value.length)).replace('{max}', nf(12000));
    }
    text.addEventListener('input', updateStart);

    $$<HTMLInputElement>('input[name="demo"]').forEach(r => r.addEventListener('change', () => {
      $$('[data-demo-text]').forEach(d => { d.hidden = d.dataset.demoText !== r.value; });
    }));

    const showError = (msg: string) => { errorEl.textContent = msg; errorEl.hidden = false; };
    const hideError = () => { errorEl.hidden = true; };

    // A file only fills the text field; the visitor sees what would be sent.
    async function takeFile(file: File | undefined) {
      if (!file) return;
      hideError();
      try {
        const content = await readFileText(file);
        text.value = content.slice(0, 12000);
        showTab('text');
        note.textContent = T.fileRead.replace('{name}', () => file.name).replace('{n}', nf(text.value.length)) + ' ' + (liveOk ? T.noteLive : T.liveDown);
        updateStart();
        text.focus();
      } catch (e) {
        showError(e instanceof FileTooBig ? T.fileTooBig : T.fileError);
      }
    }
    const drop = $('[data-drop]');
    $<HTMLInputElement>('[data-file]').addEventListener('change', e => takeFile((e.target as HTMLInputElement).files?.[0]));
    drop.addEventListener('dragover', e => { e.preventDefault(); drop.classList.add('is-over'); });
    drop.addEventListener('dragleave', () => drop.classList.remove('is-over'));
    drop.addEventListener('drop', e => { e.preventDefault(); drop.classList.remove('is-over'); takeFile(e.dataTransfer?.files?.[0]); });

    // Is the live worker there? Asked only once a visitor opens the text or
    // file tab: the examples send nothing, and the privacy page says so.
    let probe: Promise<void> | null = null;
    function probeLive(): Promise<void> {
      if (!D.endpoint) return Promise.resolve();
      probe ??= fetch(`${D.endpoint}/health`, { signal: AbortSignal.timeout(6000) })
        .then(r => r.ok ? r.json() : null)
        .then(j => { liveOk = Boolean(j?.ok); })
        .catch(() => { liveOk = false; })
        .finally(() => { if (tab !== 'demo') showTab(tab); });
      return probe;
    }

    // ── The run ──────────────────────────────────────────────────────────
    const run = $('[data-run]');
    const reqsEl = $('[data-reqs]');
    const evidEl = $('[data-evid]');
    const board = $('[data-board]');
    const wire = $<SVGSVGElement>('[data-wire]');
    const status = $('[data-status]');
    let timers: number[] = [];
    let current: Measurement | null = null;
    let answered: RequirementResult[] = [];
    /** Which rows have their answer: they arrive out of order, so a count is not enough. */
    let arrived = new Set<number>();
    let projectIn = false;
    let weights: Weights = { ...D.weights };
    let shownTotal = 0;
    const links: { row: HTMLElement; ev: HTMLElement; dashed: boolean; path?: SVGPathElement }[] = [];

    const frames: Record<string, number> = {};
    /** One animation frame loop per target; a new tween or a reset cancels the old one. */
    function animate(target: string, dur: number, step: (k: number) => void) {
      cancelAnimationFrame(frames[target]);
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        step(k);
        if (k < 1) frames[target] = requestAnimationFrame(tick);
      };
      frames[target] = requestAnimationFrame(tick);
    }
    const stopFrames = () => Object.keys(frames).forEach(k => cancelAnimationFrame(frames[k]));
    const clearTimers = () => { timers.forEach(clearTimeout); timers = []; };
    const later = (ms: number, fn: () => void) => { timers.push(window.setTimeout(fn, ms)); };

    function rowFor(textLine: string, i: number): HTMLLIElement {
      const li = document.createElement('li');
      li.className = 'mt-req';
      li.dataset.i = String(i);
      li.innerHTML = `<span class="mt-req-dot" aria-hidden="true"></span>
        <div class="mt-req-body"><p class="mt-req-text"></p>
        <p class="mt-req-meta"><span class="mt-chip" data-chip></span><span class="mt-axis" data-axis></span>
        <span class="mt-meter" aria-hidden="true"><i></i><i></i><i></i></span><span class="mt-level" data-level></span></p>
        <p class="mt-req-ev" data-ev></p></div>`;
      li.querySelector('.mt-req-text')!.textContent = textLine;   // text from the visitor: never innerHTML
      return li;
    }

    function reset(lines: string[]) {
      clearTimers();
      stopFrames();
      answered = []; arrived = new Set(); projectIn = false; links.length = 0; shownTotal = 0;
      reqsEl.replaceChildren(...lines.map(rowFor));
      evidEl.replaceChildren();
      wire.replaceChildren();
      $$('[data-c]').forEach(c => { c.textContent = c.dataset.c === 'time' ? `${nf(0, 1)} s` : '0'; });
      counters = { requests: 0, judgements: 0, time: 0, tokens: 0 };
      setTotal(0, true);
      $('[data-verdict]').textContent = '';
      $('[data-verdict]').classList.remove('is-in');
      $$('[data-sub]').forEach(s => { s.textContent = '·'; });
      $('[data-role]').textContent = '';
      $('[data-after]').hidden = true;
      $('[data-replay]').hidden = true;
      $('[data-skip]').hidden = false;
      setPoly('demand', D.axes.map(() => 0), true);
      setPoly('cover', D.axes.map(() => 0), true);
      $('[data-radar-dots]').replaceChildren();
      run.classList.remove('is-done');
    }

    let counters = { requests: 0, judgements: 0, time: 0, tokens: 0 };
    function count(seconds: number, tokens: number, judgements: number) {
      counters.requests += 1; counters.judgements += judgements; counters.time += seconds; counters.tokens += tokens;
      $('[data-c="requests"]').textContent = nf(counters.requests);
      $('[data-c="judgements"]').textContent = nf(counters.judgements);
      $('[data-c="time"]').textContent = `${nf(counters.time, 1)} s`;
      $('[data-c="tokens"]').textContent = nf(counters.tokens);
      $('[data-c="cost"]').textContent = `${nf(counters.tokens / 1e6 * D.price, 4)} US$`;
    }

    // Radar polygons, tweened point by point.
    const polyState: Record<string, number[]> = { demand: D.axes.map(() => 0), cover: D.axes.map(() => 0) };
    const pt = (i: number, v: number) => {
      const a = -Math.PI / 2 + (i * 2 * Math.PI) / D.axes.length;
      const r = D.radar.r * Math.max(0, Math.min(1, v));
      return [D.radar.cx + r * Math.cos(a), D.radar.cy + r * Math.sin(a)];
    };
    function setPoly(name: string, to: number[], instant = false) {
      const el = $(`[data-poly="${name}"]`) as unknown as SVGPolygonElement;
      const from = polyState[name].slice();
      polyState[name] = to.slice();
      const draw = (vals: number[]) => el.setAttribute('points', vals.map((v, i) => pt(i, v).map(n => n.toFixed(1)).join(',')).join(' '));
      if (instant || reduced) { cancelAnimationFrame(frames[`poly-${name}`]); draw(to); return; }
      animate(`poly-${name}`, 700, k => { const e = 1 - (1 - k) ** 3; draw(from.map((f, i) => f + (to[i] - f) * e)); });
    }

    function setTotal(value: number, instant = false) {
      const ring = $('[data-ring]');
      ring.style.strokeDashoffset = String(100 - value);
      const num = $('[data-total]');
      if (instant || reduced) { cancelAnimationFrame(frames.total); num.textContent = String(value); shownTotal = value; return; }
      const from = shownTotal;
      shownTotal = value;
      animate('total', 600, k => { num.textContent = String(Math.round(from + (value - from) * (1 - (1 - k) ** 3))); });
    }

    function refreshScore(final = false) {
      if (!current) return;
      const demand = projectIn ? current.project.demand : Object.fromEntries(D.axes.map((a: any) => [a.key, 0]));
      const s = scoreMatch(answered, demand, D.profile, weights);
      setTotal(s.total, final && reduced);
      $('[data-sub="coverage"]').textContent = s.counted ? `${nf(s.coverage * 100)} %` : '·';
      $('[data-sub="must"]').textContent = s.mustTotal ? `${s.mustMet} / ${s.mustTotal}` : '·';
      $('[data-sub="topics"]').textContent = projectIn ? `${nf(s.topicFit * 100)} %` : '·';
      if (projectIn) {
        setPoly('cover', D.axes.map((a: any) => s.perAxis[a.key].cover));
        const dots = $('[data-radar-dots]');
        dots.replaceChildren(...D.axes.map((a: any, i: number) => {
          const [x, y] = pt(i, s.perAxis[a.key].cover);
          const c = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          c.setAttribute('cx', x.toFixed(1)); c.setAttribute('cy', y.toFixed(1)); c.setAttribute('r', '3.2');
          c.setAttribute('class', s.perAxis[a.key].fromLines ? 'mt-dot' : 'mt-dot is-profile');
          return c;
        }));
      }
      if (final) {
        const v = $('[data-verdict]');
        v.textContent = T.verdicts[verdictOf(s.total)];
        v.dataset.verdict = verdictOf(s.total);
        v.classList.add('is-in');
        renderGaps(s.gaps);
      }
      return s;
    }

    function renderGaps(gaps: RequirementResult[]) {
      const ul = $('[data-gaps]');
      if (!gaps.length) { const li = document.createElement('li'); li.className = 'mt-gap-none'; li.textContent = ul.dataset.none!; ul.replaceChildren(li); return; }
      ul.replaceChildren(...gaps.map(g => {
        const li = document.createElement('li');
        const chip = document.createElement('span');
        chip.className = `mt-chip${g.must >= 0.5 ? ' is-must' : ''}`;
        chip.textContent = g.must >= 0.5 ? T.must : T.nice;
        const txt = document.createElement('span');
        txt.textContent = g.text;
        const lvl = document.createElement('span');
        lvl.className = 'mt-level';
        lvl.textContent = T.levels[Math.round(g.level)];
        li.append(chip, txt, lvl);
        return li;
      }));
    }

    function evidenceItem(id: string): HTMLElement {
      let el = evidEl.querySelector<HTMLElement>(`[data-id="${id}"]`);
      if (el) return el;
      const info = D.entries[id];
      el = document.createElement('li');
      el.className = 'mt-ev';
      el.dataset.id = id;
      el.dataset.n = '0';
      const kind = info.kind === 'station' ? T.kindStation : info.kind === 'project' ? T.kindProject : T.kindProfile;
      el.innerHTML = `<span class="mt-ev-kind"></span><a class="mt-ev-label" target="_blank" rel="noopener"></a><span class="mt-ev-count"></span>`;
      el.querySelector('.mt-ev-kind')!.textContent = kind;
      const a = el.querySelector<HTMLAnchorElement>('.mt-ev-label')!;
      a.textContent = info.label; a.href = info.href; a.title = T.openEntry;
      evidEl.append(el);
      return el;
    }

    function linkPath(row: HTMLElement, ev: HTMLElement) {
      const b = board.getBoundingClientRect();
      const r = row.querySelector('.mt-req-dot')!.getBoundingClientRect();
      const col = reqsEl.getBoundingClientRect();
      const e = ev.getBoundingClientRect();
      const x1 = col.right - b.left + 4; const y1 = r.top + r.height / 2 - b.top;
      const x2 = e.left - b.left - 6; const y2 = e.top + e.height / 2 - b.top;
      const mx = (x1 + x2) / 2;
      return `M${x1.toFixed(1)},${y1.toFixed(1)} C${mx.toFixed(1)},${y1.toFixed(1)} ${mx.toFixed(1)},${y2.toFixed(1)} ${x2.toFixed(1)},${y2.toFixed(1)}`;
    }

    function drawLink(row: HTMLElement, ev: HTMLElement, dashed: boolean, instant: boolean) {
      if (getComputedStyle(wire).display === 'none') { links.push({ row, ev, dashed }); return; }
      const ns = 'http://www.w3.org/2000/svg';
      const path = document.createElementNS(ns, 'path');
      path.setAttribute('d', linkPath(row, ev));
      path.setAttribute('class', `mt-link${dashed ? ' is-weak' : ''}`);
      path.setAttribute('pathLength', '1');
      wire.append(path);
      links.push({ row, ev, dashed, path });
      if (instant || reduced) { path.classList.add('is-drawn'); return; }
      requestAnimationFrame(() => path.classList.add('is-drawn'));
      // One point of light travels the line once while it draws.
      const dot = document.createElementNS(ns, 'circle');
      dot.setAttribute('r', '3.5'); dot.setAttribute('class', 'mt-signal');
      wire.append(dot);
      const len = path.getTotalLength(); const t0 = performance.now();
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / 750);
        const p = path.getPointAtLength(len * (1 - (1 - k) ** 2));
        dot.setAttribute('cx', String(p.x)); dot.setAttribute('cy', String(p.y));
        if (k < 1) requestAnimationFrame(step); else dot.remove();
      };
      requestAnimationFrame(step);
    }

    /** On resize the lines only move: a line that is still drawing keeps its
     *  element, class and travelling light (review 2026-09-26: rebuilding all
     *  paths here cut every draw animation off, because each arrival grows the
     *  board and so fires the observer). Lines made while the wire was hidden
     *  get their element now. */
    function redrawLinks() {
      if (getComputedStyle(wire).display === 'none') return;
      const b = board.getBoundingClientRect();
      wire.setAttribute('viewBox', `0 0 ${b.width} ${b.height}`);
      for (const l of links) {
        if (!l.path) {
          l.path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          l.path.setAttribute('class', `mt-link is-drawn${l.dashed ? ' is-weak' : ''}`);
          l.path.setAttribute('pathLength', '1');
          wire.append(l.path);
        }
        l.path.setAttribute('d', linkPath(l.row, l.ev));
      }
    }
    new ResizeObserver(() => { if (!run.hidden) redrawLinks(); }).observe(board);

    function arrive(r: RequirementResult, i: number, instant: boolean) {
      if (arrived.has(i)) return;
      arrived.add(i);
      answered.push(r);
      const row = reqsEl.children[i] as HTMLElement;
      row.classList.remove('is-asking');
      row.classList.add('is-done');
      if (!r.counts) row.classList.add('is-out');
      const chip = row.querySelector<HTMLElement>('[data-chip]')!;
      chip.textContent = !r.counts ? T.notReq : r.must >= 0.5 ? T.must : T.nice;
      chip.classList.toggle('is-must', r.counts && r.must >= 0.5);
      const axis = D.axes.find((a: any) => a.key === r.axis);
      row.querySelector('[data-axis]')!.textContent = axis ? axis.label : '';
      const meter = row.querySelector<HTMLElement>('.mt-meter')!;
      meter.style.setProperty('--lvl', String(r.level));
      [...meter.children].forEach((seg, k) => (seg as HTMLElement).style.setProperty('--fill', String(Math.max(0, Math.min(1, r.level - k)))));
      row.querySelector('[data-level]')!.textContent = T.levels[Math.round(r.level)];
      row.classList.toggle('is-gap', r.counts && r.level < MET_LEVEL);
      const evLine = row.querySelector<HTMLElement>('[data-ev]')!;
      if (r.counts && r.evidence && r.level >= 0.75 && D.entries[r.evidence]) {
        const info = D.entries[r.evidence];
        evLine.innerHTML = '<span aria-hidden="true">↳ </span><a target="_blank" rel="noopener"></a>';
        const a = evLine.querySelector('a')!; a.textContent = info.label; a.href = info.href;
        const ev = evidenceItem(r.evidence);
        const n = Number(ev.dataset.n) + 1;
        ev.dataset.n = String(n);
        ev.querySelector('.mt-ev-count')!.textContent = T.evidCount.replace('{n}', String(n));
        ev.classList.remove('is-glow'); void ev.offsetWidth; ev.classList.add('is-glow');
        drawLink(row, ev, r.level < MET_LEVEL, instant);
      } else if (r.counts) {
        evLine.textContent = T.noEvidence;
        evLine.classList.add('is-none');
      }
      count(r.seconds, r.tokens, 5);
      if (!instant) refreshScore();
    }

    function projectArrives(instant: boolean) {
      if (!current) return;
      projectIn = true;
      setPoly('demand', D.axes.map((a: any) => current!.project.demand[a.key] ?? 0), instant);
      $('[data-role]').textContent = T.role.replace('{role}', T.roles[current.project.role] ?? T.roles.other);
      count(current.project.seconds, current.project.tokens, D.axes.length + 1);
      if (!instant) refreshScore();
    }

    function finish() {
      clearTimers();
      status.textContent = T.statusDone
        .replace('{total}', String(current!.requirements.length))
        .replace('{urteile}', nf(counters.judgements))
        .replace('{sekunden}', nf(counters.time, 1));
      refreshScore(true);
      $('[data-after]').hidden = false;
      const skip = $('[data-skip]');
      const hadFocus = document.activeElement === skip;
      skip.hidden = true;
      $('[data-replay]').hidden = false;
      if (hadFocus) $<HTMLButtonElement>('[data-replay]').focus();
      run.classList.add('is-done');
      updateShareOut();
    }

    /** Plays a measurement. Each answer arrives at its own time; requests
     *  overlap a little, the way four parallel lanes do, but slowed down so a
     *  reader can follow: the measured seconds stay in the counters. */
    function play(meas: Measurement, instant = false) {
      current = meas;
      reset(meas.requirements.map(r => r.text));
      $('[data-mode]').textContent = (meas as any).live ? T.modeLive : T.modeReplay.replace('{date}', new Date(`${meas.measuredAt}T12:00:00Z`).toLocaleDateString(D.lang === 'de' ? 'de-DE' : 'en-GB'));
      status.textContent = T.statusWaiting;
      if (instant || reduced) {
        projectArrives(true);
        meas.requirements.forEach((r, i) => arrive(r, i, true));
        requestAnimationFrame(redrawLinks);
        finish();
        return;
      }
      setPoly('cover', D.axes.map(() => 0), true);
      later(700, () => projectArrives(false));
      meas.requirements.forEach((r, i) => {
        const start = 500 + i * 430;
        const dur = Math.max(700, Math.min(1500, r.seconds * 2600));
        later(start, () => (reqsEl.children[i] as HTMLElement)?.classList.add('is-asking'));
        later(start + dur, () => arrive(r, i, false));
      });
      const end = 500 + (meas.requirements.length - 1) * 430 + 1500 + 500;
      later(end, finish);
    }

    function skipToEnd() {
      if (!current) return;
      clearTimers();
      const meas = current;
      if (!projectIn) projectArrives(true);
      meas.requirements.forEach((r, i) => arrive(r, i, true));
      requestAnimationFrame(redrawLinks);
      finish();
    }

    // ── Start ────────────────────────────────────────────────────────────
    startBtn.addEventListener('click', async () => {
      hideError();
      if (tab === 'demo') {
        const id = $<HTMLInputElement>('input[name="demo"]:checked').value;
        run.hidden = false;
        run.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
        play(D.demos[id]);
        return;
      }
      const posting = text.value.trim();
      const lines = splitRequirements(posting);
      if (lines.length < 2) { showError(T.tooShort); return; }
      startBtn.disabled = true;
      run.hidden = false;
      current = null;
      reset(lines);
      lines.forEach((_, i) => (reqsEl.children[i] as HTMLElement).classList.add('is-asking'));
      $('[data-mode]').textContent = T.modeLive;
      status.textContent = T.statusWaiting;
      $('[data-skip]').hidden = true;
      run.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      status.tabIndex = -1;
      status.focus({ preventScroll: true });
      try {
        const res = await fetch(`${D.endpoint}/match`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ lang: D.lang, text: posting }),
          signal: AbortSignal.timeout(60000),
        });
        if (res.status === 429) throw new Error('rate');
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        play(await res.json());
      } catch (e) {
        run.hidden = true;
        startBtn.focus();
        const msg = e instanceof Error ? e.message : 'error';
        showError(msg === 'rate' ? T.errorRate : T.errorLive.replace('{error}', msg));
      } finally {
        updateStart();
      }
    });

    $('[data-skip]').addEventListener('click', skipToEnd);
    $('[data-replay]').addEventListener('click', () => { if (current) play(current); });
    $('[data-new]').addEventListener('click', () => {
      clearTimers();
      stopFrames();
      run.hidden = true;
      $('[data-input]').scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      $<HTMLButtonElement>(`[data-tab="${tab}"]`).focus({ preventScroll: true });
    });

    // ── Weights: same answers, new arithmetic ────────────────────────────
    const share = $<HTMLInputElement>('[data-share]');
    const must = $<HTMLSelectElement>('[data-must]');
    function updateShareOut() {
      const a = Number(share.value);
      $('[data-share-out]').textContent = $('[data-share-out]').dataset.tpl!.replace('{a}', String(a)).replace('{b}', String(100 - a));
    }
    function reweigh() {
      weights = { reqShare: Number(share.value) / 100, mustFactor: Number(must.value) };
      updateShareOut();
      if (current && run.classList.contains('is-done')) refreshScore(true);
    }
    share.addEventListener('input', reweigh);
    must.addEventListener('change', reweigh);
    $('[data-reset]').addEventListener('click', () => {
      share.value = String(Math.round(D.weights.reqShare * 100));
      must.value = String(D.weights.mustFactor);
      reweigh();
    });
    updateShareOut();

    // ── After: ask the agent, with the result as context ─────────────────
    $('[data-cta-agent]').addEventListener('click', () => {
      if (!current) return;
      const top = Object.entries(current.project.demand).sort((a, b) => b[1] - a[1]).slice(0, 3)
        .map(([k]) => D.axes.find((a: any) => a.key === k)?.label).filter(Boolean).join(', ');
      // The agent sends at once and its conversations are logged, so a live
      // run's own text stays out: only an example's lines go along
      // (review 2026-09-26; the privacy page names Cloudflare and TypeSafe for
      // own text, not the chat).
      const s = scoreMatch(current.requirements, current.project.demand, D.profile, weights);
      const gaps = (current as any).live ? '' : s.gaps.slice(0, 3).map(g => g.text.slice(0, 80)).join('; ');
      const prompt = (gaps ? T.agentPrompt.replace('{gaps}', () => gaps) : T.agentPromptNoGaps).replace('{axes}', () => top);
      window.dispatchEvent(new CustomEvent('bridge-agent:prompt', { detail: { text: prompt } }));
    });
    const mail = $<HTMLAnchorElement>('[data-cta-mail]');
    mail?.addEventListener('click', () => {
      if (!current) return;
      const s = scoreMatch(current.requirements, current.project.demand, D.profile, weights);
      // Windows and Outlook drop a mailto link above about 2,000 characters.
      let body = '';
      for (const r of current.requirements.filter(x => x.counts)) {
        const line = `- ${r.text}\n`;
        if (encodeURIComponent(body + line).length > 1500) break;
        body += line;
      }
      mail.href = `${D.mail}?subject=${encodeURIComponent(`${T.mailSubject} (${T.scoreTitle} ${s.total})`)}&body=${encodeURIComponent(body)}`;
    });

    // ── Export: the evaluation as a PDF, the CV behind it ────────────────
    const pdfBtn = $<HTMLButtonElement>('[data-pdf]');
    pdfBtn.addEventListener('click', async () => {
      if (!current) return;
      const label = pdfBtn.querySelector('span')!;
      const idle = label.textContent;
      pdfBtn.disabled = true;
      label.textContent = pdfBtn.dataset.busy!;
      try {
        const meas = current;
        const s = scoreMatch(meas.requirements, meas.project.demand, D.profile, weights);
        const demoId = (meas as any).live ? '' : $<HTMLInputElement>('input[name="demo"]:checked')?.value;
        const title = demoId ? D.demoTitles[demoId] : T.pdfOwnPosting;
        const lvl = (r: RequirementResult) => T.levels[Math.round(r.level)];
        const kind = (r: RequirementResult) => (!r.counts ? T.notReq : r.must >= 0.5 ? T.must : T.nice);
        const evidence = (r: RequirementResult) => (r.counts && r.evidence && r.level >= 0.75 && D.entries[r.evidence] ? D.entries[r.evidence].label : r.counts ? T.noEvidence : '');
        const toLine = (r: RequirementResult) => ({ text: r.text, kind: kind(r), level: r.counts ? lvl(r) : '', evidence: evidence(r), gap: r.counts && r.level < MET_LEVEL, counts: r.counts });
        const today = new Date().toLocaleDateString(D.lang === 'de' ? 'de-DE' : 'en-GB');
        const cv = await fetch(D.cvPdf).then(r => (r.ok ? r.arrayBuffer() : null)).then(b => (b ? new Uint8Array(b) : null)).catch(() => null);
        const { buildReportPdf } = await import('../lib/match-pdf');
        const bytes = await buildReportPdf({
          lang: D.lang, kicker: $('.mt-kicker').textContent || '', title,
          modeLine: $('[data-mode]').textContent || '',
          total: s.total, verdict: T.verdicts[verdictOf(s.total)],
          subs: [[T.subCoverage, `${nf(s.coverage * 100)} %`], [T.subMust, `${s.mustMet} / ${s.mustTotal}`], [T.subTopics, `${nf(s.topicFit * 100)} %`]],
          roleLine: T.role.replace('{role}', T.roles[meas.project.role] ?? T.roles.other),
          weightsLine: T.pdfWeights.replace('{a}', String(Math.round(weights.reqShare * 100))).replace('{b}', String(100 - Math.round(weights.reqShare * 100))).replace('{n}', String(weights.mustFactor)),
          axes: D.axes.map((a: any) => ({ label: a.label, demand: s.perAxis[a.key].demand, cover: s.perAxis[a.key].cover, fromLines: s.perAxis[a.key].fromLines })),
          legend: { demand: T.legendDemand, cover: T.legendCover },
          gapsTitle: T.gapsTitle, gaps: s.gaps.map(toLine), gapsNone: T.gapsNone, gapsNote: T.gapsNote,
          linesTitle: T.pdfLinesTitle, cols: T.pdfCols, lines: meas.requirements.map(toLine),
          methodTitle: T.methodTitle, method: [T.methodLead, ...T.formula, ...T.limits],
          footer: T.pdfFooter.replace('{date}', today),
          cvNote: T.pdfCvNote, cv, cvMissing: T.pdfCvMissing,
        });
        const url = URL.createObjectURL(new Blob([bytes], { type: 'application/pdf' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = `${T.pdfFile}_${(demoId || 'Projekt').replace(/[^a-z0-9-]/gi, '_')}.pdf`;
        document.body.append(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
      } catch {
        showError(T.pdfFailed);
      } finally {
        pdfBtn.disabled = false;
        label.textContent = idle;
      }
    });

    // ── Started by the agent ─────────────────────────────────────────────
    // The chat offers a button (⟦ui:match⟧ in AgentWidget.astro); its click
    // arrives here as an event, or, from another view, as a posting waiting in
    // sessionStorage. Either way the visitor clicked, as the privacy page says.
    async function startFromAgent(detail: { text?: string; demo?: string }) {
      if (detail.demo) {
        const radio = document.querySelector<HTMLInputElement>(`input[name="demo"][value="${CSS.escape(detail.demo)}"]`);
        if (!radio) return;
        radio.checked = true;
        radio.dispatchEvent(new Event('change'));
        showTab('demo');
      } else if (detail.text) {
        text.value = detail.text.slice(0, 12000);
        showTab('text');
        await probeLive();
        if (!liveOk) { showError(T.liveDown); return; }
      } else return;
      startBtn.click();
    }
    window.addEventListener('bridge-agent:match', e => { void startFromAgent((e as CustomEvent).detail || {}); });

    showTab('demo');
    try {
      const pending = sessionStorage.getItem('cv-match-pending');
      if (pending) {
        sessionStorage.removeItem('cv-match-pending');
        void startFromAgent(JSON.parse(pending));
      }
    } catch {}
  </script>
</BaseLayout>

<style is:global>
  /* Global on purpose: the rows, evidence items and lines are created by the
     script during a run, and Astro's scoped styles only reach markup that
     exists at build time. Every class carries the mt- prefix instead. */
  .mt {
    --mt-bg: #f4f6f9;
    --mt-surface: #ffffff;
    --mt-ink: #14171c;
    --mt-text: #39414b;
    --mt-muted: #5c6470;
    --mt-line: rgba(20, 23, 28, 0.12);
    --mt-line-strong: rgba(20, 23, 28, 0.24);
    --mt-accent: #1d4ed8;
    --mt-accent-soft: rgba(29, 78, 216, 0.13);
    --mt-demand: #b45309;
    --mt-demand-soft: rgba(180, 83, 9, 0.08);
    --mt-gap: #b42318;
    --mt-mono: var(--font-mono);
    --vs-line: var(--mt-line-strong);
    --vs-text: var(--mt-muted);
    --vs-text-hover: var(--mt-ink);
    --vs-active-bg: var(--mt-ink);
    --vs-active-text: var(--mt-bg);
    --vs-radius: 0;

    min-height: 100vh;
    background: var(--mt-bg);
    color: var(--mt-text);
    font-family: var(--font-body);
  }
  html.dark .mt {
    --mt-bg: #0b1120;
    --mt-surface: #111a2e;
    --mt-ink: #eef2f6;
    --mt-text: #bcc5cf;
    --mt-muted: #93a0ad;
    --mt-line: rgba(188, 197, 207, 0.14);
    --mt-line-strong: rgba(188, 197, 207, 0.3);
    --mt-accent: #60a5fa;
    --mt-accent-soft: rgba(96, 165, 250, 0.18);
    --mt-demand: #fbbf24;
    --mt-demand-soft: rgba(251, 191, 36, 0.08);
    --mt-gap: #fca5a5;
  }
  html.cv-match body { background: #f4f6f9; }
  html.cv-match.dark body { background: #0b1120; }
  .mt a { color: inherit; }
  .mt button, .mt select { font: inherit; cursor: pointer; }
  .mt button:disabled { cursor: not-allowed; opacity: 0.5; }

  /* ── Top ── */
  .mt-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.8rem 1.5rem; border-bottom: 1px solid var(--mt-line); }
  .mt-id { display: flex; align-items: baseline; gap: 0.9rem; min-width: 0; text-decoration: none; }
  .mt-name { font-size: var(--fs-16); font-weight: 500; color: var(--mt-ink); white-space: nowrap; }
  .mt-role { font-family: var(--mt-mono); font-size: var(--fs-11); color: var(--mt-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .mt-top-right { display: flex; align-items: center; gap: 0.9rem; }
  .mt-lang { display: flex; gap: 0.55rem; font-size: var(--fs-13); }
  .mt-lang a { color: var(--mt-muted); text-decoration: none; }
  .mt-lang a.is-active { color: var(--mt-ink); font-weight: 600; }

  .mt-main { max-width: 88rem; margin: 0 auto; padding: 0 1.5rem 4rem; }

  /* ── Hero ── */
  .mt-hero { padding: 3.5rem 0 2rem; max-width: 48rem; }
  .mt-kicker { font-family: var(--mt-mono); font-size: var(--fs-11); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mt-accent); }
  .mt-h1 { margin-top: 0.7rem; font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 300; letter-spacing: -0.035em; line-height: 1.02; color: var(--mt-ink); }
  .mt-lead { margin-top: 1rem; font-size: var(--fs-16); line-height: 1.6; max-width: 44rem; }
  .mt-h2 { font-size: 1.8rem; font-weight: 300; letter-spacing: -0.02em; color: var(--mt-ink); }
  .mt-h3 { font-size: var(--fs-15); font-weight: 500; color: var(--mt-ink); }
  .mt-small { margin-top: 0.4rem; font-size: var(--fs-12); line-height: 1.5; color: var(--mt-muted); }
  .mt-label { display: block; margin-top: 0.9rem; font-family: var(--mt-mono); font-size: var(--fs-11); letter-spacing: 0.06em; text-transform: uppercase; color: var(--mt-muted); }

  /* ── Input ── */
  .mt-input { padding: 1.4rem; background: var(--mt-surface); border: 1px solid var(--mt-line); scroll-margin-top: 1rem; }
  .mt-tabs { display: flex; gap: 0; border-bottom: 1px solid var(--mt-line); margin-bottom: 1.2rem; overflow-x: auto; }
  .mt-tabs button { padding: 0.6rem 1rem; font-size: var(--fs-14); color: var(--mt-muted); background: none; border: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; }
  .mt-tabs button[aria-selected="true"] { color: var(--mt-ink); border-bottom-color: var(--mt-ink); }
  .mt-tabs button:hover { color: var(--mt-ink); }
  .mt-demos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .mt-demo { position: relative; display: grid; gap: 0.25rem; padding: 0.9rem 1rem; border: 1px solid var(--mt-line-strong); cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .mt-demo:hover { border-color: var(--mt-ink); }
  .mt-demo input { position: absolute; opacity: 0; pointer-events: none; }
  .mt-demo:has(input:checked) { border-color: var(--mt-accent); background: var(--mt-accent-soft); }
  .mt-demo:has(input:focus-visible) { outline: 2px solid var(--mt-accent); outline-offset: 2px; }
  .mt-demo-title { font-size: var(--fs-15); font-weight: 500; color: var(--mt-ink); }
  .mt-demo-teaser { font-size: var(--fs-13); }
  .mt-demo-date { font-family: var(--mt-mono); font-size: var(--fs-11); color: var(--mt-muted); }
  .mt-demo-text { margin-top: 0.9rem; }
  .mt-demo-text summary { cursor: pointer; font-size: var(--fs-13); color: var(--mt-muted); }
  .mt-demo-text pre { margin-top: 0.6rem; padding: 0.9rem 1rem; max-height: 18rem; overflow: auto; white-space: pre-wrap; font-family: var(--mt-mono); font-size: var(--fs-12); line-height: 1.55; background: var(--mt-bg); border: 1px solid var(--mt-line); }
  .mt textarea { display: block; width: 100%; margin-top: 0.4rem; padding: 0.8rem 0.9rem; font: inherit; font-size: var(--fs-14); line-height: 1.55; color: var(--mt-ink); background: var(--mt-bg); border: 1px solid var(--mt-line-strong); resize: vertical; }
  .mt textarea:focus-visible, .mt select:focus-visible, .mt input[type="range"]:focus-visible { outline: 2px solid var(--mt-accent); outline-offset: 1px; }
  .mt-drop { display: grid; justify-items: center; gap: 0.35rem; padding: 2.4rem 1rem; text-align: center; border: 1.5px dashed var(--mt-line-strong); cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .mt-drop:hover, .mt-drop.is-over { border-color: var(--mt-accent); background: var(--mt-accent-soft); }
  .mt-drop input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .mt-drop:has(input:focus-visible) { outline: 2px solid var(--mt-accent); }
  .mt-drop svg { width: 1.8rem; height: 1.8rem; color: var(--mt-accent); }
  .mt-drop-title { font-size: var(--fs-15); color: var(--mt-ink); }
  .mt-go { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; margin-top: 1.3rem; }
  .mt-note { flex: 1 1 20rem; font-size: var(--fs-12); line-height: 1.5; color: var(--mt-muted); }
  .mt-error { margin-top: 0.9rem; padding: 0.6rem 0.8rem; font-size: var(--fs-13); color: var(--mt-gap); border: 1px solid currentColor; }
  .mt-btn { display: inline-block; padding: 0.7rem 1.2rem; font-size: var(--fs-14); font-weight: 500; color: var(--mt-bg) !important; background: var(--mt-ink); border: 0; text-decoration: none; }
  .mt-btn:hover:not(:disabled) { opacity: 0.88; }
  .mt-ghost { padding: 0.35rem 0.75rem; font-size: var(--fs-13) !important; color: var(--mt-ink); background: transparent; border: 1px solid var(--mt-line-strong); }
  .mt-ghost:hover { border-color: var(--mt-ink); }

  /* ── Run: instrument bar ── */
  .mt-run { margin-top: 2rem; scroll-margin-top: 0.5rem; }
  .mt-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.6rem; padding: 0.8rem 1rem; background: var(--mt-surface); border: 1px solid var(--mt-line); }
  .mt-bar-left { display: grid; gap: 0.15rem; min-width: 14rem; flex: 1 1 14rem; }
  .mt-mode { font-family: var(--mt-mono); font-size: var(--fs-11); letter-spacing: 0.06em; text-transform: uppercase; color: var(--mt-accent); }
  .mt-status { font-size: var(--fs-13); color: var(--mt-ink); }
  .mt-counters { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; }
  .mt-counters div { display: grid; }
  .mt-counters dt { font-family: var(--mt-mono); font-size: var(--fs-10); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mt-muted); }
  .mt-counters dd { font-family: var(--mt-mono); font-size: var(--fs-15); color: var(--mt-ink); font-variant-numeric: tabular-nums; }
  .mt-bar-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  /* ── Run: stage ── */
  .mt-stage { display: grid; grid-template-columns: minmax(0, 1fr) 24rem; gap: 1.5rem; margin-top: 1.2rem; align-items: start; }
  .mt-board { position: relative; display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 0 5.5rem; padding: 1.2rem; background: var(--mt-surface); border: 1px solid var(--mt-line); }
  .mt-col { position: relative; z-index: 1; min-width: 0; }
  .mt-col-title { font-family: var(--mt-mono); font-size: var(--fs-11); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mt-muted); font-weight: 400; }
  .mt-wire { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 0; overflow: visible; }

  .mt-reqs { list-style: none; padding: 0; margin-top: 0.8rem; display: grid; gap: 0.35rem; }
  .mt-req { display: grid; grid-template-columns: 0.9rem minmax(0, 1fr); gap: 0.55rem; padding: 0.55rem 0.2rem 0.6rem; border-top: 1px solid var(--mt-line); opacity: 0.42; transition: opacity 0.5s; }
  .mt-req.is-asking, .mt-req.is-done { opacity: 1; }
  .mt-req.is-out { opacity: 0.5; }
  .mt-req-dot { width: 0.55rem; height: 0.55rem; margin-top: 0.4rem; border-radius: 50%; border: 1.5px solid var(--mt-line-strong); transition: background 0.4s, border-color 0.4s; }
  .mt-req.is-asking .mt-req-dot { border-color: var(--mt-accent); animation: mt-breathe 1.4s ease-in-out infinite; }
  .mt-req.is-done .mt-req-dot { background: var(--mt-accent); border-color: var(--mt-accent); animation: none; }
  .mt-req.is-done.is-gap .mt-req-dot { background: transparent; border-color: var(--mt-gap); }
  .mt-req.is-out .mt-req-dot { background: transparent; border-color: var(--mt-line-strong); }
  @keyframes mt-breathe { 50% { box-shadow: 0 0 0 4px var(--mt-accent-soft); } }
  .mt-req-text { font-size: var(--fs-14); line-height: 1.45; color: var(--mt-ink); }
  .mt-req-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.7rem; margin-top: 0.3rem; min-height: 1.2rem; font-size: var(--fs-12); }
  .mt-req:not(.is-done) .mt-req-meta, .mt-req:not(.is-done) .mt-req-ev { visibility: hidden; }
  .mt-chip { padding: 0 0.4rem; font-family: var(--mt-mono); font-size: var(--fs-10); letter-spacing: 0.06em; text-transform: uppercase; color: var(--mt-muted); border: 1px solid var(--mt-line-strong); }
  .mt-chip.is-must { color: var(--mt-ink); border-color: var(--mt-ink); }
  .mt-axis { font-family: var(--mt-mono); font-size: var(--fs-11); color: var(--mt-muted); }
  .mt-meter { display: inline-grid; grid-template-columns: repeat(3, 1.1rem); gap: 2px; }
  .mt-meter i { position: relative; height: 5px; background: var(--mt-line); overflow: hidden; }
  .mt-meter i::after { content: ""; position: absolute; inset: 0; background: var(--mt-accent); transform-origin: left; transform: scaleX(var(--fill, 0)); transition: transform 0.6s ease-out; }
  .mt-req.is-gap .mt-meter i::after { background: var(--mt-gap); }
  .mt-level { font-size: var(--fs-12); color: var(--mt-muted); }
  .mt-req-ev { margin-top: 0.2rem; font-size: var(--fs-12); color: var(--mt-muted); }
  .mt-req-ev a { text-decoration: none; border-bottom: 1px solid var(--mt-line-strong); }
  .mt-req-ev a:hover { color: var(--mt-accent); border-color: var(--mt-accent); }
  .mt-req-ev.is-none { color: var(--mt-gap); }

  .mt-evid { list-style: none; padding: 0; margin-top: 0.8rem; display: grid; gap: 0.5rem; }
  .mt-ev { display: grid; gap: 0.1rem; padding: 0.6rem 0.75rem; background: var(--mt-bg); border: 1px solid var(--mt-line); animation: mt-in 0.5s ease-out; transition: border-color 0.6s, box-shadow 0.6s; }
  .mt-ev.is-glow { animation: mt-glow 1.2s ease-out; }
  @keyframes mt-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes mt-glow { 0% { box-shadow: 0 0 0 0 var(--mt-accent-soft); border-color: var(--mt-accent); } 100% { box-shadow: 0 0 0 6px transparent; } }
  .mt-ev-kind { font-family: var(--mt-mono); font-size: var(--fs-10); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mt-accent); }
  .mt-ev-label { font-size: var(--fs-13); color: var(--mt-ink); text-decoration: none; }
  .mt-ev-label:hover { text-decoration: underline; }
  .mt-ev-count { font-family: var(--mt-mono); font-size: var(--fs-11); color: var(--mt-muted); }

  .mt-link { fill: none; stroke: var(--mt-accent); stroke-width: 1.2; stroke-opacity: 0.55; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.75s ease-out; }
  .mt-link.is-drawn { stroke-dashoffset: 0; }
  .mt-link.is-weak { stroke: var(--mt-gap); stroke-opacity: 0.45; }
  .mt-link.is-weak.is-drawn { stroke-dasharray: 0.012 0.012; }
  .mt-signal { fill: var(--mt-accent); }

  /* ── Side: score and net ── */
  .mt-side { position: sticky; top: 1rem; padding: 1.2rem; background: var(--mt-surface); border: 1px solid var(--mt-line); }
  .mt-score { position: relative; width: 9rem; height: 9rem; margin: 0 auto; }
  .mt-ring { width: 100%; height: 100%; transform: rotate(-90deg); }
  .mt-ring-bg { fill: none; stroke: var(--mt-line); stroke-width: 6; }
  .mt-ring-fg { fill: none; stroke: var(--mt-accent); stroke-width: 6; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 0.6s ease-out; }
  .mt-score-num { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; }
  .mt-total { font-size: 2.6rem; font-weight: 300; letter-spacing: -0.04em; line-height: 1; color: var(--mt-ink); font-variant-numeric: tabular-nums; }
  .mt-score-label { margin-top: 0.3rem; font-family: var(--mt-mono); font-size: var(--fs-10); letter-spacing: 0.08em; text-transform: uppercase; color: var(--mt-muted); }
  .mt-verdict { min-height: 1.6rem; margin-top: 0.6rem; text-align: center; font-size: var(--fs-16); font-weight: 500; color: var(--mt-ink); opacity: 0; transition: opacity 0.8s; }
  .mt-verdict.is-in { opacity: 1; }
  .mt-verdict[data-verdict="weak"] { color: var(--mt-gap); }
  .mt-subs { display: grid; gap: 0.3rem; margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--mt-line); }
  .mt-subs div { display: flex; justify-content: space-between; gap: 1rem; font-size: var(--fs-13); }
  .mt-subs dd { font-family: var(--mt-mono); color: var(--mt-ink); font-variant-numeric: tabular-nums; }
  .mt-radar { display: block; width: 100%; margin-top: 1rem; overflow: visible; }
  .mt-radar-ring { fill: none; stroke: var(--mt-line); }
  .mt-radar-spoke { stroke: var(--mt-line); }
  .mt-radar-label { font-size: 12px; fill: var(--mt-muted); }
  .mt-poly-demand { fill: var(--mt-demand-soft); stroke: var(--mt-demand); stroke-width: 1.4; stroke-dasharray: 4 3; }
  .mt-poly-cover { fill: var(--mt-accent-soft); stroke: var(--mt-accent); stroke-width: 1.6; }
  .mt-dot { fill: var(--mt-accent); }
  .mt-dot.is-profile { fill: var(--mt-surface); stroke: var(--mt-accent); stroke-width: 1.2; }
  .mt-legend { list-style: none; padding: 0; margin-top: 0.6rem; display: grid; gap: 0.25rem; font-size: var(--fs-12); color: var(--mt-muted); }
  .mt-legend li { display: flex; align-items: center; gap: 0.5rem; }
  .mt-sw { flex: none; width: 1.1rem; height: 0.55rem; }
  .mt-sw-demand { border: 1.4px dashed var(--mt-demand); background: var(--mt-demand-soft); }
  .mt-sw-cover { border: 1.4px solid var(--mt-accent); background: var(--mt-accent-soft); }
  .mt-sw-profile { width: 0.6rem; height: 0.6rem; border-radius: 50%; border: 1.2px solid var(--mt-accent); background: var(--mt-surface); margin: 0 0.25rem; }
  .mt-roleline { margin-top: 0.7rem; }

  /* ── After ── */
  .mt-after { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.8fr) minmax(0, 0.9fr); gap: 1.5rem; margin-top: 1.5rem; animation: mt-in 0.8s ease-out; }
  .mt-after > div { padding: 1.2rem; background: var(--mt-surface); border: 1px solid var(--mt-line); }
  .mt-gap-list { list-style: none; padding: 0; margin-top: 0.8rem; display: grid; gap: 0.5rem; }
  .mt-gap-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.6rem; padding-top: 0.5rem; border-top: 1px solid var(--mt-line); font-size: var(--fs-13); color: var(--mt-ink); }
  .mt-gap-list .mt-level { color: var(--mt-gap); }
  .mt-gap-none { color: var(--mt-accent) !important; }
  .mt input[type="range"] { width: 100%; margin-top: 0.5rem; accent-color: var(--mt-accent); }
  .mt select { margin-top: 0.4rem; padding: 0.35rem 0.5rem; color: var(--mt-ink); background: var(--mt-bg); border: 1px solid var(--mt-line-strong); }
  .mt-weights .mt-ghost { margin-top: 0.8rem; }
  .mt-cta p { margin-top: 0.5rem; font-size: var(--fs-14); line-height: 1.55; }
  .mt-cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin-top: 1rem !important; }
  .mt-pdf { display: inline-flex; align-items: center; gap: 0.45rem; }
  .mt-pdf svg { width: 0.95rem; height: 0.95rem; }

  /* ── Method ── */
  .mt-method { margin-top: 4.5rem; padding-top: 2.5rem; border-top: 1px solid var(--mt-line); }
  .mt-steps { list-style: none; padding: 0; margin-top: 1.8rem; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .mt-steps li { padding-top: 1rem; border-top: 2px solid var(--mt-ink); }
  .mt-step-no { font-family: var(--mt-mono); font-size: var(--fs-11); color: var(--mt-accent); }
  .mt-steps h3 { margin-top: 0.3rem; font-size: var(--fs-16); font-weight: 500; color: var(--mt-ink); }
  .mt-steps p { margin-top: 0.4rem; font-size: var(--fs-14); line-height: 1.6; }
  .mt-method-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 2rem; margin-top: 2.5rem; }
  .mt-plain { margin-top: 0.6rem; padding-left: 1.1rem; display: grid; gap: 0.4rem; font-size: var(--fs-14); line-height: 1.55; }
  .mt-gap-top { margin-top: 1.6rem; }
  .mt-code { margin-top: 0.7rem; padding: 1rem; max-height: 26rem; overflow: auto; font-family: var(--mt-mono); font-size: var(--fs-11); line-height: 1.55; color: var(--mt-ink); background: var(--mt-surface); border: 1px solid var(--mt-line); white-space: pre-wrap; word-break: break-word; }

  .mt-foot { padding: 1.5rem; border-top: 1px solid var(--mt-line); }
  .mt-foot nav { display: flex; gap: 1.2rem; justify-content: center; font-size: var(--fs-12); color: var(--mt-muted); }

  /* ── Narrow ── */
  @media (max-width: 1100px) {
    .mt-stage { grid-template-columns: minmax(0, 1fr); }
    .mt-side { position: static; order: -1; display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 0 1.5rem; }
    .mt-side .mt-score { grid-row: span 2; }
    .mt-radar, .mt-legend, .mt-roleline { grid-column: 1 / -1; }
    .mt-radar { max-width: 26rem; margin-left: auto; margin-right: auto; }
    .mt-after { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 760px) {
    .mt-top { flex-wrap: wrap; padding: 0.7rem 1rem; }
    .mt-role { display: none; }
    .mt-main { padding: 0 1rem 3rem; }
    .mt-hero { padding: 2rem 0 1.4rem; }
    .mt-input { padding: 1rem; }
    .mt-demos { grid-template-columns: minmax(0, 1fr); }
    .mt-board { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 1rem; }
    .mt-wire { display: none; }
    .mt-side { grid-template-columns: minmax(0, 1fr); }
    .mt-side .mt-score { grid-row: auto; }
    .mt-steps, .mt-method-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mt *, .mt *::after { animation: none !important; transition: none !important; }
  }

  /* ── The agent panel in this view: same paper, ink and blue ── */
  html.cv-match #agent-widget-root {
    --bg: #ffffff;
    --text: #14171c;
    --text-secondary: #5c6470;
    --accent: #1d4ed8;
    --accent-hover: #1e40af;
    --accent-cta: #1d4ed8;
    --aw-grad: #1d4ed8;
