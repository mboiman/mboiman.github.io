     mitten im Satz. Der Punkt ist gesetzt statt list-style, damit die Optik
     bleibt, wie sie war, und die Einrückung stimmt. */
  .project-copy :global(ul),
  .exp-copy :global(ul) {
    list-style: none;
    margin: 0 0 0.625rem;
