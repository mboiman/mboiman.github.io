---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DarkModeToggle from './DarkModeToggle.astro';
import { getCVData } from '../lib/toml-loader';
import { formatToHTML, formatBlocks, formatMarkdown } from '../lib/markdown';
import { i18n } from '../lib/i18n';
import { groupedSkills } from '../lib/skill-groups';
import { isTalk, sortByRecency } from '../lib/experience';

interface Props {
  lang: 'de' | 'en';
}

const { lang } = Astro.props;
const otherLang = lang === 'de' ? 'en' : 'de';
const t = i18n[lang];

const data = getCVData(lang);
const { profile, contact, ui, experiences, projects, summary, education, language: langs, agent_proof, license_sidebar } = data;

/**
 * Project screenshots, processed instead of served raw.
 *
 * They used to sit in public/ and render through a plain <img>, which Astro
 * copies through untouched: 5,8 MB of PNG and JPEG for seven cards, the largest
 * of them 3020 pixels wide inside a box 160 pixels high, no webp, no srcset.
 * The presentation next door has done it right the whole time (astro:assets with
 * widths + sizes); this is the same page in the same repo.
 *
 * Keyed by the file name the TOML already carries, so config.cv.toml stays the
 * place where a project declares its picture.
 */
const SHOTS = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>('../assets/projects/*.{png,jpg,jpeg,webp}', { eager: true }),
  ).map(([path, mod]) => [path.split('/').pop()!, mod.default]),
);
/**
 * A declared picture that has no file is a BUILD ERROR, not a missing image.
 *
 * This used to return undefined and the card simply rendered without its
 * picture. Nothing failed: not the build, not check-i18n (which only asks
 * whether a screenshot has an alt), not check-output (which only inspects the
 * <img> tags that DO exist). Caught by accident while renaming an asset: the
 * build stayed green and the image count fell from 44 to 42, which is the only
 * place the loss showed at all, and only to someone reading the number.
 *
 * StoryPage has thrown on this since the image audit, for the same reason and
 * with the sharper case in mind: a path can point at a file that was deleted
 * because it leaked personal data, and silence is the worst possible answer.
 * The two pages now behave the same way.
 */
const shotFor = (screenshot?: string) => {
  if (!screenshot) return undefined;
  const key = screenshot.split('/').pop()!;
  const shot = SHOTS[key];
  if (!shot) {
    throw new Error(
      `CVPage: config.cv.toml names the picture "${key}", and src/assets/projects/ has no such file. ` +
      `Known: ${Object.keys(SHOTS).sort().join(', ')}`,
    );
  }
  return shot;
};

/**
 * The portrait, processed instead of served raw.
 *
 * It sat in public/ behind a hardcoded <img src>, so Astro copied it through
 * untouched: 362 kB of 750x1000 JPEG for a box that is 88 or 96 CSS px wide.
 * On the first load it was the single heaviest resource on the page, larger
 * than all seventeen project pictures together at 768px. The presentation next
 * door has the opposite problem with the same file, blowing it up to 748x832
 * from a 750px source, so one card is four times too heavy while the other is
 * too small. One source, two derivations, both right.
 *
 * Keyed by file name like SHOTS above, so config.cv.toml stays the place where
 * a portrait is named.
 *
 * NOT resolved here on purpose: the TOML also carries `profile.avatar`
 * ("profile.png"), and this page has never rendered it, it renders the file
 * below. Making the key suddenly load-bearing would change the picture on the
 * page, which is a content decision, not a performance one.
 */
const PORTRAITS = Object.fromEntries(
  Object.entries(
    import.meta.glob<{ default: ImageMetadata }>('../assets/portraits/*.{png,jpg,jpeg,webp}', { eager: true }),
  ).map(([path, mod]) => [path.split('/').pop()!, mod.default]),
);
const avatar = PORTRAITS['profile_.jpg'];

const featuredProjects = projects.list.filter(p => p.featured);
const otherProjects = projects.list.filter(p => !p.featured);
/* `agent_proof` is a required field of CVData and both TOML branches define it,
   so the ternary fallback that used to stand here could never run. It had also
   drifted from the values it was mirroring, which is the usual fate of a copy
   nothing exercises. */
const agentProof = agent_proof;

// Grouping lives in src/lib/skill-groups.ts, shared with scripts/check-i18n.mjs:
// first matching pattern wins, every skill lands in exactly one group, empty
// groups never render. The page used to re-filter the full list per group here,
// which is how a skill matching two patterns rendered twice.
const sidebarSkillGroups = groupedSkills(ui.sidebar_skills, lang);

const contactIconPaths: Record<string, string> = {
  email: 'M21.75 6.75v10.5A2.25 2.25 0 0 1 19.5 19.5h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91A2.25 2.25 0 0 1 2.25 6.993V6.75',
  phone: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106a1.125 1.125 0 0 0-1.173.417l-.97 1.293a1.125 1.125 0 0 1-1.21.38 12.035 12.035 0 0 1-7.143-7.143 1.125 1.125 0 0 1 .38-1.21l1.293-.97c.36-.27.522-.735.417-1.173L6.963 3.102A1.125 1.125 0 0 0 5.872 2.25H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z',
  website: 'M12 21a9 9 0 1 0 0-18m0 18a9 9 0 1 1 0-18m0 18c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m-7.5 9h15',
  linkedin: 'M8.25 8.25h3v1.54h.04c.42-.8 1.45-1.64 2.98-1.64 3.19 0 3.78 2.1 3.78 4.83v5.57h-3.13v-4.94c0-1.18-.02-2.7-1.64-2.7-1.65 0-1.9 1.29-1.9 2.62v5.02H8.25V8.25Zm-4.05 0h3.13v10.3H4.2V8.25Zm3.38-3.18a1.81 1.81 0 1 1-3.62 0 1.81 1.81 0 0 1 3.62 0Z',
  github: 'M12 2.25c-5.39 0-9.75 4.36-9.75 9.75 0 4.3 2.79 7.95 6.66 9.24.49.09.67-.21.67-.47v-1.78c-2.71.59-3.28-1.16-3.28-1.16-.44-1.13-1.08-1.43-1.08-1.43-.88-.6.07-.59.07-.59.98.07 1.49 1 1.49 1 .87 1.49 2.27 1.06 2.83.81.09-.63.34-1.06.61-1.3-2.16-.25-4.43-1.08-4.43-4.82 0-1.06.38-1.93 1-2.61-.1-.25-.43-1.24.1-2.58 0 0 .82-.26 2.68 1a9.3 9.3 0 0 1 4.88 0c1.86-1.26 2.68-1 2.68-1 .53 1.34.2 2.33.1 2.58.62.68 1 1.55 1 2.61 0 3.75-2.28 4.57-4.45 4.81.35.3.66.9.66 1.82v2.7c0 .26.18.56.67.47A9.76 9.76 0 0 0 21.75 12c0-5.39-4.36-9.75-9.75-9.75Z',
};

function getContactIcon(item: { class?: string; icon?: string }) {
  if (item.class && contactIconPaths[item.class]) return contactIconPaths[item.class];
  if (item.icon?.includes('phone')) return contactIconPaths.phone;
  if (item.icon?.includes('linkedin')) return contactIconPaths.linkedin;
  if (item.icon?.includes('github')) return contactIconPaths.github;
  if (item.icon?.includes('globe')) return contactIconPaths.website;
  return contactIconPaths.email;
}

function getContactBadge(item: { class?: string }) {
  if (item.class === 'linkedin') return 'in';
  if (item.class === 'github') return 'gh';
  if (item.class === 'website') return 'www';
  return '';
}

// Talks/workshops are separated from regular stations by src/lib/experience.ts,
// the same module the PDF reads, so one rule decides it everywhere. The stations
// are sorted before rendering: the timeline ran neither up nor down and had five
// inverted pairs in it.
const jobs = sortByRecency(experiences.list.filter(e => !isTalk(e)));
const talks = sortByRecency(experiences.list.filter(isTalk));

/* ── Station details: what stays open, what folds ──────────────────────────
   The old split kept the intro and the TOOL list and threw the focus block
   away. On the running mandate that meant one sentence plus six lines of
   product names on the page, while ten focus bullets, the only place where the
   work itself is described, rendered nowhere. It also knew two states, focus
   and tools, so anything AFTER the tool list stayed in tool mode: the block
   "Wichtige Erfolge" folded into a disclosure labelled "Technischer Stack".

   The string is parsed into blocks at bold-ONLY heading lines, and each block
   is routed by its heading:

     lead (no heading)  visible, clipped at 80 words
     first focus block  heading + first three bullets visible, remainder folds
     further focus      folds whole
     tool block         folds whole
     anything else      visible. This is the third state, and it is what ends
                        tool mode instead of swallowing the rest of the entry

   The disclosure is labelled with the headings that are actually inside it,
   so it can never again announce a section it does not contain. */

type DetailBlock = { title: string | null; lines: string[] };

/** A line that is nothing but a bold heading, optional trailing colon/space. */
const HEADING_ONLY = /^\s*\*\*(.+?)\*\*\s*:?\s*$/;
/** Bullet markers used in config.cv.toml: dash, asterisk, middot, bullet. */
const BULLET_LINE = /^\s*(?:[-*]|[•·])\s+/;
/** How many bullets of the focus block the card shows before folding. */
const VISIBLE_HIGHLIGHTS = 3;

function toBlocks(text: string): DetailBlock[] {
  const blocks: DetailBlock[] = [{ title: null, lines: [] }];
  for (const raw of (text || '').split('\n')) {
    const heading = raw.match(HEADING_ONLY);
    if (heading) blocks.push({ title: heading[1].replace(/:\s*$/, '').trim(), lines: [] });
    else blocks[blocks.length - 1].lines.push(raw);
  }
  return blocks.filter(b => b.title !== null || b.lines.join('').trim() !== '');
}

function blockToMarkdown(block: DetailBlock): string {
  return [block.title ? `**${block.title}**` : '', ...block.lines].join('\n').trim();
}

/** Clip the lead to 80 words, backing up to the last sentence end. */
function clipLead(text: string): string {
  const words = text.split(/\s+/);
  if (words.length <= 80) return text;
  const clipped = words.slice(0, 80).join(' ');
  const lastStop = Math.max(clipped.lastIndexOf('. '), clipped.lastIndexOf('! '), clipped.lastIndexOf('? '));
  return lastStop > 40 ? clipped.slice(0, lastStop + 1) : `${clipped}…`;
}

/**
 * The public links buried in a talk's `details`.
 *
 * Talks rendered as three lines (title, host, date) and nothing else, so their
 * `details` reached no reader at all: 5,035 characters in the German branch.
 * Two of those characters-worth are the only third-party evidence on this whole
 * page, a public slide deck and the GitHub repo of the bot built in the
 * workshop, and "pitch.com" produced zero hits in the built HTML.
 */
function talkLinks(details: string): { label: string; url: string }[] {
  const out: { label: string; url: string }[] = [];
  const rx = /\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g;
  let m: RegExpExecArray | null;
  while ((m = rx.exec(details || ''))) out.push({ label: m[1], url: m[2] });
  return out;
}

function splitDetails(details: string): { open: string; foldTitle: string; fold: string } {
  const focusPattern = new RegExp(`^(${t.truncatePatterns.join('|')})`, 'i');
  const toolPattern = new RegExp(`^(${t.truncateToolPatterns.join('|')})`, 'i');

  const open: string[] = [];
  const folded: DetailBlock[] = [];
  let focusTaken = false;

  for (const block of toBlocks(details)) {
    if (block.title === null) {
      const lead = block.lines.join('\n').trim();
      if (lead) open.push(clipLead(lead));
      continue;
    }
    if (!focusTaken && focusPattern.test(block.title)) {
      focusTaken = true;
      let seen = 0;
      let cut = block.lines.length;
      for (let i = 0; i < block.lines.length; i += 1) {
        if (!BULLET_LINE.test(block.lines[i])) continue;
        seen += 1;
        if (seen === VISIBLE_HIGHLIGHTS) { cut = i + 1; break; }
      }
      open.push(blockToMarkdown({ title: block.title, lines: block.lines.slice(0, cut) }));
      const tail = block.lines.slice(cut);
      if (tail.join('').trim()) folded.push({ title: block.title, lines: tail });
      continue;
    }
    if (focusPattern.test(block.title) || toolPattern.test(block.title)) {
      folded.push(block);
      continue;
    }
    open.push(blockToMarkdown(block));
  }

  const foldTitle = [...new Set(folded.map(b => b.title).filter(Boolean))].join(' · ');
  return {
    open: open.join('\n\n').trim(),
    foldTitle,
    fold: folded.map(blockToMarkdown).join('\n\n').trim(),
  };
}

/* ── Project taglines ──────────────────────────────────────────────────────
   Measured at 1440px, the first two cards were 1129px high against 716px for
   their neighbours: one card carried a six-item nested list, and the grid
   stretched the card beside it to match, leaving 418px of empty surface. The
   lead block stays open and the rest folds, the same move the station cards
   already make for their tool list.

   The label is built from the bold labels the rest actually carries
   ("Kernfunktionen", "Das Problem · Die Lösung · Ergebnis"), so it names its
   own content and needs no new string in either language. Without any such
   label there is nothing honest to put on the summary, so nothing folds. */
function splitTagline(tagline: string): { lead: string; foldTitle: string; fold: string } {
  const text = (tagline || '').trim();
  const parts = text.split(/\n\s*\n/);
  if (parts.length < 2) return { lead: text, foldTitle: '', fold: '' };

  const rest = parts.slice(1).join('\n\n').trim();
  // Section labels first (a bold run opening a line), bullet labels only when
  // the block has no sections at all. Otherwise the summary of a card with a
  // "Kernfunktionen" heading was labelled with the first two BULLETS under it.
  const sections: string[] = [];
  const bulletLabels: string[] = [];
  for (const line of rest.split('\n')) {
    const section = line.match(/^\s*\*\*(.+?)\*\*/);
    const bullet = line.match(/^\s*[-*•·]\s+\*\*(.+?)\*\*/);
    const hit = section ? sections : bullet ? bulletLabels : null;
    const raw = section?.[1] ?? bullet?.[1];
    if (!hit || !raw) continue;
    const clean = raw.replace(/:\s*$/, '').trim();
    if (clean && !hit.includes(clean)) hit.push(clean);
  }
  const labels = sections.length ? sections : bulletLabels;
  if (!labels.length) return { lead: text, foldTitle: '', fold: '' };
  return { lead: parts[0].trim(), foldTitle: labels.slice(0, 3).join(' · '), fold: rest };
}

const INITIAL_PROJECTS = 6; // featured cards shown before the "show all" expander
---

<BaseLayout
  title={`${profile.name} · ${ui.tagline}`}
  description={ui.seo_description || ui.tagline}
  lang={lang}
>
  {/* Header */}
  <header class="cv-hero relative overflow-hidden">
    <div class="cv-shell relative pt-6 pb-14 lg:pb-16">
      {/* Top bar. A nav landmark with a name: the page had none at all, so a
          screen-reader rotor offered nothing to jump to, and the two language
          links carried no hreflang and no current-state. `no-print` because a
          language switch and a theme button on paper are ink for nothing. */}
      <nav class="no-print flex items-center justify-end mb-8 text-sm" aria-label={t.navLanguage}>
        <div class="flex items-center gap-3">
          <a href="/de/" hreflang="de" aria-current={lang === 'de' ? 'true' : undefined} class={lang === 'de' ? 'cv-lang-link is-active' : 'cv-lang-link'}>DE</a>
          <span class="opacity-20" aria-hidden="true">|</span>
          <a href="/en/" hreflang="en" aria-current={lang === 'en' ? 'true' : undefined} class={lang === 'en' ? 'cv-lang-link is-active' : 'cv-lang-link'}>EN</a>
          <span class="opacity-20" aria-hidden="true">|</span>
          <DarkModeToggle lang={lang} />
        </div>
      </nav>

      {/* Profile + live agent proof */}
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(340px,0.7fr)] gap-9 lg:gap-12 items-center">
        <div class="text-center sm:text-left">
          <div class="mt-7 flex flex-col sm:flex-row items-center sm:items-start gap-5">
            {/* The halo behind the portrait is gone: a blurred accent disc at
                45% under a picture that already carries a ring and a shadow is
                two decorations on one face. */}
            <div class="flex-shrink-0">
              <Image src={avatar} alt={profile.name} widths={[88, 96, 176, 192, 288]} sizes="(max-width: 640px) 5.5rem, 6rem" class="cv-avatar w-[5.5rem] h-[5.5rem] sm:w-24 sm:h-24 rounded-full object-cover grayscale-[10%]" loading="eager" />
            </div>
            <div class="min-w-0">
              {/* A fixed 4.75rem from 1024px up needed 537px for "Michael
                  Boiman" in a column that is 377px wide at 1280 and 460px at
                  1440, so the name broke across two lines. */}
              <h1 class="text-[clamp(2.25rem,4.4vw,4.75rem)] font-light tracking-[-0.02em] font-sans leading-[1.02] cv-hero-title">{profile.name}</h1>
              <p class="cv-tagline mt-3 max-w-2xl text-base sm:text-lg">{ui.tagline}</p>
              {/* Availability, capacity, location and contract form. A buyer
                  searches for exactly these and found none of them anywhere on
                  the page: the one availability sentence in config.cv.toml
                  renders into the PDF only. Directly under the tagline, because
                  by the time someone scrolls to the projects the decision is
                  usually made. Not a card, not a badge row: a plain line, so it
                  reads as fact rather than as a claim. */}
              <ul class="cv-facts mt-3 flex flex-col gap-0.5 text-[13px]">
                {t.facts.map(fact => <li>{fact}</li>)}
              </ul>
            </div>
          </div>

          {ui.hero_intro && (
            <p class="cv-proof-text mt-6 max-w-[42rem] text-[15px] leading-[1.75]">
              {ui.hero_intro}
            </p>
          )}

          {/* Contact */}
          {/* Centred, the six differently wide chips broke 1/1/2/1/1 on a 375px
              screen and took 203px of the first view, pushing both buttons
              below the fold. Left-aligned they pack. */}
          <div class="mt-5 flex flex-wrap items-center justify-start gap-2 text-sm">
            {contact.list.slice(0, 6).map(item => (
              <a href={item.url || '#'} target={item.url?.startsWith('mailto:') || item.url?.startsWith('tel:') ? '_self' : '_blank'} rel="noopener" class="cv-contact-link cursor-pointer" aria-label={item.title}>
                <span class="cv-contact-icon" aria-hidden="true">
                  {getContactBadge(item) ? (
                    <span class="cv-contact-badge">{getContactBadge(item)}</span>
                  ) : (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d={getContactIcon(item)} />
                    </svg>
                  )}
                </span>
                <span class="cv-contact-text">{item.title}</span>
              </a>
            ))}
          </div>

          {/* CTAs */}
          <div class="no-print mt-5 flex flex-wrap justify-center sm:justify-start gap-3">
            <button type="button" data-agent-prompt={agentProof.prompts[0]} class="cv-primary-cta px-5 py-2.5 rounded-lg text-sm font-semibold transition-colors cursor-pointer flex items-center gap-2">
              {agentProof.ask}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.77 9.77 0 01-4-.83L3 20l1.36-3.4A7.68 7.68 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
            </button>
            <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} download class="cv-secondary-cta px-5 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
              {t.pdfDownload}
            </a>
            <a href={`/${lang}/story/`} class="cv-secondary-cta px-5 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer flex items-center gap-2">
              {t.experienceTheStory}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
            </a>
          </div>
        </div>

        <div class="cv-agent-card no-print rounded-2xl p-5 lg:p-5">
          <div class="cv-kicker inline-flex items-center gap-2 rounded-full px-3 py-1.5 mb-4 text-[11px] font-medium uppercase tracking-[0.08em]">
            <span class="h-1.5 w-1.5 rounded-full" style="background: var(--accent)"></span>
            {agentProof.eyebrow}
          </div>
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em]" style="color: var(--accent)">{agentProof.card}</p>
              <h2 class="mt-2 text-xl sm:text-[1.55rem] font-sans font-light tracking-[-0.01em] leading-tight">{agentProof.headline}</h2>
            </div>
            {/* The badge said "Live" in the markup and nothing ever checked it.
                On a page whose argument is that a declared state is not a
                verified one, that was the worst possible place for a claim. It
                now starts on the honest "not checked yet" and is switched by
                the widget from the same agent-card fetch that fills the chips
                below (see renderAgentLive in AgentWidget.astro). */}
            <span
              class="cv-live-badge inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-medium"
              data-agent-live
              data-live-ok={t.agentReachable}
              data-live-down={t.agentUnavailable}
              role="status"
            >
              <span class="cv-live-dot h-1.5 w-1.5 rounded-full flex-shrink-0" aria-hidden="true"></span>
              <span data-agent-live-text>{t.agentCardStatic}</span>
            </span>
          </div>

          <p class="mt-3 text-[13px] leading-[1.7]" style="color: var(--text-secondary)">
            {agentProof.text}
          </p>

          <div class="mt-4 rounded-xl p-4 cv-agent-terminal">
            <p class="text-sm font-medium">{agentProof.status}</p>
            <p class="mt-1 text-xs leading-relaxed" style="color: var(--text-secondary)">{agentProof.endpoint}</p>
            {/* These chips describe the LIVE agent, so AgentWidget rewrites them from
                the agent-card as soon as it loads (see factsFromCard there). What
                renders here is the fallback for a visitor whose browser cannot reach
                the agent — and it is the only hand-written copy left, which is exactly
                why it went stale: it claimed protocolVersion 0.3 and skills 4 while the
                live card said otherwise. The card is the source of truth. */}
            <div class="mt-4 flex flex-wrap gap-2" data-agent-facts>
              {agentProof.facts.map(fact => (
                <span class="cv-agent-fact rounded-full px-2.5 py-1 text-[11px]">{fact}</span>
              ))}
            </div>
          </div>

          <div class="mt-4">
            <p class="mb-2 text-[11px] font-semibold uppercase tracking-[0.14em]" style="color: var(--text-secondary)">{agentProof.promptTitle}</p>
            <div class="space-y-2">
              {agentProof.prompts.map(prompt => (
                <button type="button" data-agent-prompt={prompt} class="cv-prompt-button w-full rounded-lg px-3 py-2 text-left text-sm leading-snug transition">
                  {prompt}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  {/* Main Layout */}
  <div class="cv-shell py-12">
    <div class="flex flex-col lg:flex-row gap-12">

      {/* Main Content (70%) */}
      <main id="main" class="lg:w-[70%] space-y-14">

        {/* Karriereprofil */}
        {summary.enable && (
          <section>
            <h2 class="cv-section-title">{summary.title}</h2>

            {/* Intro */}
            <p class="cv-measure text-[15px] leading-[1.85] mb-8" style="color: var(--text-secondary)">
              {t.careerIntro}
            </p>

            {/* Publicly verifiable anchors. This slot used to hold three vanity
                counters. A counter asks to be believed; an address can be opened.
                Only `state: public` entries render here, because a card the reader
                cannot check is just a claim in a box.
                NOTE: JSX comment, not an HTML one. An HTML comment survives the
                build, so the first version of this note shipped the very strings it
                was describing into dist/de/index.html. */}
            {/* Spaced 11px capitals at 75% opacity on the accent colour came to
                3.23:1. Same size, --text-secondary, no opacity: 5.90:1. */}
            <p class="text-[11px] tracking-[0.2em] uppercase mb-3" style="color: var(--text-secondary)">{t.cvRunningTitle}</p>
            {/* Every entry renders, not only `state: public`.
                The filter dropped exactly one card, and it was the only one
                showing a customer system: what was left were three cards about
                the same agent build, while the PDF led with the invoice route.
                Website and PDF claimed different core evidence.
                A card without a proofUrl is NOT an anchor. One entry is public
                and still has no page to open (an MCP endpoint answers to
                clients, not to browsers); it used to render <a href={undefined},
                i.e. a link that goes nowhere. The `stateNote` says why, and it
                is the only place that says it. */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
              {t.running.map(item => {
                const Tag = item.proofUrl ? 'a' : 'div';
                const linkAttrs = item.proofUrl
                  ? { href: item.proofUrl, target: '_blank', rel: 'noopener' }
                  : {};
                return (
                  <Tag
                    {...linkAttrs}
                    class:list={['cv-metric-card p-4 rounded-xl block', item.proofUrl && 'cv-metric-card-link transition-opacity hover:opacity-80']}
                  >
                    <p class="text-sm font-medium">{item.title}</p>
                    {item.mechanism && (
                      <p class="text-[13px] mt-1.5 leading-[1.6]" style="color: var(--text-secondary)">{item.mechanism}</p>
                    )}
                    <p class="text-xs mt-2 break-words" style="color: var(--accent); font-family: var(--font-mono, ui-monospace, Menlo, monospace)">{item.proof}</p>
                    {item.stateNote && (
                      <p class="text-[11px] mt-1.5" style="color: var(--text-secondary)">{item.stateNote}</p>
                    )}
                  </Tag>
                );
              })}
            </div>

            {/* Details */}
            <div class="cv-measure space-y-3 text-[14px] leading-[1.85]" style="color: var(--text-secondary)">
              {t.careerDetails.map(detail => (
                <p set:html={detail} />
              ))}
            </div>
          </section>
        )}

        {/* PROJEKTE VOR ERFAHRUNG */}
        {projects.enable && (
          <section id="section-projects" data-cv-anchor="projects" data-cv-group={projects.title}>
            <h2 class="cv-section-title">{projects.title}</h2>
            <p class="text-sm mb-6" style="color: var(--text-secondary)" set:html={formatMarkdown(projects.intro)} />

            {/* Eleven of seventeen cards used to ship with `hidden`, and
                `.hidden{display:none}` carries no media condition: without
                JavaScript none of them ever appeared, and the printed page was
                missing them too. The toggle is a checkbox now, a real control,
                keyboard-reachable, that works with no script at all; the print
                sheet unfolds every card and drops the control. The aria-label
                repeats the label text on purpose: the visible label is hidden
                once the box is ticked, and a focusable control must keep a name
                in both states. */}
            <input type="checkbox" id="cv-projects-all" class="sr-only" aria-label={t.showAllProjects.replace('{n}', String(featuredProjects.length - INITIAL_PROJECTS))} />

            <div class="cv-projects-grid grid grid-cols-1 md:grid-cols-2 gap-6">
              {featuredProjects.map((project, projectIndex) => {
                const copy = splitTagline(project.tagline);
                return (
                <div class={`cv-project-card rounded-xl overflow-hidden group${projectIndex >= INITIAL_PROJECTS ? ' cv-project-extra' : ''}`} id={project.anchor ? `project-${project.anchor}` : undefined} data-cv-anchor={project.anchor}>
                  {shotFor(project.screenshot) && (
                    <div class="cv-shot overflow-hidden relative">
                      {/* alt comes from config.cv.toml, never the empty string. These
                          pictures are the evidence for the card next to them, and two
                          of the seven are illustrations whose numbers are placeholders,
                          which a reader who cannot see them has every right to know.
                          scripts/check-i18n.mjs fails the build on a shot without one.

                          `sizes` was measured against the real box, not guessed
                          from the grid. The old value said 92vw / 46vw / 46rem
                          and was wrong at four breakpoints, worst at exactly
                          768px: `(max-width: 768px)` and Tailwind's `md:`
                          (min-width: 768px) BOTH match there, so the rule
                          promised one column at 707px while the grid had already
                          gone to two at 343px, a factor of 2.06. The card is also
                          not 46vw of anything: a sidebar appears at `lg` and the
                          column caps at 484px, so above 1280px the honest figure
                          is 30rem, not 46rem. Boxes measured at fifteen widths
                          from 360 to 3440. */}
                      <Image src={shotFor(project.screenshot)!} alt={project.screenshot_alt ?? ''} widths={[400, 800, 1200, 1600]} sizes="(max-width: 767px) calc(100vw - 44px), (max-width: 1023px) 46vw, (max-width: 1279px) 31vw, 30rem" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                      <div class="cv-shot-scrim"></div>
                      <p class="cv-shot-category absolute bottom-3 left-4 text-[10px] tracking-[0.2em] uppercase">{project.category}</p>
                    </div>
                  )}
                  {!shotFor(project.screenshot) && (
                    <div class="px-5 pt-4">
                      <p class="text-[10px] tracking-[0.2em] uppercase" style="color: var(--accent)">{project.category}</p>
                    </div>
                  )}
                  <div class="p-5">
                    <h3 class="text-base font-medium font-sans mb-2 leading-tight">
                      {project.url ? (
                        /* Only the title is the click target. The ::after below
                           still spreads the FOCUS RING across the card, so a
                           keyboard user sees what is selected, but it takes no
                           clicks: see the pointer-events note in the style block. */
                        <a href={project.url} target="_blank" rel="noopener" class="cv-project-link hover:text-[var(--accent)] transition-colors inline-flex items-center gap-1.5">
                          {project.title}
                          <svg class="w-3.5 h-3.5 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
                        </a>
                      ) : project.title}
                    </h3>

                    {project.tech_stack?.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 mb-3">
                        {project.tech_stack.slice(0, 6).map(tech => (
                          <span class="cv-tech-chip text-[12px] px-2 py-0.5 rounded-md font-medium">{tech}</span>
                        ))}
                        {project.tech_stack.length > 6 && (
                          <span class="text-[12px] px-2 py-0.5 rounded-md" style="color: var(--text-secondary)">+{project.tech_stack.length - 6}</span>
                        )}
                      </div>
                    )}

                    <div class="project-copy text-[13px] leading-[1.75] [&_strong]:font-medium [&_strong]:text-[var(--text)]" style="color: var(--text-secondary)" set:html={formatBlocks(copy.lead)} />
                    {copy.fold && (
                      <details class="cv-card-details mt-3">
                        <summary class="cursor-pointer text-[12px] font-medium select-none" style="color: var(--accent)">{copy.foldTitle}</summary>
                        <div class="project-copy mt-2 text-[13px] leading-[1.75] [&_strong]:font-medium [&_strong]:text-[var(--text)]" style="color: var(--text-secondary)" set:html={formatBlocks(copy.fold)} />
                      </details>
                    )}
                  </div>
                </div>
                );
              })}
            </div>

            {featuredProjects.length > INITIAL_PROJECTS && (
              <div class="cv-projects-toggle-wrap no-print mt-6 text-center">
                <label for="cv-projects-all" class="cv-secondary-cta inline-flex px-5 py-2.5 rounded-lg text-sm font-medium transition-colors cursor-pointer">
                  {t.showAllProjects.replace('{n}', String(featuredProjects.length - INITIAL_PROJECTS))}
                </label>
              </div>
            )}

            {otherProjects.length > 0 && (
              <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                {otherProjects.map(project => (
                  <div class="cv-mini-project p-4 rounded-lg">
                    <p class="text-[10px] tracking-[0.15em] uppercase mb-1" style="color: var(--accent)">{project.category}</p>
                    <h4 class="text-sm font-medium font-sans mb-1">{project.title}</h4>
                    {project.tech_stack?.length > 0 && (
                      <p class="text-[10px]" style="color: var(--text-secondary)">{project.tech_stack.slice(0, 4).join(' · ')}</p>
                    )}
                  </div>
                ))}
              </div>
            )}
          </section>
        )}

        {/* Berufserfahrung */}
        {experiences.enable && (
          <section id="section-experience" data-cv-anchor="experience" data-cv-group={experiences.title}>
            <h2 class="cv-section-title">{experiences.title}</h2>
            <div class="cv-timeline space-y-6 relative ml-3 pl-7">
              {jobs.map((exp, i) => (
                <div class="relative" id={exp.anchor ? `exp-${exp.anchor}` : undefined} data-cv-anchor={exp.anchor}>
                  {/* Timeline dot */}
                  <div class="absolute -left-[33px] top-2 w-3 h-3 rounded-full border-2 bg-[var(--bg)]" style="border-color: var(--accent)"></div>

                  <div class="cv-experience-card p-6 rounded-xl">
                    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-3">
                      <div>
                        <h3 class="text-[15px] font-medium font-sans leading-snug" style="color: var(--accent)">{exp.position}</h3>
                        <p class="text-sm mt-1 font-medium" style="color: var(--text-secondary)">{exp.company}</p>
                      </div>
                      <span class="cv-date-pill text-[11px] font-medium px-2.5 py-1 rounded-md whitespace-nowrap self-start">{exp.dates}</span>
                    </div>
                    {(() => {
                      const d = splitDetails(exp.details);
                      return (
                        <>
                          <div class="exp-copy text-[13px] leading-[1.9] [&_strong]:font-medium [&_strong]:text-[var(--text)]" style="color: var(--text-secondary)" set:html={formatToHTML(d.open)} />
                          {d.fold && (
                            <details class="cv-card-details mt-2">
                              <summary class="cursor-pointer text-[12px] font-medium select-none" style="color: var(--accent)">{d.foldTitle}</summary>
                              <div class="exp-copy mt-2 text-[13px] leading-[1.9] [&_strong]:font-medium [&_strong]:text-[var(--text)]" style="color: var(--text-secondary)" set:html={formatToHTML(d.fold)} />
                            </details>
                          )}
                        </>
                      );
                    })()}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {/* Vorträge & Workshops */}
        {talks.length > 0 && (
          <section id="section-talks" data-cv-anchor="talks" data-cv-group={t.talksTitle}>
            <h2 class="cv-section-title">{t.talksTitle}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {talks.map(talk => (
                  <div class="cv-mini-project p-4 rounded-lg" id={talk.anchor ? `exp-${talk.anchor}` : undefined} data-cv-anchor={talk.anchor}>
                  <h3 class="text-sm font-medium font-sans leading-snug" style="color: var(--accent)">{talk.position}</h3>
                  <p class="text-xs mt-1" style="color: var(--text-secondary)">{talk.company}</p>
                  <span class="cv-date-pill inline-block mt-2 text-[11px] font-medium px-2 py-0.5 rounded-md">{talk.dates}</span>
                  {splitDetails(talk.details ?? '').open && (
                    <div class="talk-copy mt-3 text-[13px] leading-[1.7]" set:html={formatToHTML(splitDetails(talk.details ?? '').open)} />
                  )}
                  {talkLinks(talk.details ?? '').length > 0 && (
                    <p class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-xs">
                      {talkLinks(talk.details ?? '').map(l => (
                        <a href={l.url} target="_blank" rel="noopener" class="cv-talk-link">{l.label}</a>
                      ))}
                    </p>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}
      </main>

      {/* Sidebar (30%). Named, because an unnamed <aside> is an unnamed landmark
          the reader cannot identify in a rotor. */}
      <aside class="lg:w-[30%]" aria-label={t.sidebarLabel}>
        <div class="lg:sticky lg:top-6 space-y-6">

          {/* Skills */}
          <div class="cv-sidebar-card">
            <h2 class="cv-sidebar-title">{ui.sidebar_skills_title}</h2>
            <div class="space-y-4">
              {sidebarSkillGroups.map(group => (
                <div>
                  <p class="cv-skill-group-title">{group.title}</p>
                  <div class="mt-2 flex flex-wrap gap-1.5">
                    {group.items.map(skill => (
                      <span class="cv-skill-chip text-xs px-2.5 py-1 rounded-full cursor-default">{skill}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Education */}
          {education.enable && (
            <div class="cv-sidebar-card">
              <h2 class="cv-sidebar-title">{education.title}</h2>
              <div class="space-y-3">
                {education.list.map(edu => (
                  <div>
                    <p class="text-sm font-medium">{edu.degree}</p>
                    {edu.college && <p class="text-xs mt-0.5" style="color: var(--text-secondary)">{edu.college}</p>}
                    <p class="text-xs" style="color: var(--text-secondary)">{edu.dates}</p>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Languages */}
          {langs.enable && (
            <div class="cv-sidebar-card">
              <h2 class="cv-sidebar-title">{langs.title}</h2>
              <div class="space-y-2.5">
                {langs.list.map(l => (
                  <div class="flex justify-between items-center text-sm">
                    <span>{l.language}</span>
                    <span class="cv-date-pill text-[11px] px-2.5 py-0.5 rounded-md font-medium">{l.level}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* The "Zusätzliche Qualifikationen" block used to stand here with
              three hardcoded English strings, on both language pages. Two of
              them (ISTQB, Dynatrace) are already in the education list directly
              above, and "Agile (Scrum/Kanban)" is verbatim one of the skill
              chips, so it appeared twice per page. Removed rather than
              translated: it carried no information the sidebar did not already
              carry. `ui.sidebar_qualifications_title` stays in the TOML as the
              heading if it ever comes back with its own content. */}

          {/* License */}
          {license_sidebar?.enable && (
            <div class="cv-sidebar-card">
              <h2 class="cv-sidebar-title">{license_sidebar.title}</h2>
              {/* This notice declares an attribution requirement, and it
                  rendered nowhere: "CC BY 4.0" produced zero hits in either
                  built page. A licence nobody can read binds nobody. */}
              <p class="text-[13px] leading-[1.6]" style="color: var(--text-secondary)" set:html={formatMarkdown(license_sidebar.notice)} />
            </div>
          )}

        </div>
      </aside>

    </div>
  </div>

  {/* Footer */}
  <footer class="py-10 px-6 text-center text-sm border-t" style="color: var(--text-secondary); border-color: var(--line)">
    <p>&copy; {new Date().getFullYear()} {profile.name} &middot; BKS-Lab &middot; Frankfurt am Main</p>
    {/* opacity-60 on text that is already --text-secondary put these five links
        at 2.55:1 in light and 3.89:1 in dark, at 12px. The colour alone is
        5.90:1, so the deck simply goes. Also a named nav landmark: these were
        five links in two bare paragraphs. */}
    <nav aria-label={t.navFooter}>
      <p class="mt-3 text-xs">
        <a href={`/${lang}/story/`} class="cv-footer-link">{t.experienceTheStory}</a>
        &nbsp;&middot;&nbsp;
        <a href={`/pdfs/Michael_Boiman_CV_${lang.toUpperCase()}.pdf`} class="cv-footer-link">PDF</a>
        &nbsp;&middot;&nbsp;
        <a href={`/${otherLang}/`} hreflang={otherLang} class="cv-footer-link">{t.cvFooterOtherLang}</a>
      </p>
      <p class="mt-2 text-xs">
        <a href={`/${lang}/datenschutz/`} class="cv-footer-link">{t.legalPrivacy}</a>
        &nbsp;&middot;&nbsp;
        <a href={`/${lang}/impressum/`} class="cv-footer-link">{t.legalImpressum}</a>
      </p>
    </nav>
  </footer>

  <script>
    document.querySelectorAll('[data-agent-prompt]').forEach((button) => {
      button.addEventListener('click', () => {
        const text = button.getAttribute('data-agent-prompt') || '';
        window.dispatchEvent(new CustomEvent('bridge-agent:prompt', { detail: { text } }));
      });
    });

    // The projects expander is a checkbox now (CSS does the revealing, with or
    // without this script). Deep links (#project-…/#exp-…) must never point at
    // a folded card, so they tick the box and open any disclosure around them.
    // The CSS carries `:target` as the no-script fallback for the first half.
    function revealTarget(hash: string) {
      const target = hash ? document.querySelector(hash) : null;
      if (!target) return;
      if (target.closest('.cv-project-extra')) {
        const all = document.getElementById('cv-projects-all') as HTMLInputElement | null;
        if (all) all.checked = true;
      }
      let fold = target.closest('details');
      while (fold) {
        fold.open = true;
        fold = fold.parentElement?.closest('details') ?? null;
      }
      target.scrollIntoView();
    }
    if (location.hash) revealTarget(location.hash);
    window.addEventListener('hashchange', () => revealTarget(location.hash));

    // A fold is a screen affordance, not a property of the document: print
    // shows everything and puts it back afterwards.
    window.addEventListener('beforeprint', () => {
      document.querySelectorAll('details:not([open])').forEach((d) => {
        (d as HTMLElement).dataset.printOpened = '1';
        (d as HTMLDetailsElement).open = true;
      });
    });
    window.addEventListener('afterprint', () => {
      document.querySelectorAll('details[data-print-opened]').forEach((d) => {
        (d as HTMLDetailsElement).open = false;
        delete (d as HTMLElement).dataset.printOpened;
      });
    });
  </script>
</BaseLayout>

<style>
  /* ── Seitenbreite ─────────────────────────────────────────────────────────
     Was hier vorher stand: `max-w-6xl mx-auto` plus eine feste Polsterung, also
     ein harter Deckel bei 72rem auf JEDEM Schirm. Gemessen war der Inhalt bei
     1440, bei 1728, bei 2000 und bei 2560 immer exakt 1152px breit; auf einem
     2000er Schirm mit offener Chat-Spalte blieben dadurch 216px auf jeder Seite
     leer, und die Projektkarten waren 345px schmal, in denen der Fliesstext nach
     sechs Woertern umbrach. Michael: "der hauptteil wird immer noch nicht
     breiter". Stimmte, und es lag nicht an der Chat-Spalte.

     Jetzt waechst die Seite mit dem Platz, den sie hat, bis 100rem. Der Rand ist
     ein Anteil statt einer festen Zahl, damit er im gleichen Verhaeltnis bleibt,
     ob die Chat-Spalte offen ist oder nicht. Der Deckel bleibt, weil eine Vita
     ueber 100rem keine Zeilenlaenge mehr hat, die man lesen will; die Prosa im
     Kopf ist ohnehin separat auf 42rem begrenzt und waechst nicht mit. */
  .cv-shell {
    width: 100%;
    max-width: 100rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 3.5%, 4rem);
  }

  /* Ein breites Layout ist nicht dasselbe wie eine breite Textzeile. Die
     Karten und das Raster duerfen den gewonnenen Platz nehmen, der laufende
     Fliesstext nicht: bei 1440 lief er sonst auf rund 110 Zeichen pro Zeile,
     weit ueber dem lesbaren Band von 45 bis 75. Die Prosa im Kopfbereich ist
     ohnehin schon auf 42rem begrenzt, das hier zieht die zwei Bloecke im
     Hauptteil nach. */
  .cv-measure { max-width: 54ch; }

  /* Same reason, and the block that had no cap at all: the running text in the
     experience section reached 138 characters per line at 1920px. `ch` instead
     of `rem` so the cap is tied to the font it is capping: 46rem measured 99
     characters, which is not what the comment above it asked for. */
  .exp-copy { max-width: 56ch; }

  .cv-hero :is(h1, h2, h3, h4),
  main :is(h2, h3, h4),
  aside :is(h2, h3, h4) {
    font-family: var(--font-display);
  }

  /* The header used to stack three effects on top of each other: two radial
     accent glows, a 44px grid over ::before under a mask, and a glowing hairline
     over ::after, on top of a border-bottom that was already there. The
     audience for this page buys test services; a landing-page texture reads
     cheap there, and quiet reads expensive. What is left is one very flat
     vertical gradient and the border. */
  .cv-hero {
    color: var(--text);
    background: linear-gradient(180deg, var(--surface) 0%, var(--bg) 100%);
    border-bottom: 1px solid var(--line);
  }

  .cv-hero-title {
    font-family: var(--font-display);
    font-weight: 300;
    letter-spacing: -0.035em;
    color: var(--text);
    text-shadow: none;
  }

  /* A thin neutral ring, no coloured glow: the tinted 3px border, the drop
     shadow and the accent ring outside it were three treatments on one face. */
  .cv-avatar {
    border: 1px solid var(--line);
  }

  .cv-talk-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .talk-copy {
    color: var(--text-secondary);
    max-width: 56ch;
  }

  .cv-facts {
    color: var(--text-secondary);
    list-style: none;
    padding: 0;
    max-width: 44ch;
  }

  .cv-tagline {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-weight: 400;
    line-height: 1.55;
  }

  .cv-proof-text {
    font-family: var(--font-body);
    color: var(--text-secondary);
    font-weight: 400;
  }

  /* A plain outlined chip. The gradient fill and the coloured glow under it
     were doing the work of a pill that only needs to hold four words, and
     0.16em of tracking made those four words a decoration. */
  .cv-kicker {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text-secondary);
  }

  /* One flat fill, and the hover is a colour, not a jump. It used to carry a
     135-degree gradient, a coloured glow, an inset white highlight, a
     brightness filter and a one-pixel lift, all on the same button. */
  .cv-primary-cta {
    background: var(--accent-cta);
    color: white;
  }

  .cv-primary-cta:hover {
    background: var(--accent-deep);
  }

  .cv-secondary-cta {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    color: var(--text);
  }

  .cv-secondary-cta:hover {
